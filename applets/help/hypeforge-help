#!/usr/bin/env python3
"""hypeForge applet 6 · Help & Keys (D-47, D-54, D-55).

A small Forge app (forgekit, like every Forge Suite app): the key chart and one guide page per
applet, each a section of the menu bar — a holder with tabs. Win + F1 and the launcher's
"Help & Keys" open it. The pages are plain files, so the hypeForge Settings Board shows the
same ones:

    applets/help/keys.toml      the one list of key combinations (checked against sway/config)
    applets/help/guide/*.md     the guide pages (the first line is the title)
    applets/help/guide/pages.toml  which tabs show which pages, in order

    hypeforge-help              open Help & Keys (in its own floating terminal window)
    hypeforge-help windows      open it on one page (keys, start, workspaces, windows, apps, about)

Keys: ← → or 1–7 or a click change page, ↑ ↓ / Page Up / Page Down scroll, Q or Esc close.
"""

import os
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
KEYS = HERE / "keys.toml"
GUIDE = HERE / "guide"
WINDOW_CLASS = "hypeforge-help"  # Window Rules float it, with a border (rules.toml)
VERSION = "0.1.0"


def key_groups():
    """[(group name, [(keys, what it does)])] from keys.toml, read every time."""
    with open(KEYS, "rb") as f:
        groups = tomllib.load(f).get("group", [])
    return [(g["name"], [(e["keys"], e["does"]) for e in g.get("keys", [])]) for g in groups]


def pages():
    """[(id, tab name, markdown)] — the key chart first, then the pages of guide/pages.toml."""
    with open(GUIDE / "pages.toml", "rb") as f:
        listed = tomllib.load(f).get("page", [])
    out = [("keys", "Keys", None)]  # the key chart: tables, drawn from keys.toml
    for page in listed:
        text = "\n\n".join((GUIDE / name).read_text() for name in page.get("files", []))
        out.append((f"page-{page['tab'].lower()}", page["tab"], text))
    return out


def inline(text):
    """**bold**, *italic*, `code` -> Rich markup (the rest escaped)."""
    import re
    from rich.markup import escape
    text = escape(text)
    text = re.sub(r"`([^`]+)`", r"[#f9e2af]\1[/]", text)
    text = re.sub(r"\*\*([^*]+)\*\*", r"[b]\1[/b]", text)
    text = re.sub(r"(?<![\w*])\*([^*]+)\*(?![\w*])", r"[i]\1[/i]", text)
    return text


def blocks(markdown):
    """A guide page as blocks: ("title"|"heading"|"text"|"item", markup) or ("table", rows)."""
    out, para, table = [], [], []

    def flush():
        if para:
            out.append(("text", inline(" ".join(para))))
            para.clear()
        if table:
            rows = [[c.strip() for c in r.strip().strip("|").split("|")] for r in table
                    if not set(r.replace("|", "").strip()) <= set("-: ")]
            out.append(("table", [[inline(c) for c in r] for r in rows]))
            table.clear()

    for line in markdown.splitlines():
        stripped = line.strip()
        if stripped.startswith("|"):
            if para:
                flush()
            table.append(stripped)
            continue
        if table:
            flush()
        if not stripped:
            flush()
        elif stripped.startswith("## "):
            flush(); out.append(("heading", inline(stripped[3:])))
        elif stripped.startswith("# "):
            flush(); out.append(("title", inline(stripped[2:])))
        elif stripped[:2] in ("- ", "* ") or (stripped[:1].isdigit() and ". " in stripped[:4]):
            flush()
            mark = "•" if stripped[:2] in ("- ", "* ") else stripped.split(". ", 1)[0] + "."
            out.append(("item", f"{mark} " + inline(stripped.split(" ", 1)[1])))
        elif out and out[-1][0] == "item" and not para and line.startswith("  "):
            out[-1] = ("item", out[-1][1] + " " + inline(stripped))  # an item's next line
        else:
            para.append(stripped)
    flush()
    return out


def run_app():
    from forgekit import ForgeApp
    from forgekit.app import FORGE_CSS
    from textual.app import ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical, VerticalScroll
    from textual.widgets import Static
    from rich.text import Text
    from rich.markup import escape

    PAGES = pages()

    class HelpApp(ForgeApp):
        APP_NAME = f"hypeForge Help & Keys {VERSION}"
        SHOW_HINT_BAR = True
        CSS = FORGE_CSS + """
        .hf-page { padding: 1 3; }
        /* the key chart: forgekit's tables, two alternating row colours, compact */
        /* every page, the same look (Javier, 10-05): title, headings, text, items, tables */
        .hf-title { margin: 0 0 1 0; color: $forge-accent; text-style: bold; }
        .hf-intro { margin: 0 0 1 0; color: $forge-text; }
        .hf-text { margin: 0 0 1 0; color: $forge-text; }
        .hf-item { margin: 0 0 0 2; color: $forge-text; }
        .hf-after-items { margin: 1 0 1 0; }
        .hf-group { margin: 1 0 0 0; color: $forge-accent; text-style: bold; }
        /* tables that WRAP (Javier, 10-05: no sideways scrolling on a small screen): rows of
           cells, the first column a fixed width, the last one takes the rest and wraps */
        .hf-page { overflow-x: hidden; }
        .hf-table { height: auto; margin: 0 0 1 0; }
        .hf-row { height: auto; }
        .hf-row Static { height: auto; padding: 0 1; }
        .hf-row .hf-last { width: 1fr; }
        .hf-head { background: $forge-surface; }
        .hf-head Static { color: $forge-accent; text-style: bold; }
        .hf-even { background: $forge-surface; }
        .hf-odd { background: $forge-bg; }
        """
        # no Help menu inside the help window (Javier, 10-05): the pages, then Quit
        MENU = [{"id": pid, "title": title, "kind": "section"} for pid, title, _ in PAGES] + [
            {"id": "quit", "title": "Quit", "kind": "action", "action": "quit"},
        ]
        SHORTCUTS = [
            ("← → or 1–6", "previous / next page, or straight to a page"),
            ("↑ ↓, Page Up / Page Down", "scroll the page"),
            ("A click on the menu bar", "open that page"),
            ("Q, Esc or Ctrl+Q", "close"),
        ]
        HINTS = [("← →", "pages"), ("↑ ↓", "scroll"), ("PgUp PgDn", "page"), ("Q", "close")]
        BINDINGS = [
            Binding("left", "step(-1)", show=False, priority=True),
            Binding("right", "step(1)", show=False, priority=True),
            Binding("up", "scroll(-1)", show=False, priority=True),
            Binding("down", "scroll(1)", show=False, priority=True),
            Binding("pageup", "page(-1)", show=False, priority=True),
            Binding("pagedown", "page(1)", show=False, priority=True),
            Binding("q,escape", "act('quit')", show=False),
            # forgekit opens its Help menu on F1 / Ctrl+H; this window has none
            Binding("f1,ctrl+h", "nothing", show=False, priority=True),
        ] + [Binding(str(n), f"go('{pid}')", show=False) for n, (pid, _, _) in enumerate(PAGES, 1) if n < 10]

        @staticmethod
        def table(rows, first_width=None):
            """A wrapping table: rows[0] is the header; cells are Rich markup."""
            plain = [[Text.from_markup(c).plain for c in r] for r in rows]
            cols = len(rows[0])
            widths = [min(max(len(r[i]) for r in plain if i < len(r)) + 2, 40) for i in range(cols - 1)]
            if first_width:
                widths[0] = first_width
            lines = []
            for n, r in enumerate(rows):
                cells = []
                for i in range(cols):
                    cell = Static(r[i] if i < len(r) else "", classes="hf-last" if i == cols - 1 else "")
                    if i < cols - 1:
                        cell.styles.width = widths[i]
                        cell.styles.max_width = "40%"  # on a narrow window it gives way, and wraps
                    cells.append(cell)
                kind = "hf-head" if n == 0 else ("hf-even" if n % 2 else "hf-odd")
                lines.append(Horizontal(*cells, classes=f"hf-row {kind}"))
            return Vertical(*lines, classes="hf-table")

        def __init__(self, **kw) -> None:
            self.ABOUT = {
                "name": "hypeForge Help & Keys", "version": VERSION,
                "tagline": "The key chart and the guide to every hypeForge applet",
                "description": "Part of hypeForge, the KognogOS desktop (Forge Suite).",
                "authors": "jetomev (Javier) · Claude (Anthropic), co-developer",
                "license": "GPL-3.0-or-later",
                "links": [("Code", "https://github.com/jetomev/hypeforge")],
            }
            super().__init__(**kw)

        def compose_sections(self) -> ComposeResult:
            for pid, _, text in PAGES:
                with VerticalScroll(id=f"sec-{pid}", classes="hf-page"):
                    if text is not None:
                        yield from self.page_widgets(pid, text)
                        continue
                    yield Static("Key chart", classes="hf-title")
                    yield Static("Every key combination of the hypeForge desktop. "
                                 "[b]Win[/b] is the Windows key.", classes="hf-intro")
                    groups = key_groups()
                    width = max(len(k) for _, rows in groups for k, _ in rows) + 2  # the groups line up
                    for group, rows in groups:
                        yield Static(group, classes="hf-group")
                        yield self.table([["Keys", "What it does"]] + [[f"[b]{escape(k)}[/b]", escape(d)] for k, d in rows],
                                         first_width=min(width, 40))

        def on_mount(self) -> None:
            super().on_mount()
            start = sys.argv[1] if len(sys.argv) > 1 else ""
            match = [pid for pid, _, _ in PAGES if pid in (start, f"page-{start}")]
            if match:
                self.call_after_refresh(self._switch_section, match[0])

        def action_nothing(self) -> None:
            pass

        def page_widgets(self, pid, text):
            """A guide page in the key chart's look."""
            last = None
            for n, (kind, body) in enumerate(blocks(text)):
                if kind == "table":
                    yield self.table(body)
                else:
                    classes = {"title": "hf-title", "heading": "hf-group", "text": "hf-text", "item": "hf-item"}[kind]
                    if kind == "text" and last == "item":
                        classes += " hf-after-items"
                    yield Static(body, classes=classes)
                last = kind


    HelpApp().run()


def main():
    if not sys.stdout.isatty():  # started from a key or the launcher: open our own window
        os.execvp("alacritty", ["alacritty", "--class", WINDOW_CLASS, "--title", "hypeForge Help & Keys",
                                "-e", sys.executable, os.path.abspath(__file__)] + sys.argv[1:])
    run_app()


if __name__ == "__main__":
    main()
