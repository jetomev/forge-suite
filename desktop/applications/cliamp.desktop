[Desktop Entry]
# hypeForge's copy of cliamp's entry (replaces /usr/share/applications/cliamp.desktop by name).
# The music player in place of Elisa (Javier, 2026-10-05, D-57: terminal first) — a Winamp
# 2.x style player. Alacritty names its window "cliamp", so it gets its own icon. It opens on
# the playlist "Music (tphome00)" (the media server's music, Javier 2026-10-05): started bare,
# cliamp shows its radio list, and from there no key reaches the local playlists until a track
# has played. The cliamp Forge app (D-59) will make this a setting.
Type=Application
Name=cliamp
GenericName=Music Player
Comment=cliamp, the retro terminal music player
TryExec=cliamp
Exec=alacritty --class cliamp -e cliamp --playlist "Music (tphome00)"
Icon=cliamp
Terminal=false
StartupWMClass=cliamp
Categories=Audio;Music;Player;AudioVideo;
