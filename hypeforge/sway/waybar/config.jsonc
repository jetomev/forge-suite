// hypeForge — the top bar in the Sway session (Waybar).
// The workspace buttons are drawn by applet 1 (Workspaces Management, D-47–D-49) from
// ~/.config/hypeforge/applets/workspaces.toml, into the file included below.
{
  "include": ["~/.config/hypeforge/applets/workspaces.waybar.json",
              "~/.config/hypeforge/applets/favourites.waybar.json"],
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  // Left: the launcher button, the workspace dropdown, then the Favorites dropdown (the two
  // groups come from the included files: applet 1 and applet 4, `hypeforge-sections bar`)
  "modules-left": ["custom/launcher", "group/workspaces", "group/favourites"],

  // The launcher button (Javier, 2026-10-05): the KognogOS emblem, or any picture put at
  // ~/.config/hypeforge/bar/launcher.png (drawn by style.css as the button's background:
  // Waybar 0.15's image module stops the bar from appearing here). Click: the launcher.
  "custom/launcher": {
    "format": " ",
    "tooltip-format": "Apps (Win + Space)",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections"
  },
  "modules-center": ["wlr/taskbar"],

  // The centre: every open app, one icon per window, on every screen (Javier, 2026-10-05).
  // WhatsApp (a Chrome web app) shows here while it is open.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "icon-theme": "candy-icons",
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "modules-right": ["group/indicators"],

  // The right side: background apps, the clipboard, the bell, then a line and the date and
  // time — one group with its own shade (Javier, 2026-10-05)
  "group/indicators": {
    "orientation": "inherit",
    "modules": ["tray", "custom/clipboard", "custom/notifications", "clock"]
  },
  // The tray (Javier, 2026-10-05): apps that keep running in the background — Steam, Discord,
  // Dropbox, Insync… Left click opens the app, right click its menu.
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  // The clipboard: applet 9 (applets/clipboard/), with the count of new copies. Left click: the
  // history (the count goes away); right click: empty it. Redrawn on SIGRTMIN+10 at every copy.
  "custom/clipboard": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard bar",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard list",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard clear"
  },
  // The bell: applet 7 (applets/notifications/). Left click lists recent notifications,
  // right click switches Do Not Disturb. Redrawn on SIGRTMIN+9 (mako's on-notify), and every 30 s.
  "custom/notifications": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications bar",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications list",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications dnd"
  },
  "clock": {
    "format": "{:%a %d %b   %I:%M %p}",
    "tooltip": false
  }
}
