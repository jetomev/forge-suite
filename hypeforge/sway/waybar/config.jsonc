// hypeForge — the top bar in the Sway session (Waybar).
// The workspace buttons are drawn by applet 1 (Workspaces Management, D-47–D-49) from
// ~/.config/hypeforge/applets/workspaces.toml, into the file included below.
{
  "include": ["~/.config/sway/waybar/modules.jsonc",
              "~/.config/hypeforge/applets/workspaces.waybar.json",
              "~/.config/hypeforge/applets/favourites.waybar.json"],
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  // Left: the launcher button, the workspace dropdown, then the Favorites dropdown (the two
  // groups come from the included files: applet 1 and applet 4, `hypeforge-sections bar`)
  "modules-left": ["custom/launcher", "group/workspaces", "group/favourites"],

  // The launcher button (Javier, 2026-10-05): the KognogOS emblem, or any picture put at
  // ~/.config/hypeforge/bar/launcher.png (drawn by style.css as the button's background:
  // Waybar 0.15's image module stops the bar from appearing here). Click: the launcher.
  "custom/launcher": {
    "format": " ",
    "tooltip-format": "Apps (Win + Space)",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections"
  },
  "modules-center": ["wlr/taskbar"],

  // The centre: every open app, one icon per window, on every screen (Javier, 2026-10-05).
  // WhatsApp (a Chrome web app) shows here while it is open.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "icon-theme": "candy-icons",
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "modules-right": ["group/indicators"],

  // The right side, left to right (Javier, 2026-10-05): background apps,
  // the clipboard, USB drives, printers, the status pill (Bluetooth · network · volume → Quick
  // Settings) | the date, time and bell (→ the calendar with the alerts) | the power menu — one
  // shade. The pill and the date piece are the pieces every style shares (D-96,
  // 2026-10-13), defined once in modules.jsonc; the night light is in Quick Settings (D-117, 2026-10-25).
  "group/indicators": {
    "orientation": "inherit",
    "modules": ["tray", "custom/disk", "custom/memory", "custom/temperature", "custom/gpu", "custom/cpu", "custom/clipboard", "custom/printers", "group/quick", "group/datetime", "custom/power"]
  },
  // USB drives (applet 11): the count of USB drives mounted; click = Open · Eject · Mount.
  // udiskie mounts them (never internal drives; NTFS read-only) and redraws this on every event.
  "custom/drives": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/drives/hypeforge-drives bar",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part disk {popup}",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/drives/hypeforge-drives menu"
  },
  // The printer (applet 12, Javier 2026-10-07): grey idle, lit while printing with the job count,
  // red when stopped. Click = the jobs (cancel one), right click = Print Settings.
  "custom/printers": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers bar",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers menu",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers settings"
  },
  // The power menu: Lock · Log Out · Reboot · Shut Down (applet 4, `hypeforge-sections power`)
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Lock · Log Out · Reboot · Shut Down",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections power"
  },
  // The tray (Javier, 2026-10-05): apps that keep running in the background — Steam, Discord,
  // Dropbox, Insync… Left click opens the app, right click its menu.
  // the tray's icons: 16 → 20 px on every style (Javier, 2026-10-10: "a few pixels bigger")
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  // The clipboard: applet 9 (applets/clipboard/), with the count of new copies. Left click: the
  // history (the count goes away); right click: empty it. Redrawn on SIGRTMIN+10 at every copy.
  "custom/clipboard": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard bar",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard list {popup}",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard clear {popup}"
  }
}
