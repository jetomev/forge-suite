// hypeForge — the bar's pieces every style shares (look program step 5). Each style's own
// config.jsonc says WHERE they go; this file says WHAT they are, so a fix here reaches every
// style. Written to ~/.config/sway/waybar/modules.jsonc by hypeforge-theme. Classic's own
// config.jsonc still defines its pieces itself (unchanged since it was approved).
{
  // ── the three pieces every style shares the same way (D-96, Javier 2026-10-13: "standardizing the
  // controls across themes, and when we improve on them, they work already for all the themes") ──
  // Bluetooth · network · sound in ONE pill (Windows 11's): a click on any of them opens Quick
  // Settings — the tiles, the sliders, hypeForge Settings and the big buttons into the Forge apps.
  // Right-click keeps each one's full app. `{popup}` = where the pop-up opens: hypeforge-bar fills
  // it in from the bar (its edge, its height, its margins), so the pieces need no numbers of their own.
  "group/quick": {
    "orientation": "inherit",
    "modules": [
      "bluetooth",
      "network",
      "wireplumber"
    ]
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-disconnected": "󰤭",
    "format-disabled": "󰤮",
    "tooltip-format-ethernet": "Wired: {ifname} · {ipaddr}\nQuick Settings · right click: the network tool",
    "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength} %) · {ipaddr}\nQuick Settings · right click: the network tool",
    "tooltip-format-disconnected": "Not connected\nQuick Settings · right click: the network tool",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick {popup}",
    "on-click-right": "hypeforge-nmtui"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth {status}\nQuick Settings · right click: the Bluetooth tool",
    "tooltip-format-connected": "Bluetooth: {device_enumerate}\nQuick Settings · right click: the Bluetooth tool",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick {popup}",
    "on-click-right": "alacritty --class hf-bluetooth -o window.dimensions.columns=110 -o window.dimensions.lines=30 -e bluetui"
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "{node_name}: {volume} %\nScroll: louder / quieter · click: Quick Settings · right click: the mixer",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick {popup}",
    "on-click-right": "alacritty --class hf-mixer -o window.dimensions.columns=110 -o window.dimensions.lines=30 -e wiremix"
  },
  // The date, time and bell in ONE piece (the Rice's): a click on any of them opens the calendar
  // with your alerts as cards; right-click on the bell switches Do Not Disturb. Each style may
  // give the clock its own format (two lines, time only…); the click stays this one.
  "group/datetime": {
    "orientation": "inherit",
    "modules": [
      "clock",
      "custom/notifications"
    ]
  },
  "clock": {
    "format": "{:%a %d %b   %I:%M %p}",
    "tooltip": false,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel calendar {popup-calendar}"
  },
  "custom/notifications": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/common/hfpiece sig9-notifications 2 ~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications bar",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel calendar {popup-calendar}",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications dnd"
  },
  // The night light's moon (the Rice's, nightForge's state): a click opens its small pop-up
  "custom/nightlight": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/common/hfpiece sig13-nightlight 2 ~/Programs/forge-suite/hypeforge/applets/nightlight/hypeforge-nightlight bar",
    "return-type": "json",
    "interval": 30,
    "signal": 13,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick --only night {popup}"
  },
  "custom/drives": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/common/hfpiece sig11-drives 2 ~/Programs/forge-suite/hypeforge/applets/drives/hypeforge-drives bar",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part disk {popup}",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/drives/hypeforge-drives menu"
  },
  "custom/printers": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/common/hfpiece printers 2 ~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers bar",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers menu",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers settings"
  },
  // the tray's icons: 16 → 20 px on every style (Javier, 2026-10-10: "a few pixels bigger")
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  // hypeForge's own tray (2026-10-17, Javier: Waybar's tray menus opened over the bar, in plain GTK):
  // a style still says "tray"; hypeforge-bar puts this group in its place. Ten pieces, one per tray app
  // (an empty one is hidden); hypeforge-tray keeps their pictures and redraws them on SIGRTMIN+15; a
  // click opens the app's menu as a hypeForge pop-up, a middle click its own window. The interval is a must:
  // Waybar 0.15's image piece with an exec and no interval hangs the whole bar before it draws (benched).
  "group/tray": {
    "orientation": "inherit",
    "modules": ["image#tray-1", "image#tray-2", "image#tray-3", "image#tray-4", "image#tray-5", "image#tray-6", "image#tray-7", "image#tray-8", "image#tray-9", "image#tray-10"] 
  },
  "image#tray-1": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-1.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 1 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 1" },
  "image#tray-2": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-2.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 2 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 2" },
  "image#tray-3": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-3.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 3 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 3" },
  "image#tray-4": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-4.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 4 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 4" },
  "image#tray-5": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-5.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 5 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 5" },
  "image#tray-6": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-6.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 6 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 6" },
  "image#tray-7": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-7.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 7 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 7" },
  "image#tray-8": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-8.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 8 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 8" },
  "image#tray-9": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-9.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 9 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 9" },
  "image#tray-10": { "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tray/slot-10.txt\" 2>/dev/null", "size": 20, "interval": 3600, "signal": 15, "on-click": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray menu 10 {popup}", "on-click-middle": "~/Programs/forge-suite/hypeforge/applets/tray/hypeforge-tray open 10" },
  "custom/tucked": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tucked.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/tuck/hypeforge-tuck back"
  },
  "custom/clipboard": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/common/hfpiece sig10-clipboard 2 ~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard bar",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard list {popup}",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard clear {popup}"
  },
  "custom/emblem": {
    "format": " ",
    "tooltip-format": "Apps (Win)",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections"
  },
  "custom/power-panel": {
    "format": "󰐥",
    "tooltip-format": "Lock · Log Out · Restart · Shut Down",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel power"
  },
  // The system pieces (2026-10-17, Javier: "icons and popups for CPU, GPU, Temperature, Memory, Disks
  // Space. Let's make them pretty too!!!"): each a number that turns warm, then red, when it matters; a
  // click opens its own pop-up (applets/panels/views/system.py). All five are hypeForge's (applets/system/):
  // the sampler writes each one's answer every 2 s and the bar reads it with `cat` (2026-10-17: Waybar's own
  // processor reader alone held each bar's start back ~90 ms); the card and the temperature hide on a
  // computer with nothing to read. The numbers keep a fixed width (2026-10-17, Javier: going from 9 % to
  // 1x % moved the icons to the left), padded with figure spaces (U+2007, a digit's width): 3 digits for
  // the processor and the card, which reach 100 %, 2 for memory, disk and temperature.
  "custom/cpu": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-system/bar-cpu.json\" 2>/dev/null || ~/Programs/forge-suite/hypeforge/applets/system/hypeforge-system bar cpu",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part cpu {popup}",
    "on-click-right": "alacritty --class hf-btop -e btop"
  },
  "custom/gpu": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-system/bar-gpu.json\" 2>/dev/null || ~/Programs/forge-suite/hypeforge/applets/system/hypeforge-system bar gpu",
    "return-type": "json",
    "interval": 3,
    "hide-empty-text": true,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part gpu {popup}"
  },
  "custom/temperature": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-system/bar-temp.json\" 2>/dev/null || ~/Programs/forge-suite/hypeforge/applets/system/hypeforge-system bar temp",
    "return-type": "json",
    "interval": 5,
    "hide-empty-text": true,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part temp {popup}"
  },
  "custom/memory": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-system/bar-memory.json\" 2>/dev/null || ~/Programs/forge-suite/hypeforge/applets/system/hypeforge-system bar memory",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part memory {popup}",
    "on-click-right": "alacritty --class hf-btop -e btop"
  },
  // the disk piece is hypeForge's (2026-10-17): it also lights up while a USB drive is mounted — it took the
  // USB icon's job on the Rice; signal 11 is the one udiskie's hook sends when a drive comes or goes
  "custom/disk": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-system/bar-disk.json\" 2>/dev/null || ~/Programs/forge-suite/hypeforge/applets/system/hypeforge-system bar disk",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel system --part disk {popup}"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-len": 40,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "player-icons": {
      "default": "󰐊",
      "spotify": "",
      "chromium": "󰊯",
      "firefox": "󰈹"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{player}: {title} — {artist}",
    "on-click": "playerctl play-pause"
  }
}
