// hypeForge — the bar's pieces every style shares (look program step 5). Each style's own
// config.jsonc says WHERE they go; this file says WHAT they are, so a fix here reaches every
// style. Written to ~/.config/sway/waybar/modules.jsonc by hypeforge-theme. Classic's own
// config.jsonc still defines its pieces itself (unchanged since it was approved).
{
  // ── the three pieces every style shares the same way (D-96, Javier 2026-10-13: "standardizing the
  // controls across themes, and when we improve on them, they work already for all the themes") ──
  // Bluetooth · network · sound in ONE pill (Windows 11's): a click on any of them opens Quick
  // Settings — the tiles, the sliders, hypeForge Settings and the big buttons into the Forge apps.
  // Right-click keeps each one's full app. `{popup}` = where the pop-up opens: hypeforge-bar fills
  // it in from the bar (its edge, its height, its margins), so the pieces need no numbers of their own.
  "group/quick": {
    "orientation": "inherit",
    "modules": [
      "bluetooth",
      "network",
      "wireplumber"
    ]
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-disconnected": "󰤭",
    "format-disabled": "󰤮",
    "tooltip-format-ethernet": "Wired: {ifname} · {ipaddr}\nQuick Settings · right click: the network tool",
    "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength} %) · {ipaddr}\nQuick Settings · right click: the network tool",
    "tooltip-format-disconnected": "Not connected\nQuick Settings · right click: the network tool",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick {popup}",
    "on-click-right": "hypeforge-nmtui"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth {status}\nQuick Settings · right click: the Bluetooth tool",
    "tooltip-format-connected": "Bluetooth: {device_enumerate}\nQuick Settings · right click: the Bluetooth tool",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick {popup}",
    "on-click-right": "alacritty --class hf-bluetooth -o window.dimensions.columns=110 -o window.dimensions.lines=30 -e bluetui"
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "{node_name}: {volume} %\nScroll: louder / quieter · click: Quick Settings · right click: the mixer",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick {popup}",
    "on-click-right": "alacritty --class hf-mixer -o window.dimensions.columns=110 -o window.dimensions.lines=30 -e wiremix"
  },
  // The date, time and bell in ONE piece (the Rice's): a click on any of them opens the calendar
  // with your alerts as cards; right-click on the bell switches Do Not Disturb. Each style may
  // give the clock its own format (two lines, time only…); the click stays this one.
  "group/datetime": {
    "orientation": "inherit",
    "modules": [
      "clock",
      "custom/notifications"
    ]
  },
  "clock": {
    "format": "{:%a %d %b   %I:%M %p}",
    "tooltip": false,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel calendar {popup-calendar}"
  },
  "custom/notifications": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications bar",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel calendar {popup-calendar}",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications dnd"
  },
  // The night light's moon (the Rice's, nightForge's state): a click opens its small pop-up
  "custom/nightlight": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/nightlight/hypeforge-nightlight bar",
    "return-type": "json",
    "interval": 30,
    "signal": 13,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick --only night {popup}"
  },
  "custom/drives": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/drives/hypeforge-drives bar",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/drives/hypeforge-drives menu"
  },
  "custom/printers": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers bar",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers menu",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/printers/hypeforge-printers settings"
  },
  // the tray's icons: 16 → 20 px on every style (Javier, 2026-10-10: "a few pixels bigger")
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "custom/tucked": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hypeforge-tucked.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/tuck/hypeforge-tuck back"
  },
  "custom/clipboard": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard bar",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard list",
    "on-click-right": "~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard clear"
  },
  "custom/emblem": {
    "format": " ",
    "tooltip-format": "Apps (Win + Space)",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections"
  },
  "custom/power-panel": {
    "format": "󰐥",
    "tooltip-format": "Lock · Log Out · Restart · Shut Down",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel power"
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 5,
    "tooltip-format": "Processor: {usage} % busy"
  },
  "memory": {
    "format": "󰘚 {percentage}%",
    "interval": 10,
    "tooltip-format": "Memory: {used:0.1f} of {total:0.1f} GB"
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-len": 40,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "player-icons": {
      "default": "󰐊",
      "spotify": "",
      "chromium": "󰊯",
      "firefox": "󰈹"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{player}: {title} — {artist}",
    "on-click": "playerctl play-pause"
  }
}
