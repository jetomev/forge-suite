# hypeForge — notifications in the Sway session: mako (D-57, Javier 2026-10-05).
# Copied to ~/.config/mako/config. Top right, under the bar, on the screen in use; 5 seconds;
# urgent ones stay until clicked. Catppuccin Mocha. Click: close it. Win + N closes them all,
# Win + Shift + N brings back the last one closed (sway/config). A notifications Forge app
# will set this file later (D-59).

# where: top right of the screen in use (output empty = the focused screen)
anchor=top-right
output=
layer=top
outer-margin=10
margin=6
width=420
height=200
max-visible=5
max-history=20
sort=-time

# how long
default-timeout=5000
ignore-timeout=0

# look — the bar's: its shade, a 1 px hover-grey border, straight corners, the bar's font size
# (Javier, 2026-10-05: "match the notification pop-ups to the bar too")
font=Noto Sans 10.5
background-color=#262637
text-color=#cdd6f4
border-color=#45475a
border-size=1
border-radius=0
padding=10
icons=1
max-icon-size=40
progress-color=over #313244

# the bell on the bar redraws when a notification arrives (applet 7)
on-notify=exec ~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications changed

# what a click does
on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=invoke-default-action

# a notification that offers something (a screenshot: "Draw on it"): a left click does it
[actionable]
on-button-left=invoke-default-action

[urgency=low]
border-color=#313244
text-color=#a6adc8

[urgency=critical]
border-color=#f38ba8
default-timeout=0

# Do Not Disturb (right click on the bell): pop-ups hidden, still kept in the list
[mode=do-not-disturb]
invisible=1
