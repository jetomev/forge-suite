# hypeForge — the barebones Sway session (D-44, D-45; 2026-10-04)
# Sway's own example config (/etc/sway/config, Sway 1.12), changed only where marked "hypeForge:".
# Start: the "Sway (hypeForge)" login choice runs `sway --unsupported-gpu` (NVIDIA).

# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
# hypeForge: the terminal you chose in defaultappsForge (xdg-terminal-exec and its list), else Alacritty
set $term sh -c 'if command -v xdg-terminal-exec >/dev/null && [ -s "$HOME/.config/xdg-terminals.list" ]; then exec xdg-terminal-exec; else exec alacritty; fi'
# Your preferred application launcher
# hypeForge: fuzzel (Javier 2026-10-04), a small graphical search box of apps.
# Win + Space, and Win + D as before. (The first try, sway-launcher-desktop, was a list inside a
# terminal: it felt like a terminal, and terminal apps did not open.) Settings: sway/fuzzel/.
set $menu exec fuzzel --config ~/.config/sway/fuzzel/fuzzel.ini

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
# hypeForge: the KognogOS wallpaper (Javier, 2026-10-04), shown by swaybg.
# The Semi logo in Catppuccin Mocha, the palette in use; the others: /usr/share/wallpapers/kognog/
# the wallpaper: set by hypeforge-theme in ~/.config/hypeforge/theme/sway.conf (below)
# hypeForge: the three Sceptre Y27 screens share one name and serial, so they are named by
# connector: DP-2 left, DP-3 middle, DP-1 right, each 2560x1440 at 144 Hz
output DP-2 mode 2560x1440@144Hz position 0 0
output DP-3 mode 2560x1440@144Hz position 2560 0
output DP-1 mode 2560x1440@144Hz position 5120 0
# hypeForge: what displayForge saves (resolution, refresh rate, position, size, rotation) —
# read after the lines above, so a save there wins. Skipped quietly until the first save.
include ~/.config/sway/outputs
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Windows: borders, colours, gaps, the pointer, the wallpaper
# All of it comes from the look: hypeforge-theme writes this file from the chosen style
# (shapes) and theme (colours) — D-78. Today's look is the "hypeForge Classic" style with the
# KognogOS Mocha theme: 2 px borders, no title bars (D-46), 10 px between windows, none at the
# edges. To change it: hypeforge-theme apply <style> <theme> (later: themeForge).
include ~/.config/hypeforge/theme/sway.conf

# The mouse stays where it is when the focus moves to another screen (Javier, 2026-10-04:
# clicking a workspace on the bar dragged the pointer to the middle of screen 1)
mouse_warping none
# Focus moves on a click (and keys, Alt + Tab later), not by moving the mouse over a window (Javier,
# 2026-10-10: "lose focus is only when I click"): so hovering never tucks a floating window
# away (D-82) and never pulls focus from what you're typing in.
focus_follows_mouse no

### Idle configuration
# hypeForge (Javier, 2026-10-05, D-57): lock after 30 minutes untouched, screens off after
# 60, back on at the first touch. No sleep or suspend: nothing here puts the computer to sleep.
# The lock screen's look: ~/.config/gtklock/ (style.css).
# hypeForge: notifications (Javier 2026-10-05): mako, styled in ~/.config/mako/config
exec mako

# hypeForge: clipboard history (applet 9, Javier 2026-10-05) — every copy is kept by cliphist
exec wl-paste --type text --watch ~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard store
exec wl-paste --type image --watch ~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard store

exec swayidle -w \
         timeout 1800 'gtklock -d' \
         timeout 3600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'

### Mouse pointer
# hypeForge: Catppuccin Mocha Dark, 24 px (Javier, 2026-10-05) — KDE's breeze_cursors before.
# Sets Sway's own pointer and the one older (X11) apps get; GTK apps read the same name from
# gsettings (cursor-theme). See docs/THEME.md.
# the pointer's theme: set by hypeforge-theme (~/.config/hypeforge/theme/sway.conf)

### Input configuration
# hypeForge: US-International with dead keys, as on this computer (' + a = á, ~ + n = ñ;
# type ' " ` ~ ^ followed by Space for the plain character)
input type:keyboard {
    xkb_layout us
    xkb_variant intl
}
#
# Example configuration:
#
#   input type:touchpad {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill
    # hypeForge: Alt + F4 closes the window too, the standard combination (Javier, 2026-10-04)
    bindsym Mod1+F4 kill
    # hypeForge: Win + F1 = help: the key chart and the guide, applet 6 (D-54)
    # hypeForge: notifications (mako) — close them all / bring back the last one closed
    bindsym $mod+n exec makoctl dismiss --all
    bindsym $mod+Shift+n exec makoctl restore
    # hypeForge: the bar's menus — Win + the underlined letter (Javier, 2026-10-05)
    bindsym $mod+w exec ~/Programs/forge-suite/hypeforge/applets/workspaces/hypeforge-workspaces menu
    bindsym $mod+f exec ~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections favorites
    # hypeForge: the clipboard history (applet 9)
    bindsym $mod+c exec ~/Programs/forge-suite/hypeforge/applets/clipboard/hypeforge-clipboard list
    # hypeForge: lock the screen (Javier, 2026-10-05)
    bindsym $mod+Escape exec gtklock -d
    bindsym $mod+F1 exec ~/Programs/forge-suite/hypeforge/applets/help/hypeforge-help

    # Start your launcher
    bindsym $mod+d $menu
    # hypeForge: Win + Space = the launcher with sections, applet 4 (D-52); Win + D = plain search
    # the style's own launcher: Start on Windows 11, the emblem menu on Mac OS 9, this list elsewhere (10-10)
    bindsym $mod+space exec ~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections key
    # the menu bar's menus as lists, by the letter underlined in their titles (Javier, 2026-10-10)
    bindsym $mod+i exec ~/Programs/forge-suite/hypeforge/applets/menubar/hypeforge-menubar open window
    bindsym $mod+p exec ~/Programs/forge-suite/hypeforge/applets/menubar/hypeforge-menubar open special
    bindsym $mod+h exec ~/Programs/forge-suite/hypeforge/applets/menubar/hypeforge-menubar open help

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+t layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+Shift+f fullscreen

    # Toggle the current focus between tiling and floating mode. "border pixel" keeps our frame:
    # floated, some apps (Alacritty…) ask to draw their own frame and draw none, which left the
    # window with no border and nothing to grab to resize (F-55, 2026-10-10)
    bindsym $mod+Shift+space floating toggle, border pixel

    # Swap focus between the tiling area and the floating area
    # hypeForge: Win + Space opens the launcher now; this moved to Win + Shift + Tab
    bindsym $mod+Shift+Tab focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

    # hypeForge: screenshots (applet 8, Javier 2026-10-05) — saved to ~/Pictures/Screenshots,
    # copied to the clipboard, a notification; click it to draw on the picture (swappy)
    bindsym Print exec ~/Programs/forge-suite/hypeforge/applets/screenshot/hypeforge-screenshot area
    bindsym Shift+Print exec ~/Programs/forge-suite/hypeforge/applets/screenshot/hypeforge-screenshot screen
    bindsym Ctrl+Print exec ~/Programs/forge-suite/hypeforge/applets/screenshot/hypeforge-screenshot all
    bindsym Alt+Print exec ~/Programs/forge-suite/hypeforge/applets/screenshot/hypeforge-screenshot window

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
# hypeForge: the top bar is Waybar : every workspace always shown and clickable,
# the active one coloured (Javier, 2026-10-04). Its settings: ~/.config/sway/waybar/.
# Started directly (no bar { } block, so Sway's own bar stays off).
exec waybar -c ~/.config/sway/waybar/config.jsonc -s ~/.config/sway/waybar/style.css

include /etc/sway/config.d/*

# hypeForge: applet 1 · Workspaces Management (D-47) — workspaces across all three screens.
# Switched on and off in ~/.config/hypeforge/applets/workspaces.toml (enabled = true/false).
# hypeForge: USB drives and discs mount by themselves (udiskie; internal drives never, NTFS
# read-only — ~/.config/udiskie/config.yml). The bar's drives icon is applet 11.
exec udiskie
# sudoForge: one password box for every admin request (polkit + sudo -A; Forge Suite, D-56/D-61).
# Its record: ~/.local/state/sudoforge/service.log (never a password).
exec sudoforge service
# The secret store (#39, #41, 2026-10-07): Electron apps (Claude Desktop, Chrome) keep their logins
# through the standard "Secret Service". At the login screen, PAM already starts KDE's store with a
# hash of the login password and leaves it waiting for the session's environment; Plasma sends that
# handshake, Sway did not — so the store was either absent (#39) or asked for its password in a KDE
# window (#41). This line sends the handshake (it is `env | socat … $PAM_KWALLET5_LOGIN`), and the
# wallet opens with the login password, no window. walletForge (D-61) takes this place one day.
exec /usr/lib/pam_kwallet_init

# Night light (Javier's order, step 4, 2026-10-07): wlsunset (32 KiB, D-57) warms the screens
# after sunset and cools them at sunrise.
# nightForge runs the night light now (D-3): its settings (place, warmth, schedule, on/off) and its
# tray icon (D-4). Installed command first, then the Forge Suite folder; plain wlsunset only if neither.
exec sh -c 'if command -v nightforge >/dev/null; then exec nightforge start; elif [ -x "$HOME/Programs/forge-suite/nightforge/main.py" ]; then exec "$HOME/Programs/forge-suite/nightforge/main.py" start; elif command -v wlsunset >/dev/null; then exec wlsunset -l 25.77 -L -80.19; fi'
# hypeForge: start-at-login apps from ~/.config/autostart (applet 10; Sway does not read that folder)
exec ~/Programs/forge-suite/hypeforge/applets/autostart/hypeforge-autostart
# hypeForge: the Favorites menu on the bar (applet 4 writes it)
exec ~/Programs/forge-suite/hypeforge/applets/sections/hypeforge-sections bar
exec ~/Programs/forge-suite/hypeforge/applets/workspaces/hypeforge-workspaces

# hypeForge: applet 2 · Window Placement (D-50) — new windows fill a fixed order of spots.
# Switched on and off in ~/.config/hypeforge/applets/placement.toml (enabled = true/false).
exec ~/Programs/forge-suite/hypeforge/applets/placement/hypeforge-placement
# A click on a window tucks away the floating windows covering it, like minimised (Javier, 2026-10-10;
# Sway always draws floating windows above tiled ones). Its taskbar icon or Win + − brings it back.
exec ~/Programs/forge-suite/hypeforge/applets/tuck/hypeforge-tuck

# hypeForge: applet 5 · Window Rules (D-53) — which windows float instead of taking a spot.
# Switched on and off in ~/.config/hypeforge/applets/rules.toml (enabled = true/false).
exec ~/Programs/forge-suite/hypeforge/applets/rules/hypeforge-rules
