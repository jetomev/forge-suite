diff --git a/sway/ipc-json.c b/sway/ipc-json.c
index 3b69ad3..7ea1fe1 100644
--- a/sway/ipc-json.c
+++ b/sway/ipc-json.c
@@ -5,6 +5,7 @@
 #include <stdio.h>
 #include <wlr/config.h>
 #include <wlr/types/wlr_content_type_v1.h>
+#include <wlr/types/wlr_cursor.h>
 #include <wlr/types/wlr_output.h>
 #include <wlr/types/wlr_ext_foreign_toplevel_list_v1.h>
 #include <xkbcommon/xkbcommon.h>
@@ -1235,6 +1236,17 @@ json_object *ipc_json_describe_seat(struct sway_seat *seat) {
 	}
 	json_object_object_add(object, "devices", devices);
 
+	// hypeForge (D-116, patch 3): where the pointer is, in layout coordinates, so a pop-up can open
+	// right under what was clicked. A new surface is told the pointer's place only once it moves.
+	if (seat->cursor && seat->cursor->cursor) {
+		json_object *cursor = json_object_new_object();
+		json_object_object_add(cursor, "x",
+			json_object_new_int((int)seat->cursor->cursor->x));
+		json_object_object_add(cursor, "y",
+			json_object_new_int((int)seat->cursor->cursor->y));
+		json_object_object_add(object, "cursor", cursor);
+	}
+
 	return object;
 }
 
