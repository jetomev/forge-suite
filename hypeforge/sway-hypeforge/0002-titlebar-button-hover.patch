+// hypeForge (patch 2): the one title bar button the pointer is on, anywhere on the desktop
+static struct sway_container *title_hover_con = NULL;
+static int title_hover_which = -1;
+
+static void apply_title_button_colors(struct sway_container *con, struct border_colors *colors) {
+	for (int i = 0; i < TITLEBAR_BUTTON_COUNT; ++i) {
+		struct sway_text_node *node = con->title_bar.buttons[i];
+		if (!node) {
+			continue;
+		}
+		bool lit = config->titlebar_button_hover_set &&
+			title_hover_con == con && title_hover_which == i;
+		bool close = i == TITLEBAR_BUTTON_CLOSE;
+		float *bg = close ? config->titlebar_button_close_bg : config->titlebar_button_hover_bg;
+		float *fg = close ? config->titlebar_button_close_text : config->titlebar_button_hover_text;
+		if (con->title_bar.button_bg[i]) {
+			wlr_scene_node_set_enabled(&con->title_bar.button_bg[i]->node, lit);
+			if (lit) {
+				scene_rect_set_color(con->title_bar.button_bg[i], bg, con->alpha);
+			}
+		}
+		sway_text_node_set_color(node, lit ? fg : colors->text);
+		sway_text_node_set_background(node, lit ? bg : colors->background);
+	}
+}
+
+void container_title_button_hover(struct sway_container *con, int which) {
+	if (!con || which < 0) {
+		con = NULL;
+		which = -1;
+	}
+	if (title_hover_con == con && title_hover_which == which) {
+		return;
+	}
+	struct sway_container *before = title_hover_con;
+	title_hover_con = con;
+	title_hover_which = which;
+	if (before && before != con) {
+		apply_title_button_colors(before, container_get_current_colors(before));
+	}
+	if (con) {
+		apply_title_button_colors(con, container_get_current_colors(con));
+	}
+}
