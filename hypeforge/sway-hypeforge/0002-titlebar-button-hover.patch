+struct cmd_results *cmd_titlebar_button_hover(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "titlebar_button_hover", EXPECTED_EQUAL_TO, 4))) {
+		return error;
+	}
+	float *dest[4] = {
+		config->titlebar_button_hover_bg, config->titlebar_button_hover_text,
+		config->titlebar_button_close_bg, config->titlebar_button_close_text,
+	};
+	for (int i = 0; i < 4; ++i) {
+		uint32_t color;
+		if (!parse_color(argv[i], &color)) {
+			return cmd_results_new(CMD_INVALID,
+					"Invalid colour '%s' (titlebar_button_hover <bg> <text> <close bg> <close text>)", argv[i]);
+		}
+		color_to_rgba(dest[i], color);
+	}
+	config->titlebar_button_hover_set = true;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
