+// hypeForge (D-111): does this window's title bar show the buttons?
+static bool container_wants_title_buttons(struct sway_container *con) {
+	if (!con->view || config->titlebar_buttons == TITLEBAR_BUTTONS_NONE) {
+		return false;
+	}
+	return config->titlebar_buttons == TITLEBAR_BUTTONS_ALL ||
+		container_is_current_floating(con);
+}
+
+static void destroy_title_buttons(struct sway_container *con) {
+	for (int i = 0; i < TITLEBAR_BUTTON_COUNT; ++i) {
+		if (con->title_bar.buttons[i]) {
+			wlr_scene_node_destroy(con->title_bar.buttons[i]->node);
+			con->title_bar.buttons[i] = NULL;
+		}
+	}
+}
+
+// Each button is a square slot as tall as the title bar, at its right end:
+// minimise, maximise, close, left to right.
+static int title_button_slot(void) {
+	return container_titlebar_height();
+}
+
+int container_title_button_at(struct sway_container *con, double lx, double ly) {
+	if (!con->title_bar.buttons[TITLEBAR_BUTTON_CLOSE] ||
+			!con->title_bar.tree->node.enabled) {
+		return -1;
+	}
+	int x, y;
+	wlr_scene_node_coords(&con->title_bar.tree->node, &x, &y);
+	int slot = title_button_slot();
+	int height = container_titlebar_height();
+	if (ly < y || ly >= y + height) {
+		return -1;
+	}
+	double from_right = x + con->title_width - lx;
+	if (from_right < 0 || from_right >= slot * TITLEBAR_BUTTON_COUNT) {
+		return -1;
+	}
+	return TITLEBAR_BUTTON_COUNT - 1 - (int)(from_right / slot);
+}
