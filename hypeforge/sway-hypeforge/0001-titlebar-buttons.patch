diff --git a/sway/commands/titlebar_buttons.c b/sway/commands/titlebar_buttons.c
new file mode 100644
index 0000000..4b8ad7e
--- /dev/null
+++ b/sway/commands/titlebar_buttons.c
@@ -0,0 +1,60 @@
+// hypeForge (D-111, 2026-10-17): minimise / maximise / close buttons at the title bar's right.
+//
+//   titlebar_buttons none|floating|all
+//       which windows show them (default none: Sway as it always was)
+//   titlebar_button minimize|maximize|close <glyph> <command…>
+//       a button's symbol and the Sway command its left click runs, on the window clicked
+
+#include <string.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+#include "stringop.h"
+
+static void arrange_title_bar_iterator(struct sway_container *con, void *data) {
+	container_update_title_bar(con);
+}
+
+struct cmd_results *cmd_titlebar_buttons(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "titlebar_buttons", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	if (strcmp(argv[0], "none") == 0) {
+		config->titlebar_buttons = TITLEBAR_BUTTONS_NONE;
+	} else if (strcmp(argv[0], "floating") == 0) {
+		config->titlebar_buttons = TITLEBAR_BUTTONS_FLOATING;
+	} else if (strcmp(argv[0], "all") == 0) {
+		config->titlebar_buttons = TITLEBAR_BUTTONS_ALL;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+				"Expected 'titlebar_buttons none|floating|all'");
+	}
+	root_for_each_container(arrange_title_bar_iterator, NULL);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_titlebar_button(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "titlebar_button", EXPECTED_AT_LEAST, 3))) {
+		return error;
+	}
+	int which;
+	if (strcmp(argv[0], "minimize") == 0) {
+		which = TITLEBAR_BUTTON_MINIMIZE;
+	} else if (strcmp(argv[0], "maximize") == 0) {
+		which = TITLEBAR_BUTTON_MAXIMIZE;
+	} else if (strcmp(argv[0], "close") == 0) {
+		which = TITLEBAR_BUTTON_CLOSE;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+				"Expected 'titlebar_button minimize|maximize|close <glyph> <command>'");
+	}
+	free(config->titlebar_button_glyph[which]);
+	config->titlebar_button_glyph[which] = strdup(argv[1]);
+	free(config->titlebar_button_command[which]);
+	config->titlebar_button_command[which] = join_args(argv + 2, argc - 2);
+	root_for_each_container(arrange_title_bar_iterator, NULL);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
