#!/usr/bin/env python3
"""hypeForge applet · the pop-up panels (look program step 4).

    hypeforge-panel <view> [--style S] [--theme T]

Opens one of the graphical pop-ups the styles place on their bar; the same command again closes
it (a bar button pressed twice). Views: power (the big-button power menu), start (the KDE-style
Start), kickoff (KDE's list), library (COSMIC's App Library), quick (Quick Settings, or one part of
it with --only), calendar, workspaces (the strip), switcher (Alt + Tab: --hold while Alt is held,
--back starts from the end, --tucked only the windows tucked away; Alt + Tab again moves it on),
clipboard, traymenu (a tray app's menu, --slot N), system (--part cpu, gpu, temp, memory or disk).
--style / --theme draw it in a look other than the active one (the preview bench uses this).
"""

from __future__ import annotations

import argparse
import importlib
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "views"))

# view name → its module (a module may not take a standard library's name: "calendar" is one)
VIEWS = {"power": "power", "start": "start", "quick": "quick", "calendar": "calendar_view", "workspaces": "workspaces",
         "kickoff": "kickoff", "library": "library", "switcher": "switcher", "clipboard": "clipboard", "traymenu": "traymenu",
         "system": "system"}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("view", choices=list(VIEWS))
    ap.add_argument("--style")
    ap.add_argument("--theme")
    ap.add_argument("--edges", help="where it sits: bottom, top, left, right, comma separated (the style's bar decides)")
    ap.add_argument("--margin", help="pixels from those edges, e.g. bottom=60,left=10")
    ap.add_argument("--only", choices=["network", "sound", "bluetooth", "night"],
                    help="quick: just that part, its own small pop-up (COSMIC, C-5)")
    ap.add_argument("--hold", action="store_true", help="switcher: Alt is held; letting go picks")
    ap.add_argument("--back", action="store_true", help="switcher: go backwards (Alt + Shift + Tab)")
    ap.add_argument("--tucked", action="store_true", help="switcher: only the windows tucked away")
    ap.add_argument("--ask-clear", action="store_true", help="clipboard: open asking whether to empty it (right click)")
    ap.add_argument("--slot", help="traymenu: which tray icon (1 = the first)")
    ap.add_argument("--part", choices=["cpu", "gpu", "temp", "memory", "disk"], help="system: which one (the bar piece clicked)")
    a = ap.parse_args()
    import panelkit
    if a.view == "switcher" and a.hold and panelkit.nudge_open("switcher", back=a.back):
        return 0                                   # Alt + Tab again: the open one moves on
    if a.view == "system":                     # one system pop-up at a time: its own piece again closes it,
        part = f"system-{a.part or 'cpu'}"     # another piece swaps it
        if panelkit.close_open(part):
            return 0
        for other in ("cpu", "gpu", "temp", "memory", "disk"):
            panelkit.close_open(f"system-{other}")
    elif panelkit.close_open(a.view):
        return 0
    a.pending = []
    if a.view == "switcher":
        import signal
        # a fast second Tab may come while it starts: count it (its default would end the program)
        signal.signal(signal.SIGUSR1, lambda *_: a.pending.append(1))
        signal.signal(signal.SIGUSR2, lambda *_: a.pending.append(-1))
        panelkit.pidfile(a.view).write_text(str(os.getpid()))   # at once: a fast second Tab finds it
    view = importlib.import_module(VIEWS[a.view])
    panel = view.build(panelkit.Look(a.style, a.theme), a)
    panel.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
