#!/usr/bin/env python3
"""hypeForge applet · the pop-up panels (look program step 4).

    hypeforge-panel <view> [--style S] [--theme T]

Opens one of the graphical pop-ups the styles place on their bar; the same command again closes
it (a bar button pressed twice). Views: power (the big-button power menu). More come one by one:
the KDE-style Start, Quick Settings, the calendar, the workspaces strip.
--style / --theme draw it in a look other than the active one (the preview bench uses this).
"""

from __future__ import annotations

import argparse
import importlib
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "views"))

VIEWS = ["power"]


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("view", choices=VIEWS)
    ap.add_argument("--style")
    ap.add_argument("--theme")
    a = ap.parse_args()
    import panelkit
    if panelkit.close_open(a.view):
        return 0
    view = importlib.import_module(a.view)
    panel = view.build(panelkit.Look(a.style, a.theme), a)
    panel.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
