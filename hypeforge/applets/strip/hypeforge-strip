#!/usr/bin/env python3
"""hypeForge applet · Mac OS 9's Control Strip (D-72): the panel that stays in the bottom-left corner.

A style starts it ([layout] applets = ["strip"]) at login and at every Sway reload. The panel itself
treats a second start as "close" (a bar button pressed twice), so this checks first: when the strip
is already up, a reload leaves it alone.
"""
import os
import sys
from pathlib import Path

PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypeforge-panel-strip.pid"
PANEL = Path(__file__).resolve().parent.parent / "panels/hypeforge-panel"

try:
    os.kill(int(PIDFILE.read_text()), 0)
    sys.exit(0)                               # already up
except (OSError, ValueError):
    pass
# --keep: never close an open strip, even when two starts land together (a race seen on the bench)
os.execv(sys.executable, [sys.executable, str(PANEL), "strip", "--keep"])
