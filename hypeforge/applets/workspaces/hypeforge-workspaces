#!/usr/bin/env python3
"""hypeForge applet 1 · Workspaces Management (D-47, D-48, D-49).

Workspaces that span every screen. Sway gives each screen its own workspaces, so each of ours
is one Sway workspace per screen — a "cell" of a grid, workspaces down, screens across:

                     screen 1 (main)   screen 2     screen 3
    1. Daily         "1:Daily"         "11:Daily"   "21:Daily"
    2. Work          "2:Work"          "12:Work"    "22:Work"
    ...

A screen can SHARE one space between several workspaces (the matrix, D-49): those cells all
point to one Sway workspace on that screen ("101:Shared"), so switching between them leaves
that screen as it is while the others change.

Each workspace can list its apps (F-50, #55): a new window of a listed app is taken to its
workspace however the app was started, every screen goes with it, and Window Placement's fill
order gives it its spot there. In the first seconds after login the window goes quietly and the
screens stay put, so apps that start by themselves don't move you.

    hypeforge-workspaces            run: set up Sway, then keep the screens in step
    hypeforge-workspaces go N       switch every screen to workspace N   (Win + N, a bar click)
    hypeforge-workspaces number     the bar's square: the number of the workspace on screen (#42)
    hypeforge-workspaces move N     send the focused window to workspace N, same screen
    hypeforge-workspaces reload     re-read the settings file

Settings: ~/.config/hypeforge/applets/workspaces.toml (enabled, screens, names, sharing, apps).
Only Python's standard library: it talks to Sway over Sway's own socket (the i3 IPC protocol).
"""

import json
import os
import re
import shlex
import signal
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "common"))
from hfsway import GET_TREE, GET_WORKSPACES, SUBSCRIBE, EVENT_WINDOW, EVENT_WORKSPACE, Sway, quoted  # noqa: E402
from hfapps import ARRIVED, CURRENT, AppIndex, just_logged_in  # noqa: E402
import hfplace  # noqa: E402
from hfbar import signal_bar  # noqa: E402
import hfmenu  # noqa: E402

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypeforge/applets/workspaces.toml"
BAR_FRAGMENT = CONFIG.with_name("workspaces.waybar.json")  # read by the bar (Waybar "include")
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PIDFILE = RUNTIME / "hypeforge-workspaces.pid"
PILLS = RUNTIME / "hypeforge-pills"   # one small JSON per workspace pill; the bar reads them with cat
MOD = "Mod4"        # the Windows key
BAR_SIGNAL = 8      # Waybar redraws the workspace buttons on SIGRTMIN+8


# ---- Settings: the grid ----------------------------------------------------------------------

class Grid:
    """Which Sway workspace each (workspace, screen) cell shows."""

    def __init__(self):
        with open(CONFIG, "rb") as f:
            cfg = tomllib.load(f)
        self.enabled = bool(cfg.get("enabled", False))
        self.screens = list(cfg.get("screens", []))
        self.names = [w["name"] for w in cfg.get("workspace", [])][:9]
        # share: { "DP-3" = [["Daily", "Work"], …] } — each inner list shares one space
        self.cells = {}  # (index, screen position) -> Sway workspace name
        for p, screen in enumerate(self.screens):
            groups = cfg.get("share", {}).get(screen, [])
            for i, name in enumerate(self.names, 1):
                self.cells[i, p] = f"{i + 10 * p}:{name}"
            for g, group in enumerate(groups, 1):
                members = [self.names.index(n) + 1 for n in group if n in self.names]
                if len(members) > 1:
                    for i in members:
                        self.cells[i, p] = f"{100 + 10 * p + g}:Shared"
        # Sway workspace name -> the workspace index it means (None for a shared one)
        self.index_of = {}
        for (i, p), ws in self.cells.items():
            self.index_of[ws] = None if ws in self.index_of or ws.endswith(":Shared") else i

    def usable(self):
        return self.enabled and self.names and self.screens


def current():
    try:
        return int(CURRENT.read_text())
    except (OSError, ValueError):
        return 1


def set_current(index, grid=None):
    if current() != index or not CURRENT.exists():
        CURRENT.write_text(str(index))
        if grid is not None:
            write_pills(grid, index)
        signal_bar(signal.SIGRTMIN + BAR_SIGNAL)  # the buttons redraw


def window_counts(sway, grid):
    """{workspace (1, 2, …): how many windows it has, on every screen together} — busy ones only."""
    counts = {}

    def count(node):
        n = 1 if node.get("pid") else 0
        return n + sum(count(c) for c in node.get("nodes", []) + node.get("floating_nodes", []))
    for out in sway.ask(GET_TREE).get("nodes", []):
        for ws in out.get("nodes", []):
            i = grid.index_of.get(ws.get("name"))
            n = count(ws) if i else 0
            if n:
                counts[i] = counts.get(i, 0) + n
    return counts


def busy_workspaces(sway, grid):
    """The workspaces (1, 2, …) with at least one window on any screen."""
    return set(window_counts(sway, grid))


PAGER_DOTS = 4   # the pager shows up to this many windows as dots, then a +


def write_pills(grid, active, busy=None):
    """The workspace pills (look program step 3, the Rice's R-2: numbers, the active one wide with
    its name). One file per workspace, so the bar redraws them with `cat`, not a program each.
    Returns True when something changed."""
    PILLS.mkdir(exist_ok=True)
    if busy is None:
        try:
            busy = json.loads((PILLS / "busy").read_text())
        except (OSError, ValueError):
            busy = {}
    if not isinstance(busy, dict):  # a set of busy workspaces: one window each, as far as we know
        busy = {i: 1 for i in busy}
    busy = {int(k): v for k, v in busy.items()}
    changed = False
    for i, name in enumerate(grid.names, 1):
        state = "active" if i == active else "busy" if i in busy else "empty"
        body = json.dumps({"text": f"{i}  {name}" if state == "active" else str(i),
                           "class": ["pill", state], "tooltip": f"{i}. {name}"}) + "\n"
        f = PILLS / f"{i}.json"
        if not f.exists() or f.read_text() != body:
            f.write_text(body)
            changed = True
        # the pager (KDE's K-2): a small rectangle per workspace, its windows as dots
        n = busy.get(i, 0)
        dots = " ".join(["●"] * min(n, PAGER_DOTS)) + (" +" if n > PAGER_DOTS else "")
        body = json.dumps({"text": dots or " ", "class": ["pager", state],
                           "tooltip": f"{i}. {name}" + (f"  ({n} window{'s' if n != 1 else ''})" if n else "")}) + "\n"
        f = PILLS / f"pager-{i}.json"
        if not f.exists() or f.read_text() != body:
            f.write_text(body)
            changed = True
    (PILLS / "busy").write_text(json.dumps({str(k): v for k, v in sorted(busy.items())}))
    return changed


# ---- What the keys and the bar call ----------------------------------------------------------

def focused_screen(sway, grid):
    for ws in sway.ask(GET_WORKSPACES):
        if ws["focused"]:
            return grid.screens.index(ws["output"]) if ws["output"] in grid.screens else 0
    return 0


def go(sway, grid, index):
    """Every screen to workspace `index`; a shared screen stays; the keyboard stays put."""
    if not 1 <= index <= len(grid.names):
        return
    here = focused_screen(sway, grid)
    shown = {ws["output"]: ws["name"] for ws in sway.ask(GET_WORKSPACES) if ws["visible"]}
    commands = [f"workspace {quoted(grid.cells[index, p])}"
                for p, screen in enumerate(grid.screens)
                if p != here and shown.get(screen) != grid.cells[index, p]]
    commands.append(f"workspace {quoted(grid.cells[index, here])}")
    sway.run(*commands)
    set_current(index, grid)


def move(sway, grid, index):
    if not 1 <= index <= len(grid.names):
        return
    here = focused_screen(sway, grid)
    sway.run(f"move container to workspace {quoted(grid.cells[index, here])}")


# ---- The bar ---------------------------------------------------------------------------------

def write_bar(grid):
    """Waybar's workspace button (Javier, 2026-10-05): one dropdown, "1. Daily ▾", showing the
    workspace on screen. A click (or Win + Tab) opens the list of all of them (`menu`)."""
    me = shlex.quote(os.path.abspath(sys.argv[0]))
    # A group the bar's own settings place where they want it ("group/workspaces" in modules-left)
    fragment = {
        # #42 (Javier, 2026-10-07): the number of the workspace on screen, in a square right of
        # the emblem — "by looking at the top bar, you never know on which one you are"
        "group/workspaces": {"orientation": "inherit", "modules": ["custom/wsnum", "custom/ws"]},
        "custom/wsnum": {
            "exec": f"{me} number",
            "return-type": "json",
            "interval": "once",
            "signal": BAR_SIGNAL,
            "on-click": f"{me} menu",
            "tooltip": True,
        },
        "custom/ws": {
            "exec": f"{me} label",
            "return-type": "json",
            "interval": "once",
            "signal": BAR_SIGNAL,
            "on-click": f"{me} menu",
            "tooltip": True,
        },
        # The workspace pills (look step 3; the Rice places "group/workspace-pills"): a click goes there
        "group/workspace-pills": {"orientation": "inherit",
                                  "modules": [f"custom/pill-{i}" for i in range(1, len(grid.names) + 1)]},
    }
    fragment["group/pager"] = {"orientation": "inherit",
                               "modules": [f"custom/pager-{i}" for i in range(1, len(grid.names) + 1)]}
    for i in range(1, len(grid.names) + 1):
        fragment[f"custom/pager-{i}"] = {
            "exec": f"cat {shlex.quote(str(PILLS / f'pager-{i}.json'))}",
            "return-type": "json",
            "interval": "once",
            "signal": BAR_SIGNAL,
            "on-click": f"{me} go {i}",
            "tooltip": True,
        }
        fragment[f"custom/pill-{i}"] = {
            "exec": f"cat {shlex.quote(str(PILLS / f'{i}.json'))}",
            "return-type": "json",
            "interval": "once",
            "signal": BAR_SIGNAL,
            "on-click": f"{me} go {i}",
            "tooltip": True,
        }
    text = json.dumps(fragment, indent=2) + "\n"
    if not BAR_FRAGMENT.exists() or BAR_FRAGMENT.read_text() != text:
        BAR_FRAGMENT.write_text(text)
        signal_bar(signal.SIGUSR2)  # Waybar reloads its settings on SIGUSR2


def label(grid):
    """The bar's menu title, "Workspaces" with its key letter underlined (Win + W); the tooltip
    names the workspace on screen."""
    i = current() if 1 <= current() <= len(grid.names) else 1
    # A menu title, like a menu bar (Javier, 2026-10-05); the workspace on screen is in the tooltip
    print(json.dumps({"text": "<u>W</u>orkspaces", "class": "menu", "tooltip": f"On screen: {i}. {grid.names[i - 1]}"}))


def number(grid):
    """The square next to the emblem (#42): the number of the workspace on screen; its name in the
    tooltip. Redrawn with the Workspaces title on every switch (the same bar signal)."""
    i = current() if 1 <= current() <= len(grid.names) else 1
    print(json.dumps({"text": str(i), "class": "wsnum", "tooltip": f"{i}. {grid.names[i - 1]}  (Win + W: the list)"}))


def menu(grid):
    """The dropdown: every workspace in order, the one on screen selected. Opens under the button."""
    if hfmenu.close_open("workspaces"):  # a second click (or Win + Tab) closes it
        return
    here = current()
    # The one on screen is marked (fuzzel cannot colour one line on its own) and selected
    names = [f"{'●' if i == here else '  '}  {i}. {n}" for i, n in enumerate(grid.names, 1)]
    look = os.path.expanduser("~/.config/sway/fuzzel/fuzzel.ini")
    cmd = ["fuzzel", "--dmenu", "--index", "--no-sort", "--prompt", "Workspaces  ",
           "--anchor", "top-left", "--x-margin", "44", "--y-margin", "4",
           "--width", "28", "--lines", str(len(names)), "--select-index", str(current() - 1)]
    if os.path.isfile(look):
        cmd[1:1] = ["--config", look]
    picked = hfmenu.run("workspaces", cmd, "\n".join(names))
    if picked is not None and picked.strip().isdigit():
        go(Sway(), grid, int(picked) + 1)


# ---- Setting Sway up -------------------------------------------------------------------------

def setup(sway, grid):
    write_bar(grid)
    me = shlex.quote(os.path.abspath(sys.argv[0]))
    commands = []
    for (i, p), ws in grid.cells.items():
        commands.append(f"workspace {quoted(ws)} output {grid.screens[p]}")
    for i in range(1, len(grid.names) + 1):
        commands.append(f"bindsym --no-warn {MOD}+{i} exec {me} go {i}")
        commands.append(f"bindsym --no-warn {MOD}+Shift+{i} exec {me} move {i}")
    sway.run(*commands)
    # Number keys beyond our workspaces would open stray one-screen workspaces: switch them off
    for key in [str(i) for i in range(len(grid.names) + 1, 10)] + ["0"]:
        sway.run(f"unbindsym {MOD}+{key}")
        sway.run(f"unbindsym {MOD}+Shift+{key}")

    # Nothing gets stranded: a Sway workspace the grid no longer uses (Sway's own "1" from before
    # the applet, "1:Daily" once screen 1 shares Daily, "101:Shared" once it stops sharing)
    # hands its windows to the cell that now stands in its place.
    start = current() if current() <= len(grid.names) else 1
    for ws in sway.ask(GET_WORKSPACES):
        if ws["name"] in grid.index_of or ws["output"] not in grid.screens:
            continue
        p = grid.screens.index(ws["output"])
        number = ws["name"].split(":", 1)[0]
        i = int(number) % 10 if number.isdigit() and int(number) < 100 and ":" in ws["name"] else start
        target = grid.cells.get((i, p), grid.cells[start, p])
        sway.run(f'[workspace="^{re.escape(ws["name"])}$"] move container to workspace {quoted(target)}')
    write_pills(grid, start, window_counts(sway, grid))
    CURRENT.unlink(missing_ok=True)  # so set_current redraws the bar
    go(sway, grid, start)


# ---- Apps that open on their own workspace (F-50, #55) ----------------------------------------

def find(node, test):
    if test(node):
        return node
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        hit = find(child, test)
        if hit:
            return hit
    return None


def arrive(sway, grid, index_of_app, container):
    """A new window opened. If its app is on a workspace's list and that isn't where it opened,
    take it there: mark it (so Placement leaves it), switch every screen, move it onto the main
    screen's part of that workspace, and give it its spot in the fill order. Nothing is ever
    closed; a window of an app on no list is left alone."""
    index = index_of_app.of_window(container)
    if not index or index > len(grid.names):
        return
    tree = sway.ask(GET_TREE)
    me = container["id"]
    home = find(tree, lambda n: n.get("type") == "workspace" and find(n, lambda m: m.get("id") == me))
    if not home or home["name"] in {grid.cells[index, p] for p in range(len(grid.screens))}:
        return  # already on its workspace (picked from its group, or opened there): nothing to do
    target = grid.cells[index, 0]
    sway.run(f"[con_id={me}] mark --add {ARRIVED}{me}")
    if just_logged_in():  # started by itself at login: off to its place, the screens stay
        sway.run(f"[con_id={me}] move container to workspace {quoted(target)}")
        return
    go(sway, grid, index)
    sway.run(f"[con_id={me}] move container to workspace {quoted(target)}")
    enabled, screens, order = placement()
    if enabled and screens and order:
        hfplace.place(sway, screens, order, me, handed_over=True)
    else:
        sway.run(f"[con_id={me}] focus")


def placement():
    try:
        return hfplace.load()
    except (OSError, ValueError):
        return False, [], []


class Breaker:
    """A safety valve: if this applet switches the screens more than LIMIT times in WINDOW
    seconds, something is fighting it; it stops answering for PAUSE seconds and says so, rather
    than ever locking the desktop again (2026-10-09)."""
    LIMIT, WINDOW, PAUSE = 12, 3.0, 5.0

    def __init__(self, clock=None):
        import time
        self.clock = clock or time.monotonic
        self.recent, self.until = [], 0.0

    def tripped(self):
        now = self.clock()
        if now < self.until:
            return True
        self.recent = [t for t in self.recent if now - t < self.WINDOW] + [now]
        if len(self.recent) > self.LIMIT:
            self.until, self.recent = now + self.PAUSE, []
            print(f"hypeforge-workspaces: {self.LIMIT} switches in {self.WINDOW:.0f} s — something is "
                  f"fighting the workspaces; standing still for {self.PAUSE:.0f} s", file=sys.stderr, flush=True)
            return True
        return False


def keep_in_step(grid):
    """A screen switched some other way (a command, an old binding): pull the others along.
    And every new window: is it an app that belongs on another workspace? (`arrive`)"""
    events = Sway()
    events.ask(SUBSCRIBE, json.dumps(["workspace", "window"]))
    control = Sway()
    index_of_app = AppIndex()
    breaker = Breaker()
    while True:
        kind, event = events.receive()
        if kind == EVENT_WINDOW:
            if event.get("change") == "new":
                arrive(control, grid, index_of_app, event["container"])
            if event.get("change") in ("new", "close", "move"):
                if write_pills(grid, current(), window_counts(control, grid)):
                    signal_bar(signal.SIGRTMIN + BAR_SIGNAL)  # a pill turned busy or empty
            continue
        if kind != EVENT_WORKSPACE:
            continue
        if event.get("change") == "reload":  # `swaymsg reload` drops our keys: set them again
            grid = Grid()
            if not grid.usable():
                return
            setup(control, grid)
            continue
        if event.get("change") != "focus":
            continue
        # Act on how things are NOW, never on the event's workspace: by the time an event is read
        # it may be stale, and our own `go` makes focus events too. Answering old ones made two
        # switches echo each other for ever (2026-10-09: `supertux2 &` from a terminal, 300
        # switches in 10 s, the desktop unusable; scripts/headless-check.py reproduces it).
        workspaces = control.ask(GET_WORKSPACES)
        focused = next((ws["name"] for ws in workspaces if ws["focused"]), None)
        index = grid.index_of.get(focused)
        if index is None:  # a shared space, or not ours: it belongs to no single workspace
            continue
        shown = {ws["output"]: ws["name"] for ws in workspaces if ws["visible"]}
        if index != current() or any(shown.get(s) != grid.cells[index, p]
                                     for p, s in enumerate(grid.screens) if s in shown):
            if breaker.tripped():
                continue
            go(control, grid, index)


# ---- One copy at a time ----------------------------------------------------------------------

def already_running():
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def main():
    args = sys.argv[1:]
    grid = Grid()
    if args in (["label"], ["menu"], ["number"]):
        {"label": label, "menu": menu, "number": number}[args[0]](grid)
        return
    if args and args[0] in ("go", "move") and len(args) == 2:
        if grid.usable():
            (go if args[0] == "go" else move)(Sway(), grid, int(args[1]))
        return
    if args == ["reload"]:
        pid = already_running()
        if pid:
            os.kill(pid, signal.SIGHUP)
        return
    if args:
        sys.exit(__doc__)

    if not grid.usable():
        print("hypeforge-workspaces: switched off in", CONFIG)
        return
    if already_running():
        print("hypeforge-workspaces: already running")
        return
    PIDFILE.write_text(str(os.getpid()))
    # A reload request (SIGHUP) starts the whole program again, so it reads the file afresh.
    signal.signal(signal.SIGHUP, lambda *_: (PIDFILE.unlink(missing_ok=True),
                                             os.execv(sys.executable, [sys.executable] + sys.argv)))
    try:
        setup(Sway(), grid)
        keep_in_step(grid)
    finally:
        PIDFILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
