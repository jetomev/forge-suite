#!/usr/bin/env python3
"""hypeForge Settings — the control centre (D-58, D-59). THE SPIKE, 2026-10-07.

A list of settings pages on the left; the chosen Forge app runs on the right, inside a terminal
pane (forgekit's TerminalPane), with its own menu bar, colours, keys and mouse. Settings holds
the apps; it does not copy them.

    hypeforge-settings            open the control centre
    hypeforge-settings <page>     open it on a page ("screens", "packages"…)

Pages: ~/.config/hypeforge/applets/settings.toml (name, summary, command, forge), or the file named
by HYPEFORGE_SETTINGS_PAGES (for trying new app versions before they are installed).
A page with `forge = true` is a Forge app: it is started with --hypeforge (0.4.0, Javier 2026-10-08),
so it has no Quit of its own; Settings' Quit asks each one to close, and an app with something
unsaved asks its own question first.
Keys: none of its own (Javier, 2026-10-07: every key belongs to the app in the pane; a click on
the list is the way back). The list ends with Manual · License · About · Quit.
"""

import os
import shlex
import signal
import sys
import tomllib
from pathlib import Path

VERSION = "0.5.0"
HERE = Path(__file__).resolve().parent
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypeforge/applets/settings.toml"


def pages():
    override = os.environ.get("HYPEFORGE_SETTINGS_PAGES")
    src = Path(override) if override else CONFIG if CONFIG.exists() else HERE / "settings.toml"
    with open(src, "rb") as f:
        return [p for p in tomllib.load(f).get("page", []) if p.get("name") and p.get("command")]


def main():
    sys.path.insert(0, str(HERE))
    import home as H                       # the Home page's summaries (0.5.0, #46)
    from textual.app import ComposeResult
    from textual.binding import Binding
    from textual.containers import Grid, Horizontal, Vertical, VerticalScroll
    from textual.widgets import OptionList, Static
    from textual.widgets.option_list import Option
    from rich.text import Text

    from forgekit import AboutView, ForgeApp, FORGE_CSS, GPL3_NOTICE, LicenseView
    from forgekit.terminal import TerminalPane

    PAGES = pages()

    class SettingsApp(ForgeApp, inherit_bindings=False):   # no shortcuts of its own: every key belongs to the app in the pane
        APP_NAME = f"hypeForge Settings {VERSION}"
        SHOW_HINT_BAR = False
        MENU_KEYS = False          # forgekit 0.10.0 would give Settings Ctrl keys and numbers: they belong to the app
        CSS = FORGE_CSS + """
        #forge-menubar { display: none; }  /* the only menu bar on screen is the running app's */
        #sec-settings { height: 1fr; }
        #hf-manual { height: 1fr; padding: 1 3; }
        #hf-manual Static { margin: 0 0 1 0; }
        #hf-pages { width: 30; height: 1fr; border-right: solid $forge-border; padding: 0 0 0 1; }
        #hf-pages > .option-list--option-highlighted { background: $forge-selected-bg; color: $forge-selected; }
        #hf-right { width: 1fr; height: 1fr; }
        #hf-pane { height: 1fr; }
        #hf-empty { height: 1fr; padding: 2 3; color: $forge-muted; }
        #hf-running { height: 1; padding: 0 2; color: $forge-muted; background: $forge-surface; }
        /* the Home page (0.5.0, Javier: cards, two columns) */
        #hf-home { height: 1fr; padding: 1 2; }
        #hf-home-title { margin: 0 0 1 1; color: $forge-accent; text-style: bold; }
        #hf-cards { grid-size: 2; grid-gutter: 0 1; height: auto; }
        .hf-card { height: 5; border: round $forge-border; border-title-color: $forge-accent;
                   border-title-style: bold; padding: 0 1; color: $forge-text; }
        .hf-card.has-page:hover { border: round $forge-accent; background: $forge-surface; }
        .hf-card.no-page { border-title-color: $forge-muted; }
        #hf-home-note { margin: 1 0 0 1; color: $forge-muted; }
        """
        MENU = [
            {"id": "settings", "title": "Settings", "kind": "section"},
            {"id": "help", "title": "Help", "kind": "menu", "items": [("Shortcuts", "s", "shortcuts"),
                                                                     ("About", "a", "about")]},
            {"id": "quit", "title": "Quit", "kind": "action", "action": "quit"},
        ]
        SHORTCUTS = [("↑ ↓", "pick a page"), ("Enter", "open the page's app on the right"),
                     ("F2", "back to the list while an app runs"), ("Ctrl+Q", "quit")]
        HINTS = [("↑↓", "pick"), ("Enter", "open"), ("F2", "list"), ("Ctrl+Q", "quit")]
        ABOUT = {"name": "hypeForge Settings", "version": VERSION,
                 "summary": "The control centre of the KognogOS desktop: every setting is a Forge app, and they run here.",
                 "authors": ["Javier", "Claude"]}
        LICENSE_NAME = "GPL-3.0-or-later"
        LICENSE_NOTICE = GPL3_NOTICE
        BINDINGS = []
        EXTRA = [("Manual", "manual"), ("License", "license"), ("About", "about"), ("Quit", "quit")]

        class Card(Static):
            """One Home card: a setting's name on the border, its summary inside; a click opens its page."""

            def __init__(self, title: str, page: str | None, console: bool = False, **kw) -> None:
                super().__init__("…", classes="hf-card " + ("has-page" if page else "no-page"), **kw)
                self.border_title = H.icon(title, console) + title
                self.page = page
                if not page:
                    self.tooltip = "No page of its own yet"

            def on_click(self) -> None:
                if self.page:
                    self.app.open_named(self.page)

        def compose_sections(self) -> ComposeResult:
            with Horizontal(id="sec-settings"):
                yield OptionList(Option(self._named("Home"), id="extra-home"),
                                 *(Option(self._row(p), id=f"page-{i}") for i, p in enumerate(PAGES)),
                                 *(Option(self._named(name), id=f"extra-{act}") for name, act in self.EXTRA),
                                 id="hf-pages")
                with Vertical(id="hf-right"):
                    yield Static("Pick a page on the left: the app opens here, with its own menu bar, keys and "
                                 "mouse. Click the list to pick another — the one you leave keeps running.", id="hf-empty")
                    yield Static("", id="hf-running")
                    # one pane per page (0.3.0, Javier: an app you leave stays open and comes back as it was)
                    for i in range(len(PAGES)):
                        yield TerminalPane(id=f"hf-pane-{i}", classes="hf-pane")
                    # Home: how this computer is set up, a card per setting (0.5.0, #46)
                    with VerticalScroll(id="hf-home", classes="hf-page"):
                        yield Static("Home  ·  how this computer is set up", id="hf-home-title")
                        with Grid(id="hf-cards"):
                            for n, (title, _fn, page) in enumerate(H.CARDS):
                                yield self.Card(title, page, self.forge_console, id=f"hf-card-{n}")
                        yield Static("Click a card to open its page, or pick one on the left.", id="hf-home-note")
                    # About and License open on the right, like the apps (Javier, 2026-10-08: not in a window)
                    yield AboutView(self.ABOUT, id="hf-about", classes="hf-page")
                    yield LicenseView(self.LICENSE_NAME, self.LICENSE_NOTICE, id="hf-license", classes="hf-page")
                    with Vertical(id="hf-manual"):
                        yield Static("[b]hypeForge Settings[/b] — the control centre of the KognogOS desktop.")
                        yield Static("Every setting is its own Forge app. This window holds them: pick one on the "
                                     "left and it runs on the right, with its own menu bar, keys and mouse — exactly "
                                     "as it does in its own window.")
                        yield Static("The list is the only thing that belongs to Settings. Click it to change page: "
                                     "the app you leave keeps running, and comes back exactly as you left it.")
                        yield Static("Manual, License, About and Quit are the last four entries. The apps "
                                     "here have no Quit of their own: Quit closes Settings and every app inside "
                                     "it. An app with something not saved asks you first, on its own page.")

        def _named(self, name: str, icon: str | None = None) -> Text:
            # names only (Javier, 2026-10-07: "people will click on them and find out"), each with
            # its icon (Javier, 2026-10-08); none on a text console
            mark = "" if self.forge_console else ((icon + " ") if icon else H.icon(name))
            return Text(mark + name, style="bold")

        def _row(self, p) -> Text:
            return self._named(p["name"], p.get("icon"))

        def on_mount(self) -> None:
            super().on_mount()
            for pane in self.query(".hf-pane"):
                pane.display = False
            self.query_one("#hf-running").display = False
            self.query_one("#hf-manual").display = False
            for page in self.query(".hf-page"):
                page.display = False
            self.query_one("#hf-pages", OptionList).focus()
            want = (sys.argv[1] if len(sys.argv) > 1 else "").lower()
            for i, p in enumerate(PAGES):
                if want and p["name"].lower().startswith(want):
                    self.query_one("#hf-pages", OptionList).highlighted = i + 1     # Home is the first line
                    self.call_after_refresh(self.open_page, i)
                    return
            self.query_one("#hf-pages", OptionList).highlighted = 0
            self.show_home()

        def show_home(self) -> None:
            """Home on the right, its cards asked afresh (a thread: a slow answer never freezes Settings)."""
            self.show_right("#hf-home")
            self.query_one("#hf-empty").display = False
            self.run_worker(self._fill_cards, thread=True, exclusive=True, group="hf-home")

        def _fill_cards(self) -> None:
            rows = H.summaries()
            self.call_from_thread(self._show_cards, rows)

        def _show_cards(self, rows) -> None:
            for n, (_title, lines, _page) in enumerate(rows):
                self.query_one(f"#hf-card-{n}", Static).update(Text("\n".join(lines)))

        def open_named(self, name: str) -> None:
            """A card's click: the Settings page with that name, if there is one."""
            for i, p in enumerate(PAGES):
                if p["name"].lower() == name.lower():
                    self.query_one("#hf-pages", OptionList).highlighted = i + 1
                    self.open_page(i)
                    return
            self.notify(f"{name} has no page in Settings yet.", timeout=4)

        def on_option_list_option_selected(self, e: OptionList.OptionSelected) -> None:
            e.stop()
            oid = e.option.id or ""
            if oid.startswith("extra-"):
                self.extra(oid.removeprefix("extra-"))
            else:
                self.open_page(int(oid.removeprefix("page-")))

        def extra(self, act: str) -> None:
            self._quitting = False                # any choice on the list ends a quit in progress
            if act == "quit":
                self.quit_all()
            elif act == "home":
                self.show_home()
            elif act in ("about", "license", "manual"):
                self.show_right(f"#hf-{act}")

        def show_right(self, which: str) -> None:
            """Manual, About or License on the right, where the apps run; the apps keep running."""
            for w in self.query(".hf-pane, .hf-page"):
                w.display = False
            self.query_one("#hf-running").display = False
            self.query_one("#hf-empty").display = False
            self.query_one("#hf-manual").display = which == "#hf-manual"
            if which != "#hf-manual":
                self.query_one(which).display = True

        def action_back_from_page(self) -> None:      # Esc on About / License: back to the list
            self.query_one("#hf-pages", OptionList).focus()

        # ── Quit (0.4.0, Javier 2026-10-08: "ask each app, its own way") ─────────────────────────
        def _forge_panes(self) -> list[tuple[int, "TerminalPane"]]:
            return [(i, self.query_one(f"#hf-pane-{i}", TerminalPane)) for i, p in enumerate(PAGES)
                    if p.get("forge") and self.query_one(f"#hf-pane-{i}", TerminalPane).running]

        def quit_all(self) -> None:
            """Every Forge app is asked to close (SIGUSR1: forgekit's host_quit runs the app's own
            check); anything else is closed. Settings closes when the last app has; an app that
            asks a question is shown, and Settings waits for the answer."""
            for i, pane in enumerate(self.query(TerminalPane)):
                if pane.running and not PAGES[i].get("forge"):
                    pane.terminate()
            asked = self._forge_panes()
            if not asked:
                self.exit()
                return
            self._quitting = True
            for _i, pane in asked:
                try:
                    os.kill(pane.proc.pid, signal.SIGUSR1)     # the app only, never its children
                except (OSError, AttributeError):
                    pane.terminate()
            self.set_timer(0.8, self._quit_next)

        def _quit_next(self) -> None:
            if not getattr(self, "_quitting", False):
                return
            left = self._forge_panes()
            if not left:
                self.exit()
                return
            i, _pane = left[0]
            self.open_page(i, keep_quitting=True)
            self.query_one("#hf-running", Static).update(
                f"{PAGES[i]['name']} has something not saved: answer it, and Settings closes after")

        def open_page(self, i: int, keep_quitting: bool = False) -> None:
            if not keep_quitting:
                self._quitting = False
            """Show page i's pane; start its app the first time (or again after it closed itself).
            The pane we leave stays as it is, its app running (Javier, 2026-10-08)."""
            p = PAGES[i]
            for j, other in enumerate(self.query(".hf-pane")):
                other.display = (other.id == f"hf-pane-{i}")
            pane = self.query_one(f"#hf-pane-{i}", TerminalPane)
            self.query_one("#hf-empty").display = False
            self.query_one("#hf-manual").display = False
            for page in self.query(".hf-page"):
                page.display = False
            self.query_one("#hf-running", Static).update(f"{p['name']}  ·  click the list for another page; this one keeps running")
            self.query_one("#hf-running").display = True
            if not pane.running:
                cmd = ["sh", "-c", f"exec {os.path.expanduser(p['command'])}"] if any(ch in p["command"] for ch in ";|&") \
                    else [os.path.expanduser(w) for w in shlex.split(p["command"])]
                if p.get("forge") and cmd[:2] != ["sh", "-c"]:
                    cmd.append("--hypeforge")     # no Quit of its own: Settings closes it (0.4.0)
                self.call_after_refresh(pane.start, cmd, dict(os.environ))
            self.call_after_refresh(pane.focus)

        def on_terminal_pane_exited(self, e: TerminalPane.Exited) -> None:
            if getattr(self, "_quitting", False):
                self.call_after_refresh(self._quit_next)
                return
            if e.pane.display:      # the one on screen closed itself (its Ctrl+Q): say so, keys back to the list
                self.query_one("#hf-running", Static).update(
                    f"closed  ·  pick a page on the left; picking this one again starts it afresh")
                self.query_one("#hf-pages", OptionList).focus()


    SettingsApp().run()


if __name__ == "__main__":
    main()
