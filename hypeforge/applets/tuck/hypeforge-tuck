#!/usr/bin/env python3
"""hypeForge applet · a click on a window tucks away the floating windows covering it.

Javier, 2026-10-10: a terminal floats over Chrome (tiled, full screen); he clicks Chrome — and the
terminal stays on top. In Sway a floating window is always drawn above the tiled ones, so it can't
"go behind". The closest thing: it is tucked away, like minimised (Sway's scratchpad). Its icon on
the taskbar, Win + − or (later) Alt + Tab bring it back on top.

The rule, on every focus change to a TILED window:
  - a floating window on the same workspace that COVERS it (their areas overlap) is tucked away;
  - one beside it, not covering it, stays where it is;
  - one of the same app (a "Save as…" dialog of the window clicked) stays — dialogs never vanish;
  - a sticky window (shown on every workspace) stays.

It also keeps two small records for the rest of the desktop (Javier, 2026-10-11: on the Rice a tucked
window had no way back you could see):
  - which windows were used last ($XDG_RUNTIME_DIR/hypeforge-focus.json), the order Alt + Tab shows;
  - how many windows are tucked away ($XDG_RUNTIME_DIR/hypeforge-tucked.json), the bar's icon for
    them: hidden when none, a click brings them back.

    hypeforge-tuck              keep watching (started at login; one copy)
    hypeforge-tuck back         the bar icon's click: one tucked window comes back on top; several,
                                Alt + Tab's cards with just those
"""

from __future__ import annotations

import json
import os
import signal
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "common"))
from hfsway import GET_TREE, SUBSCRIBE, EVENT_WINDOW, Sway  # noqa: E402
from hfbar import signal_bar  # noqa: E402

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PIDFILE = RUNTIME / "hypeforge-tuck.pid"
RECENT = RUNTIME / "hypeforge-focus.json"       # window ids, last used first (Alt + Tab's order)
TUCKED = RUNTIME / "hypeforge-tucked.json"      # the bar's icon for the tucked windows
SCRATCH = "__i3_scratch"
BAR_SIGNAL = 14                                 # Waybar redraws the tucked icon on SIGRTMIN+14 (8-13 are taken)
KEEP_RECENT = 64
ICON = "\U000F05B2"                             # nerd font: window-restore (two windows, one coming forward)
PANEL = Path(os.path.realpath(__file__)).parent.parent / "panels/hypeforge-panel"


def overlap(a: dict, b: dict) -> bool:
    return (a["x"] < b["x"] + b["width"] and b["x"] < a["x"] + a["width"]
            and a["y"] < b["y"] + b["height"] and b["y"] < a["y"] + a["height"])


def windows_in(node: dict) -> list[dict]:
    out = []
    if node.get("pid"):
        out.append(node)
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        out.extend(windows_in(child))
    return out


def workspaces(tree: dict):
    for output in tree.get("nodes", []):
        for ws in output.get("nodes", []):
            if ws.get("type") == "workspace":
                yield ws


def same_app(a: dict, b: dict) -> bool:
    if a.get("pid") and a.get("pid") == b.get("pid"):
        return True
    ida = (a.get("app_id") or (a.get("window_properties") or {}).get("class") or "").lower()
    idb = (b.get("app_id") or (b.get("window_properties") or {}).get("class") or "").lower()
    return bool(ida) and ida == idb


def to_tuck(tree: dict) -> list[int]:
    """The floating windows to tuck away now: those covering the focused TILED window on its
    workspace, not of its app, not sticky. Nothing when the focus is on a floating window."""
    for ws in workspaces(tree):
        if ws.get("name") == SCRATCH:
            continue
        tiled = [w for n in ws.get("nodes", []) for w in windows_in(n)]
        focused = next((w for w in tiled if w.get("focused")), None)
        if focused is None:
            continue
        out = []
        for f in (w for n in ws.get("floating_nodes", []) for w in windows_in(n)):
            transient = (f.get("window_properties") or {}).get("transient_for")
            if f.get("sticky") or transient or same_app(f, focused):
                continue
            if overlap(f["rect"], focused["rect"]):
                out.append(f["id"])
        return out
    return []


def tucked(tree: dict) -> list[dict]:
    for ws in workspaces(tree):       # the hidden workspace that holds them is one too
        if ws.get("name") == SCRATCH:
            return [w for n in ws.get("nodes", []) + ws.get("floating_nodes", []) for w in windows_in(n)]
    return []


def tucked_text(wins: list[dict]) -> str:
    """The bar's piece: nothing when no window is tucked away (Waybar hides it), else the icon and
    how many, the names in the tooltip."""
    if not wins:
        return json.dumps({"text": "", "tooltip": "", "class": "none"})
    names = [w.get("name") or w.get("app_id") or "a window" for w in wins]
    tip = "Tucked away: " + ", ".join(names) + ("\nClick to bring it back" if len(wins) == 1
                                                else "\nClick to pick one · Alt + Tab")
    return json.dumps({"text": f"{ICON} {len(wins)}", "tooltip": tip, "class": "some"}, ensure_ascii=False)


def write(path: Path, text: str) -> bool:
    """Write when it changed; True if it did."""
    try:
        if path.read_text() == text:
            return False
    except OSError:
        pass
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)
    return True


def remember(order: list[int], wid: int) -> list[int]:
    return ([wid] + [i for i in order if i != wid])[:KEEP_RECENT]


def watch():
    control, events = Sway(), Sway()
    events.ask(SUBSCRIBE, json.dumps(["window"]))
    order: list[int] = []
    tree = control.ask(GET_TREE)
    if write(TUCKED, tucked_text(tucked(tree))):
        signal_bar(signal.SIGRTMIN + BAR_SIGNAL, wait=0.5)
    while True:
        kind, event = events.receive()
        if kind != EVENT_WINDOW:
            continue
        change, con = event.get("change"), event.get("container") or {}
        if change == "focus" and con.get("id"):
            order = remember(order, con["id"])
            write(RECENT, json.dumps(order))
        if change == "focus" and con.get("type") != "floating_con":
            ids = to_tuck(control.ask(GET_TREE))
            if ids:
                control.run(*[f"[con_id={i}] move scratchpad" for i in ids])
        if change in ("focus", "move", "close", "new", "floating"):
            if write(TUCKED, tucked_text(tucked(control.ask(GET_TREE)))):
                signal_bar(signal.SIGRTMIN + BAR_SIGNAL, wait=0.5)


def back():
    """The bar icon's click."""
    control = Sway()
    wins = tucked(control.ask(GET_TREE))
    if len(wins) == 1:
        control.run(f"[con_id={wins[0]['id']}] scratchpad show")
    elif wins:
        control.run(f"exec {PANEL} switcher --tucked")


def main():
    if sys.argv[1:] == ["back"]:
        back()
        return
    if sys.argv[1:]:
        sys.exit(__doc__)
    try:
        os.kill(int(PIDFILE.read_text()), 0)
        print("hypeforge-tuck: already running")
        return
    except (OSError, ValueError):
        pass
    PIDFILE.write_text(str(os.getpid()))
    try:
        watch()
    finally:
        PIDFILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
