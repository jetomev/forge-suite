#!/usr/bin/env python3
"""hypeForge applet 10 · Start-at-login apps (Javier, 2026-10-05).

Sway does not read the autostart folder the way Plasma does, so apps marked "start at login"
(Dropbox, Insync…) never started in the Sway session. Sway runs this once at login:

    hypeforge-autostart          start every app in ~/.config/autostart/
    hypeforge-autostart --list   show what would start, and what is skipped and why

Only YOUR folder is read — not the system-wide one, which is full of KDE's own start-up items.
An entry is skipped when it says Hidden=true, is limited to other desktops (OnlyShowIn without
sway) or excludes Sway (NotShowIn=sway), or is already running. A Startup apps Forge app will
manage the list later (D-59).
"""

import os
import re
import shlex
import subprocess
import sys
from configparser import ConfigParser
from pathlib import Path

FOLDER = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "autostart"
DESKTOP = "sway"


def entries():
    for path in sorted(FOLDER.glob("*.desktop")):
        cfg = ConfigParser(interpolation=None, strict=False)
        try:
            cfg.read(path, encoding="utf-8")
            e = cfg["Desktop Entry"]
        except Exception:
            yield path.name, None, "unreadable"
            continue
        names = lambda key: [x.lower() for x in e.get(key, "").split(";") if x]
        command = re.sub(r"\s*%[fFuUdDnNickvm]", "", e.get("Exec", "")).strip()
        if e.get("Hidden", "false").lower() == "true":
            yield path.name, None, "Hidden=true"
        elif names("OnlyShowIn") and DESKTOP not in names("OnlyShowIn"):
            yield path.name, None, f"only for {e.get('OnlyShowIn')}"
        elif DESKTOP in names("NotShowIn"):
            yield path.name, None, "NotShowIn=sway"
        elif not command:
            yield path.name, None, "no Exec line"
        else:
            yield path.name, command, None


def running(command):
    program = os.path.basename(shlex.split(command)[0])
    return subprocess.run(["pgrep", "-x", program[:15]], capture_output=True).returncode == 0


def main():
    listing = sys.argv[1:] == ["--list"]
    for name, command, skipped in entries():
        if skipped:
            print(f"skip   {name}: {skipped}")
        elif running(command):
            print(f"skip   {name}: already running")
        elif listing:
            print(f"start  {name}: {command}")
        else:
            subprocess.Popen(shlex.split(command), start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"start  {name}: {command}")


if __name__ == "__main__":
    main()
