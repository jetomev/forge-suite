class LookError(Exception):
    """Something the person can fix: a name that doesn't exist, a missing picture…"""


# ── reading styles and themes ───────────────────────────────────────────────────────────────
def themes() -> dict:
    d = tomllib.loads(COLOURS.read_text())
    return {slug: d["themes"][slug] for slug in d["meta"]["order"]}


def styles() -> dict:
    out = {}
    for f in sorted(STYLES.glob("*/style.toml")):
        s = tomllib.loads(f.read_text())
        out[s["meta"]["slug"]] = s
    return out


def token(theme: dict, path: str) -> str:
    """A colour role, or a blend of roles: "border.subtle*2+border.strong" = two parts of one,
    one of the other (still only the theme's own colours, mixed)."""
    if "+" in path:
        parts = []
        for term in path.split("+"):
            name, _, w = term.strip().partition("*")
            parts.append((token(theme, name), float(w or 1)))
        total = sum(w for _, w in parts)
        rgb = [round(sum(int(c[1 + 2 * i:3 + 2 * i], 16) * w for c, w in parts) / total) for i in range(3)]
        return "#" + "".join(f"{v:02x}" for v in rgb)
    group, _, key = path.partition(".")
    try:
        v = theme[group][key]
    except KeyError:
        raise LookError(f"the theme has no colour called {path}") from None
    return v


def resolve(role: str, style: dict, theme: dict) -> str:
    path = style.get("roles", {}).get(role) or DEFAULT_ROLES.get(role)
    if not path:
        raise LookError(f"no colour for the role {role}")
    if path.startswith("role:"):
        if path[5:] == role:
            raise LookError(f"the role {role} names itself")
        return resolve(path[5:], style, theme)
    return token(theme, path)


# ── the templates ───────────────────────────────────────────────────────────────────────────
def hex_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


# A shape the style leaves out takes hypeForge's own (today's) value.
SHAPE_DEFAULTS = {"border_window": 2, "border_popup": 1, "radius_window": 0, "radius_popup": 0,
                  "gap_inner": 10, "gap_outer": 0, "titlebar": False}


# The pop-up standard (D-116, Javier, 2026-10-20): one font, frame and rounding for every pop-up and
# notification on every style in KognogOS v1.0; only the colours follow the theme. The corners switch
# squares it (straight); otherwise one rounding. The panel kit draws the same (panelkit.Look; a test
# holds the two together). Widths: narrow 300 · medium 380 · wide 460.
POPUP = {"font": "Noto Sans", "size": 10.5, "border": 1, "radius": 10, "narrow": 300, "medium": 380, "wide": 460,
         "icon": 32}                                     # a notification's app icon


def popup_value(style: dict, theme: dict, name: str, note_icons: str | None = None):
    """`{{popup:…}}` in a template: the standard's numbers for this style (its corners switch)."""
    if name == "radius":
        return 0 if style.get("corners") == "straight" else POPUP["radius"]
    if name == "font":
        return f"{POPUP['font']} {POPUP['size']}"
    if name == "icon_path":              # mako finds an app's icon only in the folders it is given
        names = theme.get("names", {})
        out = [note_icons] if note_icons else []           # the theme's icons in mako's order (note_icon_map)
        for name_ in (names.get("icons"), "Adwaita", "hicolor"):
            for base in ("~/.local/share/icons", "/usr/share/icons"):
                d = Path(base).expanduser() / name_ if name_ else None
                if d and d.is_dir() and str(d) not in out:
                    out.append(str(d))
        return ":".join(out) or "/usr/share/icons/hicolor"
    if name in POPUP:
        return POPUP[name]
    raise LookError(f"the pop-up standard has no {name}")


ICON_SIZE = re.compile(r"(\d+)(?:x\d+)?(?:@\d+x?)?|scalable")


def note_icon_map(out: Path, icon_theme: str, bases=("~/.local/share/icons", "/usr/share/icons")) -> int:
    """Notifications show an app's icon by name only from folders laid out size/kind/name with a NUMBER for
    the size (48x48/apps/…): mako 1.11 skips "scalable" (icon.c, resolve_icon). Many icon themes are
    kind/size/name and all drawings (candy-icons: apps/scalable/…), so mako showed no icon (2026-10-24).
    A map of links in mako's order, a drawing folder named for the notification's icon size (an exact
    match, drawn at that size); rebuilt at every apply. Returns the links made."""
    new = out.with_name(out.name + ".new")
    if new.exists():
        shutil.rmtree(new)                               # links and folders only: rmtree never follows a link
    made = 0
    for base in bases:                                   # the person's copy first
        root = Path(base).expanduser() / icon_theme
        if not root.is_dir():
            continue
        for kind in sorted(k for k in root.iterdir() if k.is_dir()):
            for size in sorted(d for d in kind.iterdir() if d.is_dir()):
                m = ICON_SIZE.fullmatch(size.name)
                if not m or ICON_SIZE.fullmatch(kind.name):       # already mako's order: it reads those itself
                    continue
                px = POPUP["icon"] if size.name == "scalable" else m.group(1)
                at = new / f"{px}x{px}" / kind.name
                if at.exists() or at.is_symlink():
                    continue
                at.parent.mkdir(parents=True, exist_ok=True)
                at.symlink_to(size)
                made += 1
    new.mkdir(parents=True, exist_ok=True)
    old = out.with_name(out.name + ".old")
    if old.exists():
        shutil.rmtree(old)
    if out.exists():
        out.rename(old)
    new.rename(out)
    if old.exists():
        shutil.rmtree(old)
    return made


def shape_of(style: dict, name: str):
    shape = style.get("shape", {})
    v = shape.get(name, SHAPE_DEFAULTS.get(name))
    if isinstance(v, dict):                    # COSMIC: one value per roundness choice (C-2)
        v = v.get(shape.get("roundness", ""), next(iter(v.values())))
    if v is None:
        raise LookError(f"the style {style['meta']['slug']} has no shape {name}")
    return v


def fx_value(style: dict, theme: dict, name: str) -> str:
    """One SwayFX setting from the style's [fx] table; a style without one gets no effects."""
    fx = style.get("fx", {})
    onoff = lambda v: "enable" if v else "disable"
    if name == "corner_radius":
        v = fx.get("corner_radius", 0)
        if isinstance(v, str) and v.startswith("shape."):
            v = shape_of(style, v[6:])
        return str(int(v))
    if name in ("shadows", "blur"):
        return onoff(fx.get(name, False))
    if name == "shadow_blur_radius":
        return str(fx.get("shadow_blur_radius", 20))
    if name == "shadow_offset":
        x, y = fx.get("shadow_offset", [0, 0])
        return f"{x} {y}"
    if name == "shadow_color":
        a = fx.get("shadow_opacity", "effects.shadow_opacity")
        if isinstance(a, str):
            a = token(theme, a)
        return token(theme, "effects.shadow") + f"{round(float(a) * 255):02x}"
    if name == "blur_passes":
        return str(fx.get("blur_passes", 2))
    if name == "blur_radius":
        return str(fx.get("blur_radius", 5))
    if name == "frame":
        frame = fx.get("frame", True)
        gap = fx.get("gap_outer")
        out = [f"gaps outer {int(gap)}"] if gap is not None else []
        if frame is True:
            out.insert(0, "# windows keep their frame line in this style")
        elif frame == "quiet":
            # D-80 (Javier, 10-10): a quiet frame — dark enough that SwayFX's corner notch on big
            # windows (F-56) barely shows, light enough to outline windows on a dark wallpaper
            f = token(theme, fx.get("frame_focused", "border.subtle"))
            u = token(theme, fx.get("frame_unfocused", "surface.overlay"))
            w = int(fx.get("frame_width", 2))
            out = ["# a quiet frame in FX (D-80): outlines the windows, hides the corner notch (F-56)"] + out + [
                f"default_border pixel {w}", f"default_floating_border pixel {w}",
                f"client.focused          {f} $hf_titlebar $hf_text    {f} {f}",
                f"client.focused_inactive {u} $hf_titlebar $hf_subtext {u} {u}",
                f"client.unfocused        {u} $hf_titlebar $hf_subtext {u} {u}"]
        else:
            out = ["# no frame line in FX (F-56): SwayFX draws a notch where a big window's rounded corner meets",
                   "# its frame; the shadow carries the depth, the dimmed others show which window has focus"] + out + [
                   "default_border none", "default_floating_border none",
                   "bindsym --no-warn $mod+Shift+space floating toggle, border none"]
        return "\n".join(out)
    if name == "dim_inactive":
        return str(fx.get("default_dim_inactive", fx.get("dim_inactive", 0.0)))
    if name == "layers":
        r = shape_of(style, "radius_popup")
        if not fx.get("blur") and not fx.get("shadows"):
            return "# no effects on the bar, the lists or notifications in this style"
        out = []
        for ns in ("waybar", "launcher", "notifications"):   # Waybar, fuzzel, mako
            # bar_shadows: a bar flush against the windows casts its shadow ON their frame and dims
            # it (Javier's FX screenshot, 10-10); such styles say bar_shadows = false
            shadows = fx.get("bar_shadows", fx.get("shadows")) if ns == "waybar" else fx.get("shadows")
            radius = popup_value(style, theme, "radius") if ns == "notifications" else r   # D-116: the standard's
            out.append(f'layer_effects "{ns}" {{\n    blur {onoff(fx.get("blur"))};\n    blur_ignore_transparent enable;\n'
                       f'    shadows {onoff(shadows)};\n    corner_radius {radius};\n}}')
        return "\n".join(out)
    raise LookError(f"unknown SwayFX setting {name}")


def style_applets(style: dict) -> list[str]:
    """The applets a style starts (`[layout] applets`, a list; COSMIC's is a word about pop-ups)."""
    names = style.get("layout", {}).get("applets", [])
    return [n for n in names if isinstance(n, str)] if isinstance(names, list) else []


def wait_for_sound():
    """A reload in place waits for sound to settle: Waybar's sound piece takes the bar down otherwise (F-86)."""
    sys.path.insert(0, str(REPO / "applets/common"))
    from hfbar import wait_for_sound as wait
    wait()


def stop_other_applets(keep: list[str], say=print, runtime: Path | None = None) -> list[str]:
    """A switch stops what the OLD style started and the new one doesn't use (Windows 11's Taskbar
    applet has nothing to do on the Rice). By the saved process number only, and only when that process
    is still the applet (a number can be reused) — never by searching command lines."""
    runtime = runtime or Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    stopped, pids = [], []
    for name in sorted({n for s in styles().values() for n in style_applets(s)} - set(keep)):
        for pidfile in (runtime / f"hypeforge-{name}.pid", runtime / f"hypeforge-panel-{name}.pid"):
            try:
                pid = int(pidfile.read_text())
                cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
            except (OSError, ValueError):
                continue
            if f"hypeforge-{name}" not in cmdline and f"hypeforge-panel {name}" not in cmdline:
                continue
            try:
                os.kill(pid, signal.SIGTERM)
                stopped.append(name)
                pids.append(pid)
            except OSError:
                pass
    for _ in range(20):               # gone before Sway's reload starts the new style's copies
        if not any(Path(f"/proc/{p}").exists() for p in pids):
            break
        time.sleep(0.05)
    if stopped:
        say(f"  stopped what the old style used: {', '.join(stopped)}")
    return stopped


def sway_applets(style: dict) -> str:
    """The applets a style's bar needs, started with Sway (look step 5): `[layout] applets` names
    them (e.g. "taskbar"). exec_always runs at login and at every reload; each applet keeps one
    copy, so a reload never doubles it. A style that needs none says so."""
    names = style_applets(style)
    # #54: through the watcher, so a style applet that crashes says so (a second copy at a reload ends
    # with status 0, which the watcher keeps quiet about)
    watch = REPO / "applets/common/hypeforge-watch"
    lines = [f"exec_always {watch} {n} {REPO / 'applets' / n / ('hypeforge-' + n)}" for n in names
             if (REPO / "applets" / n / f"hypeforge-{n}").is_file()]
    return "\n".join(["# the applets this style's bar needs"] + lines) if lines else "# this style's bar needs no extra applets"


def sway_border(shape: dict) -> str:
    w = shape.get("border_window", SHAPE_DEFAULTS["border_window"])
    return f"normal {w}" if shape.get("titlebar") else f"pixel {w}"


def sway_floating_border(shape: dict) -> str:
    """Floating windows always get the title bar (D-110, Javier 10-17: "theme title bars"; floating windows
    only — a style's tiled windows keep what it says). applets/window/ gives it to windows made to float
    after they opened, which Sway itself doesn't."""
    return f"normal {shape.get('border_window', SHAPE_DEFAULTS['border_window'])}"


def sway_titlebar(style: dict) -> str:
    """The title bars' look: every style has them now, on its floating windows at least (D-110)."""
    shape, fonts = style.get("shape", {}), style.get("fonts", {})
    lines = [f"title_align {shape.get('titlebar_align', 'center')}"]
    if fonts.get("ui"):
        bold = " Bold" if fonts.get("ui_bold") else ""
        lines.append(f"font pango:{fonts['ui']}{bold} {fonts.get('ui_size', 10)}")
    pad = max(1, (shape.get("titlebar_height", 24) - 16) // 2)
    lines.append(f"titlebar_padding 6 {pad}")
    if shape.get("titlebar_edge_matches_border"):   # the title bar's edge as thick as the window's frame (Rice, 2026-10-30)
        lines.append(f"titlebar_border_thickness {shape.get('border_window', SHAPE_DEFAULTS['border_window'])}")
    return "\n".join(lines)


def fill(template: str, ctx: dict) -> str:
    style, theme = ctx["style"], ctx["theme"]

    def one(m: re.Match) -> str:
        key, flt = m.group(1), m.group(2)
        if key.startswith("meta:"):
            return str(ctx["meta"][key[5:]])
        if key.startswith("shape:"):
            return str(shape_of(style, key[6:]))
        if key.startswith("popup:"):
            return str(popup_value(style, theme, key[6:], ctx.get("note_icons")))
        if key.startswith("token:"):
            return token(theme, key[6:])
        if key.startswith("names:"):
            return str(ctx["names"][key[6:]])
        if key.startswith("fx:"):
            return fx_value(style, theme, key[3:])
        if key == "sway:border":
            return sway_border(style.get("shape", {}))
        if key == "sway:floating_border":
            return sway_floating_border(style.get("shape", {}))
        if key == "sway:titlebar":
            return sway_titlebar(style)
        if key == "sway:applets":
            return sway_applets(style)
        if key == "wallpaper":
            return ctx["wallpaper"]
        if key == "wallpaper_line":
            return ctx["wallpaper_line"]
        value = resolve(key, style, theme)
        if not flt:
            return value
        if flt == "hex8":
            return value.lstrip("#") + "ff"
        if flt.startswith("alpha("):
            a = float(flt[6:-1])
            r, g, b = hex_rgb(value)
            return f"rgba({r}, {g}, {b}, {a})"
        raise LookError(f"unknown filter {flt}")

    return PLACEHOLDER.sub(one, template)


# ── names that must exist on the machine ────────────────────────────────────────────────────
def _found(kind: str, name: str) -> bool:
    dirs = {"icons": ["/usr/share/icons", "~/.local/share/icons", "~/.icons"],
            "themes": ["/usr/share/themes", "~/.local/share/themes", "~/.themes"]}[kind]
    return any((Path(d).expanduser() / name).is_dir() for d in dirs)


def names_for(theme: dict, check: bool = True) -> dict:
    n = dict(theme["names"])
    n["prefer_dark"] = "true" if theme["meta"]["polarity"] == "dark" else "false"
    if check:
        for key, kind in (("cursor", "icons"), ("icons", "icons"), ("gtk_theme", "themes")):
            if not _found(kind, n[key]):
                raise LookError(f"{n[key]} ({key}) is not installed, so this theme can't be applied yet")
    return n


# ── wallpapers ──────────────────────────────────────────────────────────────────────────────
def wall_job(slug: str, t: dict) -> tuple[str, str, list[str]]:
    """The same picture the look program showed for each theme (review-5-rice/make-wallpapers.py)."""
    m = t["meta"]
    if m["polarity"] == "light" and slug != "light-gray":
        return "mountains", "light", [t["surface"]["overlay"], t["surface"]["sunken"], t["band"]["soft"], t["band"]["base"], t["band"]["strong"]]
    motif = ("circuit" if m["family"] == "neutral" and slug not in ("white", "black") else
             "skyline" if slug == "kognogos-mocha" or m["tone"] == "mid" else "synthwave")
    return motif, "dark", [t["surface"]["sunken"], t["band"]["strong"], t["band"]["base"], t["band"]["text"], t["pop"]["base"]]


# The wallpaper choice (Javier, 2026-10-11, themeForge's Wallpaper page):
#   "theme"             the style's own topic ([wallpaper] topic in style.toml), in the colour theme's colours
#   "kognogos:<design>" a KognogOS background in the colour theme's colours (tier-aware · arch-distro)
#   "topic:<topic>"     another style's drawn wallpaper in the colour theme's colours (circuit, mountains…; 2026-10-17)
#   "solid"             no picture: the colour theme's own colour
#   a file              one of the person's pictures
# and how it lies on each screen (the same picture on every screen): Sway's own ways.
FITS = ("fill", "fit", "stretch", "center", "tile")
KOGNOGOS_ART = REPO / "assets/wallpaper"
KOGNOGOS_DESIGNS = {"tier-aware": "Tier Aware", "arch-distro": "Arch Distro"}
KEEP_PICTURES = 40                       # made pictures kept in the cache (each look its own)


def _stamp(*files: Path) -> str:
    """A short fingerprint of what a picture is made from: a change remakes it."""
    import hashlib
    h = hashlib.sha1()
    for f in files:
        try:
            h.update(f.read_bytes())
        except OSError:
            pass
    return h.hexdigest()[:6]


def _prune_pictures(cache: Path, keep: Path):
    made = sorted((p for p in cache.glob("*.png") if p != keep and not p.name.startswith(".")),
                  key=lambda p: p.stat().st_mtime)
    for p in made[:-KEEP_PICTURES] if len(made) > KEEP_PICTURES else []:
        p.unlink(missing_ok=True)
    for p in cache.glob(".*.png"):                  # a picture another program is still drawing stays; one left
        try:                                        # by a crash an hour ago goes
            if time.time() - p.stat().st_mtime > 3600:
                p.unlink(missing_ok=True)
        except OSError:
            pass


def _contrast(a: str, b: str) -> float:
    def lum(h):
        c = [int(h.lstrip("#")[i:i + 2], 16) / 255 for i in (0, 2, 4)]
        c = [v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4 for v in c]
        return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def wallpaper_colours(slug: str, t: dict) -> tuple[str, str]:
    """(background, words) for a KognogOS background, the solid colour and the bars of "fit": the
    theme's own colour band (deep on dark themes, soft on light ones), so Red is red and Green green
    (the neutral surfaces would make them all gray). KognogOS Mocha is exactly the original."""
    if slug == "kognogos-mocha":
        return t["surface"]["base"], "#ffffff"
    if t["meta"]["polarity"] == "dark":
        bg, words = t["band"]["strong"], "#ffffff"
    else:
        bg, words = t["band"]["soft"], t["text"]["primary"]
    if _contrast(bg, words) < 4.5:
        words = t["band"]["on"]
    return bg, words


def _whole(pic: Path) -> bool:
    """The picture is there and complete. themeForge's preview draws the theme's picture as soon as a colour is
    picked; an Apply a moment later found it half written ("OSError: image file is truncated", Javier,
    2026-10-27). Pictures are now written under a temporary name and renamed when done; this also catches a
    broken leftover, which is then drawn again."""
    if not pic.exists():
        return False
    try:
        from PIL import Image
        with Image.open(pic) as im:
            im.load()
        return True
    except Exception:
        return False


def _temp_for(out: Path) -> Path:
    """Where a picture is drawn before it gets its name: beside it, so the rename is atomic."""
    return out.with_name(f".{out.stem}.{os.getpid()}.{time.monotonic_ns()}{out.suffix}")


def kognogos_wallpaper(design: str, slug: str, t: dict, cache: Path, make: bool = True) -> Path:
    """Our own KognogOS background, its art lifted from the originals (scripts/make-kognogos-layers.py)
    and laid on the theme's colours."""
    if design not in KOGNOGOS_DESIGNS:
        raise LookError(f"no KognogOS background called {design} ({', '.join(KOGNOGOS_DESIGNS)})")
    art = [KOGNOGOS_ART / f"kognogos-{design}{part}" for part in ("-emblem.png", "-words.png", ".json")]
    out = cache / f"kognogos-{design}-{slug}-{_stamp(*art, Path(__file__))}.png"
    if not make or _whole(out):
        return out
    from PIL import Image
    meta = json.loads(art[2].read_text())
    bg, words = wallpaper_colours(slug, t)
    rgb = lambda h: tuple(int(h.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4))
    canvas = Image.new("RGBA", tuple(meta["canvas"]), rgb(bg) + (255,))
    w = Image.open(art[1])
    canvas.alpha_composite(Image.merge("RGBA", [Image.new("L", w.size, c) for c in rgb(words)] + [w.split()[3]]),
                           tuple(meta["words_at"]))
    canvas.alpha_composite(Image.open(art[0]), tuple(meta["emblem_at"]))
    cache.mkdir(parents=True, exist_ok=True)
    tmp = _temp_for(out)
    canvas.convert("RGB").save(tmp, format="PNG", optimize=True)
    os.replace(tmp, out)
    _prune_pictures(cache, out)
    return out


def topic_wallpaper(topic: str, slug: str, t: dict, cache: Path, make: bool = True) -> Path:
    """A drawn topic (circuit, mountains, sky and clouds, ribbons, shards, space…) in the theme's colours."""
    _, mode, cols = wall_job(slug, t)
    out = cache / f"{topic}-{slug}-{_stamp(WALLGEN)}.png"
    if not make or _whole(out):
        return out
    cache.mkdir(parents=True, exist_ok=True)
    tmp = _temp_for(out)
    r = subprocess.run(["python3", str(WALLGEN), "--colors", *[c.lstrip("#") for c in cols], "--mode", mode,
                        "--motif", topic, "--out", str(tmp), "--preview", "0"], capture_output=True, text=True)
    if r.returncode or not tmp.exists():
        tmp.unlink(missing_ok=True)
        raise LookError(f"the {topic} wallpaper for {slug} could not be made: {r.stderr.strip()[-200:]}")
    os.replace(tmp, out)
    _prune_pictures(cache, out)
    return out


def solid_wallpaper(slug: str, t: dict, cache: Path, make: bool = True) -> Path:
    """No picture: the theme's colour. Sway paints it itself; this small file is for the lock screen."""
    bg, _ = wallpaper_colours(slug, t)
    out = cache / f"solid-{bg.lstrip('#')}.png"
    if not make or _whole(out):
        return out
    from PIL import Image
    cache.mkdir(parents=True, exist_ok=True)
    tmp = _temp_for(out)
    Image.new("RGB", (640, 360), tuple(int(bg.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4))).save(tmp, format="PNG")
    os.replace(tmp, out)
    return out


def theme_wallpaper(slug: str, t: dict, cache: Path, make: bool = True, style: dict | None = None) -> Path:
    """The theme's own picture: the style's topic; a style without one keeps the colour theme's (D-78)."""
    topic = (style or {}).get("wallpaper", {}).get("topic", "")
    if topic == "kognogos":
        return kognogos_wallpaper("tier-aware", slug, t, cache, make)
    return topic_wallpaper(topic or wall_job(slug, t)[0], slug, t, cache, make)


def drawn_topics() -> list[tuple[str, str]]:
    """[(topic, about)] every style's drawn wallpaper topic (the generator's), KognogOS left out: it has its
    own choices. Javier, 2026-10-17: these can be picked on their own, on the Rice (topic:<name>)."""
    seen = {}
    for st in styles().values():
        w = st.get("wallpaper", {})
        if w.get("topic") and w["topic"] != "kognogos":
            seen.setdefault(w["topic"], str(w.get("about", w["topic"])))
    return sorted(seen.items(), key=lambda kv: kv[1])


def picture_for(choice: str, style_slug: str, theme_slug: str, cache: Path, make: bool = True) -> Path:
    t = themes()[theme_slug]
    if choice == "theme":
        return theme_wallpaper(theme_slug, t, cache, make, styles()[style_slug])
    if choice.startswith("kognogos:"):
        return kognogos_wallpaper(choice.split(":", 1)[1], theme_slug, t, cache, make)
    if choice.startswith("topic:"):
        topic = choice.split(":", 1)[1]
        if topic not in dict(drawn_topics()):
            raise LookError(f"there is no drawn wallpaper called {topic!r} (known: {', '.join(t for t, _ in drawn_topics())})")
        return topic_wallpaper(topic, theme_slug, t, cache, make)
    if choice == "solid":
        return solid_wallpaper(theme_slug, t, cache, make)
    pic = Path(choice).expanduser()
    if not pic.is_file():
        raise LookError(f"the wallpaper {pic} doesn't exist")
    return pic


def wallpaper_choice(choice: str | None) -> str | None:
    """A choice as the look keeps it: the named ones as they are, a file as its full path."""
    if choice is None or choice in ("theme", "solid") or choice.startswith(("kognogos:", "topic:")):
        return choice
    return str(Path(choice).expanduser().resolve())


def wallpaper_line(choice: str, pic: Path, fit: str, slug: str, t: dict) -> str:
    """Sway's line: every screen the same picture (Javier: "All screens get the same background"),
    laid the chosen way; the theme's colour shows around a picture that doesn't cover the screen."""
    bg, _ = wallpaper_colours(slug, t)
    if choice == "solid":
        return f"output * bg {bg} solid_color"
    return f'output * bg "{pic}" {fit} {bg}'


def lock_picture(src: Path, dest: Path):
    """gtklock can't blur live: a blurred, 20 % darker copy (how assets/lock/ was made)."""
    from PIL import Image, ImageEnhance, ImageFilter
    im = Image.open(src).convert("RGB")
    im.thumbnail((2560, 1440))
    im = ImageEnhance.Brightness(im.filter(ImageFilter.GaussianBlur(18))).enhance(0.8)
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(".tmp.jpg")
    im.save(tmp, quality=88)
    tmp.replace(dest)


# ── state, backups ──────────────────────────────────────────────────────────────────────────
class Place:
    def __init__(self, root: Path | None = None):
        self.root = root or Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser()
        self.dir = self.root / "hypeforge/theme"
        self.state = self.dir / "state.toml"
        self.backups = self.dir / "backups"
        cache = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser()
        self.cache = (self.root / ".cache-wallpapers") if root else cache / "hypeforge/wallpapers"
        data = Path(os.environ.get("XDG_DATA_HOME", "~/.local/share")).expanduser()
        self.gtk_themes = (self.root / ".gtk-themes") if root else data / "themes"
        self.note_icons = (self.root / ".notification-icons") if root else data / "hypeforge/notification-icons"

    def read_state(self) -> dict:
        try:
            return tomllib.loads(self.state.read_text())
        except (OSError, tomllib.TOMLDecodeError):
            return {}

    def write_state(self, st: dict):
        self.dir.mkdir(parents=True, exist_ok=True)
        q = lambda v: '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'
        body = "# hypeforge-theme's memory: what is applied. Change it with hypeforge-theme, not by hand.\n"
        body += "".join(f"{k} = {q(v)}\n" for k, v in st.items())
        self.state.write_text(body)


def backup(place: Place, targets: list[Path]) -> Path | None:
    have = [t for t in targets if t.exists()]
    # always a record, even when nothing existed yet: undo then removes what the apply created
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    dest = place.backups / stamp
    for t in have + ([place.state] if place.state.exists() else []):
        rel = t.relative_to(place.root)
        (dest / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(t, dest / rel)
    dest.mkdir(parents=True, exist_ok=True)
    (dest / ".targets").write_text("\n".join(str(t.relative_to(place.root)) for t in targets))
    old = sorted(p for p in place.backups.iterdir() if p.is_dir())
    for p in old[:-KEEP_BACKUPS]:
        shutil.rmtree(p)
    return dest


# ── the look file (Javier, 2026-10-11) ──────────────────────────────────────────────────────
# "have already a config file for theme, and with the config file themeForge call to change it based
# on the selections … for the different elements: bar, launcher, workspaces, icons, date/time
# variant, tray, tray icons, popups, colors". One file holds the picks; themeForge writes it and runs
# `hypeforge-theme look`; every apply writes it too, so it always says what is on screen. Each
# element is "theme" (the theme's own, described in its style.toml [elements]) until the pages that
# pick them one by one exist.
LOOK = "hypeforge/look.toml"
ELEMENTS = ["bar", "launcher", "workspaces", "taskbar", "datetime", "tray", "status_icons", "popups",
            "dock", "windows", "icons", "fonts"]


WALL_FOLDER = "~/Pictures/Wallpapers"     # where "my pictures" are looked for, until the person picks another


def read_look(place: "Place") -> dict:
    try:
        d = tomllib.loads((place.root / LOOK).read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    el = d.get("elements", {})
    wp = d.get("wallpaper", {})
    return {"theme": d.get("theme"), "colors": d.get("colors"),
            "elements": {k: str(el.get(k, "theme")) for k in ELEMENTS},
            # a look file from before the Wallpaper page has none: None keeps what is on screen
            "wallpaper": {"picture": wp.get("picture"), "fit": wp.get("fit"),
                          "folder": str(wp.get("folder", WALL_FOLDER))}}


def look_text(style: str, theme: str, elements: dict | None = None, wallpaper: dict | None = None) -> str:
    q = lambda v: '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'
    el = {k: (elements or {}).get(k, "theme") for k in ELEMENTS}
    wp = {"picture": "theme", "fit": "fill", "folder": WALL_FOLDER, **(wallpaper or {})}
    return ("# hypeForge's look: what themeForge picked. themeForge writes it and runs `hypeforge-theme look`;\n"
            "# every apply writes it too, so it always says what is on screen.\n"
            "# theme = a style (styles/<slug>/style.toml) · colors = a colour theme (themes/colours/palettes.toml)\n"
            f"theme = {q(style)}\ncolors = {q(theme)}\n\n"
            "# Each element of the look: \"theme\" = the theme's own (its style.toml [elements] says what that is).\n"
            "# Picking one element from another theme comes with themeForge's next pages.\n"
            "[elements]\n" + "".join(f"{k} = {q(v)}\n" for k, v in el.items()) +
            "\n# The wallpaper, the same on every screen: picture = \"theme\" (the theme's own), \"kognogos:tier-aware\"\n"
            "# or \"kognogos:arch-distro\" (KognogOS, in the theme's colours), \"topic:mountains\" (a drawn one), \"solid\" (the theme's colour), or a\n"
            "# file; fit = fill · fit · stretch · center · tile; folder = where your pictures are.\n"
            "[wallpaper]\n" + "".join(f"{k} = {q(wp[k])}\n" for k in ("picture", "fit", "folder")))


# ── apply ───────────────────────────────────────────────────────────────────────────────────
# ── the look's GTK theme (F-70, Javier 2026-10-11: "Google Chrome that is already opened, when I
# switch theme colors, the window stays with the same color when I opened it") ──────────────────
# Open GTK apps (Chrome with its GTK look among them) reload their colours only when the GTK theme's
# NAME changes, and never re-read ~/.config/gtk-3.0/gtk.css, which also outranks any theme. So the
# colours go into a small theme of their own, built on the palette's GTK theme (adw-gtk3), named
# after the style, the colours and a fingerprint of the content: a new look is a new name, and every
# open GTK app repaints. Named themes are kept (an undo names an older one); the oldest are pruned.
GTK_KEEP = 20


def gtk_theme_name(style_slug: str, theme_slug: str, css: str) -> str:
    import hashlib
    return f"hypeForge-{style_slug}-{theme_slug}-{hashlib.sha1(css.encode()).hexdigest()[:6]}"


def gtk_base_dir(name: str) -> Path | None:
    for d in ("~/.local/share/themes", "~/.themes", "/usr/share/themes"):
        p = Path(d).expanduser() / name
        if p.is_dir():
            return p
    return None


def gtk_theme_files(place: "Place", name: str, base: str, css: str) -> dict:
    """The named theme's files: the base theme's own stylesheet first, then the look's colours."""
    out = {place.gtk_themes / name / "index.theme":
           f"[Desktop Entry]\nType=X-GNOME-Metatheme\nName={name}\n"
           f"Comment=Written by hypeforge-theme: {base} with the look's colours\n\n[X-GNOME-Metatheme]\nGtkTheme={name}\n"}
    root = gtk_base_dir(base)
    for ver in ("gtk-3.0", "gtk-4.0"):
        head = ""
        if root is not None and (root / ver / "gtk.css").is_file():
            head = f'@import url("file://{root / ver / "gtk.css"}");\n\n'
        out[place.gtk_themes / name / ver / "gtk.css"] = head + css
    return out


def write_gtk_theme(place: "Place", name: str, files: dict):
    for p, body in files.items():
        if not p.exists() or p.read_text() != body:
            p.parent.mkdir(parents=True, exist_ok=True)
            tmp = p.with_name(p.name + ".hftmp")
            tmp.write_text(body)
            tmp.replace(p)
    keep = {name, live_gtk_theme(place.root)}          # never the one on screen now
    ours = sorted((d for d in place.gtk_themes.glob("hypeForge-*") if d.is_dir() and d.name not in keep),
                  key=lambda d: d.stat().st_mtime)
    for d in ours[:-GTK_KEEP] if len(ours) > GTK_KEEP else []:
        shutil.rmtree(d, ignore_errors=True)


def live_gtk_theme(config: Path) -> str | None:
    """The GTK theme the look's settings file names (an undo puts back an older one)."""
    try:
        for line in (config / "gtk-3.0/settings.ini").read_text().splitlines():
            if line.startswith("gtk-theme-name="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return None


def render(style_slug: str, theme_slug: str, place: Place, wallpaper: str | None = None,
           check_names: bool = True, make_wallpaper: bool = True, corners: str | None = None,
           fit: str | None = None) -> tuple[dict, str]:
    sts, ths = styles(), themes()
    if style_slug not in sts:
        raise LookError(f"no style called {style_slug} (hypeforge-theme list shows them)")
    if theme_slug not in ths:
        raise LookError(f"no theme called {theme_slug} (hypeforge-theme list shows them)")
    style, theme = sts[style_slug], ths[theme_slug]
    st = place.read_state()
    style = with_corners(style, corners or st.get("corners", "style"))
    mode = wallpaper or st.get("wallpaper", "theme")
    fit = fit or st.get("fit", "fill")
    if fit not in FITS:
        raise LookError(f"a wallpaper lies {', '.join(FITS)} — not {fit}")
    pic = picture_for(mode, style_slug, theme_slug, place.cache, make=make_wallpaper)
    ctx = {"style": style, "theme": theme, "names": names_for(theme, check_names), "wallpaper": str(pic),
           "wallpaper_line": wallpaper_line(mode, pic, fit, theme_slug, theme), "note_icons": str(place.note_icons),
           "meta": {"style": style["meta"]["name"], "theme": theme["meta"]["name"],
                    "when": dt.datetime.now().strftime("%Y-%m-%d %H:%M")}}
    css = fill((TEMPLATES / "gtk.css.tmpl").read_text(), ctx)
    ctx["names"]["gtk_theme_base"] = ctx["names"]["gtk_theme"]
    ctx["names"]["gtk_theme"] = gtk_theme_name(style_slug, theme_slug, css)
    files = {}
    for tmpl, rel in OUTPUTS:
        files[place.root / rel] = fill((TEMPLATES / tmpl).read_text(), ctx)
    term = terminal_files(place, st, fill((TEMPLATES / TERMINAL[0]).read_text(), ctx))
    files.update(term)
    for rel, body in bar_files(style).items():
        files[place.root / rel] = body
    files[place.root / LOOK] = look_text(style_slug, theme_slug, read_look(place).get("elements"),
                                         {"picture": mode, "fit": fit,
                                          "folder": read_look(place).get("wallpaper", {}).get("folder", WALL_FOLDER)})
    RENDERED_GTK.clear()
    RENDERED_GTK.update(name=ctx["names"]["gtk_theme"],
                        files=gtk_theme_files(place, ctx["names"]["gtk_theme"], ctx["names"]["gtk_theme_base"], css))
    return files, str(pic)


RENDERED_GTK: dict = {}   # the named GTK theme of the last render (its files sit outside the config folder)


CORNERS = ("style", "straight", "rounded")   # Javier, 2026-10-10: "for all themes, we need an option
                                             # to switch between rounded and straight corners"
ROUNDED = {"radius_window": 12, "radius_popup": 10, "radius_island": 12, "radius_area": 8, "radius_control": 6}


def with_corners(style: dict, choice: str) -> dict:
    """The style with the person's corners: "style" keeps the style's own; "straight" makes every
    corner square (windows, the bar's areas, pills, pop-ups, lists, notifications, the FX login);
    "rounded" rounds the ones a style left square (its pills and bar keep their own shape)."""
    if choice not in CORNERS:
        raise LookError(f"corners are {', '.join(CORNERS)} — not {choice}")
    if choice == "style":
        return style
    out = {k: (dict(v) if isinstance(v, dict) else v) for k, v in style.items()}
    shape = dict(out.get("shape", {}))
    fx = dict(out.get("fx", {}))
    for k in list(shape) + [k for k in ROUNDED if k not in shape]:
        if not k.startswith("radius_"):
            continue
        v = shape.get(k, 0)
        if choice == "straight":
            shape[k] = {kk: 0 for kk in v} if isinstance(v, dict) else 0
        elif not isinstance(v, dict) and not v and k in ROUNDED:
            shape[k] = ROUNDED[k]
    if choice == "straight":
        fx["corner_radius"] = 0
    elif not fx.get("corner_radius"):
        fx["corner_radius"] = ROUNDED["radius_window"]
    out["shape"], out["fx"] = shape, fx
    out["corners"] = choice
    return out


BAR_LIVE = "sway/waybar"   # under the config folder: where Waybar reads config.jsonc and style.css
# A new bar LAYOUT means a fresh start, not a reload: Waybar 0.15 reloaded in place into another
# layout keeps running but shows nothing (F-58, 2026-10-10, reproduced by scripts/switch-bench.py)
BAR_RESTART = True


def ensure_imports(place: "Place"):
    """Every file the bar's stylesheet @imports must exist before the bar reloads: Waybar quits
    on a missing import (F-58, 2026-10-10: switching to Windows 11, the bar reloaded before the
    Taskbar applet had written taskbar.css for the first time, and went away). A missing one is
    created empty; the applet fills it moments later and reloads the bar itself."""
    css = place.root / BAR_LIVE / "style.css"
    if not css.is_file():
        return
    for rel in re.findall(r'@import\s+url\("([^"]+)"\)', css.read_text()):
        target = (css.parent / rel).resolve() if not rel.startswith(("/", "file:")) else Path(rel.replace("file://", ""))
        if not target.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text("/* placeholder: its applet writes this file when it starts (F-58) */\n")


def bar_files(style: dict) -> dict:
    """The bar follows the style (look step 5): each style's layout (config.jsonc) and shapes
    (style.css), plus the module definitions every style shares (modules.jsonc: network, volume,
    clipboard, USB drives, printers, the bell, the tray, power, clock…). hypeForge Classic's bar is
    the hand-made one in sway/waybar/; another style's is styles/<slug>/bar/. A style without a bar
    folder leaves the bar as it is. Colours stay in colors.css, which every bar stylesheet imports."""
    slug = style["meta"]["slug"]
    src = REPO / "sway/waybar" if slug == "classic" else STYLES / slug / "bar"
    out = {}
    if (src / "config.jsonc").is_file() and (src / "style.css").is_file():
        out[f"{BAR_LIVE}/config.jsonc"] = (src / "config.jsonc").read_text()
        css = (src / "style.css").read_text()
        if style.get("corners") == "straight":   # every corner of the bar square: areas, pills, hovers
            css = re.sub(r"border-radius:\s*[^;]+;", "border-radius: 0;", css)
            css = "/* corners: straight (hypeforge-theme corners) */\n" + css
        out[f"{BAR_LIVE}/style.css"] = css
    shared = REPO / "sway/waybar/modules.jsonc"
    if out and shared.is_file():
        out[f"{BAR_LIVE}/modules.jsonc"] = shared.read_text()
    return out


IMPORT_RE = re.compile(r"(^\s*import\s*=\s*\[)(.*?)(\])", re.S | re.M)


def terminal_files(place: "Place", st: dict, body: str) -> dict:
    """The terminal's theme file and, when needed, Alacritty's settings with it first in the
    import list. Nothing when the person keeps their own terminal theme, or has no Alacritty."""
    cfg = place.root / ALACRITTY
    if st.get("terminal", "theme") != "theme" or not cfg.exists():
        return {}
    ours = place.root / TERMINAL[1]
    home = str(Path.home())
    name = "~" + str(ours)[len(home):] if str(ours).startswith(home + "/") else str(ours)
    text = cfg.read_text()
    m = IMPORT_RE.search(text)
    entries = re.findall(r'"([^"]+)"', m.group(2)) if m else []
    if entries and st.get("terminal_wired") and Path(entries[0]).expanduser() != ours:
        return {}                     # the person picked another theme in alacrittyForge: theirs wins
    out = {ours: body}
    if not entries or Path(entries[0]).expanduser() != ours:
        others = [e for e in entries if Path(e).expanduser() != ours]
        # alacrittyForge's rule: the theme is the first import; the old theme file steps aside
        others = [e for e in others if "/alacritty/themes/" not in e]
        block = "import = [\n" + "".join(f'    "{e}",\n' for e in [name] + others) + "]"
        if m:
            text = text[:m.start()] + block + text[m.end():]
        elif "[general]" in text:
            text = text.replace("[general]", "[general]\n" + block, 1)
        else:
            text = "[general]\n" + block + "\n\n" + text
        out[cfg] = text
    return out


def apply(style_slug: str, theme_slug: str, place: Place, *, wallpaper: str | None = None, dry: bool = False,
          reload: bool = True, check_names: bool = True, make_wallpaper: bool = True, say=print,
          corners: str | None = None, fit: str | None = None) -> dict:
    st = place.read_state()
    # a new style or new colours bring the theme's own wallpaper, drawn in the new colours (Javier, 2026-10-27,
    # D-121: "When you switch themes, the wallpaper should change to the theme default… Then people can switch
    # the wallpaper to the one of their preference"). A wallpaper picked in the same step still wins; the one
    # already on screen, carried along by themeForge's look file, doesn't.
    if st and (style_slug, theme_slug) != (st.get("style"), st.get("theme")) and wallpaper in (None, st.get("wallpaper")):
        wallpaper = "theme"
        fit = fit if fit not in (None, st.get("fit")) else "fill"
    files, pic = render(style_slug, theme_slug, place, wallpaper, check_names, make_wallpaper, corners, fit)
    lock = place.root / "gtklock/background.jpg"
    new_pic = pic != st.get("picture")
    changed = [p for p, body in files.items() if not p.exists() or p.read_text() != body]
    if dry:
        for p in changed:
            say(f"  would write {p}")
        if new_pic:
            say(f"  would set the wallpaper {pic} and the lock screen's copy")
        return {"changed": changed, "picture": pic, "backup": None}
    targets = list(files) + ([lock] if new_pic else [])
    gtk = dict(RENDERED_GTK)
    saved = backup(place, targets)
    if gtk:
        write_gtk_theme(place, gtk["name"], gtk["files"])   # before settings.ini names it
    note_icon_map(place.note_icons, names_for(themes()[theme_slug], False)["icons"])   # before mako reads its icon-path
    for p, body in files.items():                       # every file first, then reload: never half
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_name(p.name + ".hftmp")
        tmp.write_text(body)
        tmp.replace(p)
    if new_pic and Path(pic).exists():
        lock_picture(Path(pic), lock)
    ensure_imports(place)
    term_on = (place.root / TERMINAL[1]) in files
    new_state = {"style": style_slug, "theme": theme_slug, "wallpaper": wallpaper or st.get("wallpaper", "theme"),
                 "fit": fit or st.get("fit", "fill"), "picture": pic, "corners": corners or st.get("corners", "style"),
                 "terminal": st.get("terminal", "theme") if term_on or not st.get("terminal_wired") else "own",
                 "applied": dt.datetime.now().isoformat(timespec="seconds")}
    if term_on or st.get("terminal_wired"):
        new_state["terminal_wired"] = "yes"
    place.write_state(new_state)
    if reload:
        layout = [p for p in changed if p.parent == place.root / BAR_LIVE and p.name in ("config.jsonc", "style.css")]
        reload_all(files_theme(theme_slug), say, restart_bar=place.root / BAR_LIVE if layout and BAR_RESTART else None,
                   style=styles()[style_slug])
    return {"changed": changed, "picture": pic, "backup": saved}


def files_theme(theme_slug: str) -> dict:
    return themes()[theme_slug]


def live_gaps(config: Path, sway_config: str | None = None) -> list[str]:
    """The gaps the running Sway reads, as commands for every open workspace: the look's own files
    in the order Sway includes them (the SwayFX login adds fx.conf after sway.conf; the last wins)."""
    if sway_config is None:
        try:
            out = subprocess.run(["swaymsg", "-t", "get_config", "-r"], capture_output=True, text=True, timeout=5)
            sway_config = json.loads(out.stdout)["config"]
        except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
            return []
    vals: dict[str, int] = {}
    for line in sway_config.splitlines():
        words = line.split(None, 1)
        if len(words) != 2 or words[0] != "include" or "hypeforge/theme/" not in words[1]:
            continue
        f = config / "hypeforge/theme" / words[1].rsplit("hypeforge/theme/", 1)[1].strip()
        try:
            text = f.read_text()
        except OSError:
            continue
        for g in text.splitlines():
            parts = g.split()
            if len(parts) == 3 and parts[0] == "gaps" and parts[1] in ("inner", "outer") and parts[2].isdigit():
                vals[parts[1]] = int(parts[2])
    return [f"gaps {k} all set {v}" for k, v in sorted(vals.items())]


def reload_all(theme: dict, say=print, restart_bar: Path | None = None, style: dict | None = None):
    """Tell what is running to read the new files. Each step is skipped quietly when its program
    isn't there; nothing is stopped or started here (processes are signalled by exact name only)."""
    def run(*cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=15).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return False
    if style is not None:
        stop_other_applets(style_applets(style), say)
    if os.environ.get("SWAYSOCK") and run("swaymsg", "reload"):
        say("  Sway reloaded (windows, gaps, pointer, wallpaper)")
        # Sway's gaps lines only reach workspaces made after a reload; open ones keep theirs (10-11)
        gaps = live_gaps(Place().root)
        if gaps and run("swaymsg", ", ".join(gaps)):
            say("  the gaps set on every open workspace")
    if restart_bar is not None:
        # a new layout: stop the bar through its own tool first, so the bar guard (D-115) knows it's on purpose,
        # then any stray one by its exact name, and start it the way login does (F-58)
        tool = REPO / "applets/bar/hypeforge-bar"
        if tool.is_file():
            run(str(tool), "stop")
        run("pkill", "-x", "waybar")
        for _ in range(30):
            if not run("pgrep", "-x", "waybar"):
                break
            time.sleep(0.1)
        # a bar per screen, each told its screen (hypeforge-bar, 10-10), the way login starts it
        tool = REPO / "applets/bar/hypeforge-bar"
        cmd = (f"{tool} start" if tool.is_file()
               else f"waybar -c {restart_bar / 'config.jsonc'} -s {restart_bar / 'style.css'}")
        if os.environ.get("SWAYSOCK") and run("swaymsg", "exec", cmd):
            say("  the bar restarted with its new layout")
    else:
        wait_for_sound()        # a reload while sound is starting takes the bar down (F-86)
    if restart_bar is None and run("pkill", "-USR2", "-x", "waybar"):
        # a restyle in place can take the bar down with no word (Javier, 2026-10-17 21:41: "there is not top
        # bar"); it is checked, and started again the way login does
        time.sleep(2.0)
        tool = REPO / "applets/bar/hypeforge-bar"
        if not run("pgrep", "-x", "waybar") and os.environ.get("SWAYSOCK") and tool.is_file():
            watch = REPO / "applets/common/hypeforge-watch"
            run("swaymsg", "exec", f"{watch} bar {tool} start")
            say("  the bar went away while restyling: started again")
        else:
            say("  the bar restyled")
    if run("makoctl", "reload"):
        say("  notifications restyled")
    n = names_for(theme, check=False)
    gs = [("gtk-theme", live_gtk_theme(Place().root) or n["gtk_theme"]), ("icon-theme", n["icons"]), ("cursor-theme", n["cursor"]),
          ("cursor-size", str(n["cursor_size"])), ("color-scheme", n["color_scheme"]), ("accent-color", n["gnome_accent"])]
    if shutil.which("gsettings"):
        ok = all(run("gsettings", "set", "org.gnome.desktop.interface", k, v) for k, v in gs)
        say("  GTK apps told (open ones repaint; one opened before 2026-10-11 needs a restart once)" if ok else "  GTK settings: some keys refused (older GTK?)")


def undo(place: Place, reload: bool = True, say=print) -> Path:
    if not place.backups.is_dir():
        raise LookError("nothing to undo yet")
    last = sorted(p for p in place.backups.iterdir() if p.is_dir())
    if not last:
        raise LookError("nothing to undo yet")
    b = last[-1]
    if not (b / "hypeforge/theme/state.toml").exists():
        # the first look ever: going "back" would remove the files Sway, the bar and the lists now include
        raise LookError("this is the first look applied here; there is no earlier look to go back to "
                        "(apply another style or theme instead)")
    targets = (b / ".targets").read_text().split("\n") if (b / ".targets").exists() else []
    for rel in targets:
        src, dest = b / rel, place.root / rel
        if src.exists():
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
        elif dest.exists():
            dest.unlink()                               # it didn't exist before that apply
    st = b / "hypeforge/theme/state.toml"
    if st.exists():
        shutil.copy2(st, place.state)
    elif place.state.exists():
        place.state.unlink()
    shutil.rmtree(b)
    # the look file says what is on screen again (themeForge wrote the undone pick into it before the
    # apply's backup was made, so the backup's copy can be the new pick, not the old one)
    cur = place.read_state()
    if cur.get("style") and cur.get("theme"):
        (place.root / LOOK).parent.mkdir(parents=True, exist_ok=True)
        (place.root / LOOK).write_text(look_text(cur["style"], cur["theme"], read_look(place).get("elements")))
    if reload:
        cur = place.read_state()
        if cur.get("theme") in themes():
            # the same ending as an apply (F-67, 2026-10-11): undo used to only tell the running bar to
            # reload — it kept the old per-screen layout with the new stylesheet (Javier: "a disaster")
            reload_all(themes()[cur["theme"]], say, restart_bar=place.root / BAR_LIVE,
                       style=styles().get(cur.get("style")))
    return b


# ── the command ─────────────────────────────────────────────────────────────────────────────
def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="hypeforge-theme", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    sub.add_parser("current")
    a = sub.add_parser("apply")
    a.add_argument("style"); a.add_argument("theme")
    a.add_argument("--dry-run", action="store_true"); a.add_argument("--no-reload", action="store_true")
    a.add_argument("--wallpaper", help='"theme", "kognogos:tier-aware|arch-distro", "topic:<topic>", "solid" or a picture file of yours')
    a.add_argument("--fit", choices=FITS, help="how the picture lies on each screen (fill crops the edges)")
    a.add_argument("--corners", choices=CORNERS, help="straight, rounded, or the style's own (style)")
    w = sub.add_parser("wallpaper"); w.add_argument("choice", help='"theme", "kognogos:<design>", "topic:<topic>", "solid" or a picture file')
    w.add_argument("--fit", choices=FITS)
    pc = sub.add_parser("picture"); pc.add_argument("style"); pc.add_argument("theme")
    pc.add_argument("choice", nargs="?", default="theme")
    c = sub.add_parser("corners"); c.add_argument("choice", choices=CORNERS,
                                                  help="straight (every corner square), rounded, or style (each style's own)")
    u = sub.add_parser("undo"); u.add_argument("--no-reload", action="store_true")
    lk = sub.add_parser("look"); lk.add_argument("--no-reload", action="store_true")
    for p in (a, w, u, c, lk, pc):
        p.add_argument("--root", type=Path, help="write under this folder instead of ~/.config (the bench)")
    args = ap.parse_args(argv)
    place = Place(getattr(args, "root", None))
    try:
        if args.cmd == "list":
            print("Styles:"); [print(f"  {k:<12} {v['meta']['name']}") for k, v in styles().items()]
            print("Themes:"); [print(f"  {k:<18} {v['meta']['name']}") for k, v in themes().items()]
        elif args.cmd == "current":
            st = place.read_state()
            print(f"style {st.get('style', '—')} · theme {st.get('theme', '—')} · corners {st.get('corners', 'style')} · "
                  f"wallpaper {st.get('wallpaper', 'theme')} · fit {st.get('fit', 'fill')}" if st else "nothing applied yet")
        elif args.cmd == "apply":
            print(f"\n  The look: {args.style} · {args.theme}\n")
            r = apply(args.style, args.theme, place, wallpaper=wallpaper_choice(args.wallpaper), dry=args.dry_run,
                      reload=not args.no_reload, corners=args.corners, fit=args.fit)
            if not args.dry_run:
                print(f"  {len(r['changed'])} file(s) changed; the old ones are kept (hypeforge-theme undo)\n")
        elif args.cmd == "wallpaper":
            st = place.read_state()
            if not st:
                raise LookError("apply a style and theme first")
            choice = wallpaper_choice(args.choice)
            apply(st["style"], st["theme"], place, wallpaper=choice, reload=True, fit=args.fit)
            print("  wallpaper:", choice, "·", args.fit or st.get("fit", "fill"))
        elif args.cmd == "picture":
            if args.style not in styles() or args.theme not in themes():
                raise LookError("hypeforge-theme list shows the styles and themes")
            print(picture_for(wallpaper_choice(args.choice), args.style, args.theme, place.cache))
        elif args.cmd == "corners":
            st = place.read_state()
            if not st:
                raise LookError("apply a style and theme first")
            apply(st["style"], st["theme"], place, corners=args.choice, reload=True)
            print("  corners:", args.choice)
        elif args.cmd == "look":
            want = read_look(place)
            if not (want.get("theme") and want.get("colors")):
                raise LookError(f"the look file (~/.config/{LOOK}) has no theme and colors to apply")
            print(f"\n  The look file: {want['theme']} · {want['colors']}\n")
            wp = want.get("wallpaper", {})
            r = apply(want["theme"], want["colors"], place, reload=not args.no_reload,
                      wallpaper=wallpaper_choice(wp.get("picture")), fit=wp.get("fit"))
            print(f"  {len(r['changed'])} file(s) changed; the old ones are kept (hypeforge-theme undo)\n")
        elif args.cmd == "undo":
            undo(place, reload=not args.no_reload)
            print("  the look from before the last apply is back")
    except LookError as e:
        print(f"\n  Not done: {e}\n", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
