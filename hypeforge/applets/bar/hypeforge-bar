#!/usr/bin/env python3
"""hypeForge applet · the bar on every screen — each screen's bar tells its clicks which screen it is.

Javier, 2026-10-10: "the launcher and all the bar popups don't open in the screen you are in,
clicking from, they open in the left screen only." Waybar hands the screen's name only to the
commands that DRAW a module, never to the command a click runs (Waybar 0.15, AModule.cpp:
forkExec(format) without the output); with focus on a click only (D-82) the focused screen is not
the clicked one.

So the bar's config is written out once per screen, in ONE Waybar: a bar per screen ("output"
set), and in each bar every click command starts with `HYPEFORGE_OUTPUT=<screen>; export …` — the
panels and lists read it and open there. Only the click keys are overridden; everything else still
comes from the included files, so the applets' own rewrites keep working (Waybar merges includes
key by key, a bar's own keys win: config.cpp mergeConfig).

First built as one Waybar PROCESS per screen: Waybar registers as one app per session
(fr.arouillard.waybar, APPLICATION_HANDLES_COMMAND_LINE), and on an in-place reload the extra
copies crashed (GLib: g_application_impl_command_line assertion) — two of three on the bench.

The bar guard (D-115, built 2026-10-22): Waybar crashes now and then (15 times 10-10…10-22), and on
10-22 it died three seconds after login and left an empty screen until a look re-apply happened to
start it again. `guard` runs beside it from login: when the saved bar is gone without a `stop`, it
keeps the dead bar's log (in ~/.local/state/hypeforge/logs/bar-crashes/, which outlives a reboot),
starts the bar again and says so in a notice. Five deaths within five minutes and it gives up, with a
notice that stays, so a broken bar can't flash forever. A `stop` (or a style switch, which stops it
through this tool) clears the saved number first, so the guard never takes a stop for a crash.

    hypeforge-bar start      the bar on every screen (stops this tool's earlier one first)
    hypeforge-bar stop       stop it (by its saved process number only)
    hypeforge-bar restart    the same as start
    hypeforge-bar guard      bring the bar back whenever it dies (one guard per session; ends with Sway)

Writes $XDG_RUNTIME_DIR/hypeforge-bar/config.json from ~/.config/sway/waybar/config.jsonc; the bar's
log is waybar.log beside it, the run before that one in waybar.log.prev.
"""

from __future__ import annotations

import fcntl
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from collections import deque
from contextlib import contextmanager
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "common"))
from hfsway import Sway  # noqa: E402

GET_OUTPUTS = 3
REPO = Path(os.path.realpath(__file__)).parent.parent.parent      # hypeforge/
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "sway/waybar"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypeforge-bar"
PIDS = RUN / "pids.json"
PLACES = PIDS.parent / "hypeforge-popup-places.json"   # read by hypeforge-clipboard list (Win + C)
LOCK = RUN / "bar.lock"                                  # start, stop and the guard, one at a time
CRASHES = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "hypeforge/logs/bar-crashes"
KEEP = 20                                                # crash records kept, newest first
GUARD_EVERY = float(os.environ.get("HYPEFORGE_BAR_GUARD_EVERY", "2"))      # seconds between looks
GUARD_MAX = int(os.environ.get("HYPEFORGE_BAR_GUARD_MAX", "5"))            # restarts allowed …
GUARD_WINDOW = float(os.environ.get("HYPEFORGE_BAR_GUARD_WINDOW", "300"))  # … within this many seconds


def strip_comments(text: str) -> str:
    """JSON with // comments (Waybar's .jsonc) → plain JSON; "//" inside strings is kept."""
    out, i, quoted = [], 0, False
    while i < len(text):
        ch = text[i]
        if quoted:
            out.append(ch)
            if ch == "\\":
                out.append(text[i + 1])
                i += 1
            elif ch == '"':
                quoted = False
        elif ch == '"':
            quoted = True
            out.append(ch)
        elif text.startswith("//", i):
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(ch)
        i += 1
    return "".join(out)


CLICKS = ("on-click", "on-click-right", "on-click-middle")


def expand(path: str) -> Path:
    """An include path the way Waybar reads it: ${XDG_CONFIG_HOME:-$HOME/.config}, $HOME, ~."""
    conf = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    path = path.replace("${XDG_CONFIG_HOME:-$HOME/.config}", conf).replace("$HOME", str(Path.home()))
    return Path(os.path.expanduser(path))


def load_jsonc(path: Path) -> dict:
    try:
        return json.loads(strip_comments(path.read_text()))
    except (OSError, ValueError):
        return {}


def merged(bar: dict) -> dict:
    """The bar with its includes merged in, Waybar's way (its own keys win, objects key by key)."""
    def merge(a, b):
        for k, v in b.items():
            if isinstance(a.get(k), dict) and isinstance(v, dict):
                merge(a[k], v)
            elif k not in a:
                a[k] = v
    out = json.loads(json.dumps(bar))
    for inc in bar.get("include", []):
        merge(out, load_jsonc(expand(inc)))
    return out


def placed(bar: dict) -> list[str]:
    """Every module the bar shows, groups opened up."""
    seen, todo = [], [m for k in ("modules-left", "modules-center", "modules-right") for m in bar.get(k, [])]
    while todo:
        m = todo.pop(0)
        if m in seen:
            continue
        seen.append(m)
        if m.startswith("group/"):
            todo += bar.get(m, {}).get("modules", [])
    return seen


def tagged(command: str, output: str) -> str:
    """The click command, told its screen (a plain assignment: works for any shell command)."""
    return f"HYPEFORGE_OUTPUT={output}; export HYPEFORGE_OUTPUT; {command}"


GAP = 8                        # a pop-up sits this far from the bar, and from the screen's side


def popup_places(bar: dict) -> dict[str, str]:
    """Where a pop-up opens, worked out from the bar it opens from (D-96: one pop-up per job on every
    style; the shared pieces say `{popup}` or `{popup-calendar}` and each bar fills in its own numbers):
    the bar's edge (top or bottom), the bar's height plus its margin plus a gap away from it, and
    either the screen's right-hand side ({popup}) or, for the calendar, the centre when the date sits
    in the bar's centre ({popup-calendar})."""
    edge = "bottom" if bar.get("position") == "bottom" else "top"
    away = int(bar.get("height", 32)) + int(bar.get(f"margin-{edge}", 0)) + GAP
    side = max(int(bar.get("margin-right", 0)), GAP)
    corner = f"--edges {edge},right --margin {edge}={away},right={side}"
    centred = "group/datetime" in bar.get("modules-center", []) or "clock" in bar.get("modules-center", [])
    return {"{popup}": corner, "{popup-calendar}": f"--edges {edge} --margin {edge}={away}" if centred else corner}


def placed_command(command: str, places: dict[str, str]) -> str:
    for token, words in places.items():
        command = command.replace(token, words)
    return command


ONLY = "hypeforge-screens"     # a bar's own key: "main" puts it on the main screen only (COSMIC's dock)


def main_screen(outputs: list[dict]) -> str | None:
    """The main screen: the middle one of the row, left to right (the left of the two middle ones
    when the count is even). On this desk DP-2 · DP-3 · DP-1, so DP-3, the one Javier calls Main."""
    row = sorted(outputs, key=lambda o: (o.get("rect", {}).get("x", 0), o.get("rect", {}).get("y", 0)))
    return row[(len(row) - 1) // 2]["name"] if row else None


def tray_size() -> int | None:
    """The tray apps' picture size for the style in use (its style.toml [bar] tray_size; Javier, 2026-10-17:
    on the other styles the 20 px pictures beside their 13-16 px icons "look terrible"). None: as defined."""
    import tomllib
    base = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    try:
        style = tomllib.loads((base / "hypeforge/theme/state.toml").read_text()).get("style", "classic")
        bar = tomllib.loads((REPO / "styles" / style / "style.toml").read_text()).get("bar", {})
        return int(bar["tray_size"]) if "tray_size" in bar else None
    except (OSError, ValueError, KeyError, tomllib.TOMLDecodeError):
        return None


OWN_TRAY = "group/tray"          # hypeForge's tray in place of Waybar's (modules.jsonc, 2026-10-17)


def own_tray(node):
    """Every "tray" a style places becomes hypeForge's own tray group, in any module list, nested ones too
    (Windows 11's hidden-icons drawer). Waybar's tray opened its menus at the pointer, over the bar."""
    if isinstance(node, dict):
        return {k: ([OWN_TRAY if m == "tray" else m for m in v] if k in ("modules-left", "modules-center",
                    "modules-right", "modules") and isinstance(v, list) else own_tray(v)) for k, v in node.items()}
    if isinstance(node, list):
        return [own_tray(n) for n in node]
    return node


def bars_for(text: str, outputs: list[str], main: str | None = None) -> list[dict]:
    """One bar per screen, in one Waybar: "output" set, and each module's click commands tagged.
    A bar that says "hypeforge-screens": "main" goes on the main screen only."""
    cfg = json.loads(strip_comments(text))
    if os.environ.get("HYPEFORGE_WAYBAR_TRAY") != "1":   # the way back to Waybar's own tray, if ours ever fails
        cfg = own_tray(cfg)
    out = []
    for bar in cfg if isinstance(cfg, list) else [cfg]:
        full = merged(bar)
        names = outputs
        if bar.get(ONLY) == "main" and outputs:
            names = [main if main in outputs else outputs[(len(outputs) - 1) // 2]]
        for name in names:
            mine = json.loads(json.dumps(bar))
            mine.pop(ONLY, None)
            mine["output"] = name
            places = popup_places(full)
            size = tray_size()
            for module in placed(full):
                if size and module.startswith("image#tray-") and isinstance(full.get(module), dict):
                    mine[module] = dict(full[module], size=size)
                for key in CLICKS:
                    cmd = full.get(module, {}).get(key) if isinstance(full.get(module), dict) else None
                    if isinstance(cmd, str) and cmd:
                        mine.setdefault(module, {})[key] = tagged(placed_command(cmd, places), name)
            out.append(mine)
    return out


def screens() -> list[dict]:
    return [o for o in Sway().ask(GET_OUTPUTS) if o.get("active")]


def saved() -> int | None:
    try:
        return int(json.loads(PIDS.read_text())["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def is_waybar(pid: int) -> bool:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[0].endswith(b"waybar")
    except OSError:
        return False


@contextmanager
def locked():
    RUN.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def stop():
    with locked():
        _stop()


def _stop():
    pid = saved()
    PIDS.unlink(missing_ok=True)       # first: from here on a missing bar is a stop, not a crash (the guard)
    if pid and is_waybar(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(40):
            if not is_waybar(pid):
                break
            time.sleep(0.05)


def start():
    with locked():
        return _start()


def _start():
    _stop()
    found = screens()
    outs = [o["name"] for o in found]
    path = RUN / "config.json"
    path.write_text(json.dumps(bars_for((CONF / "config.jsonc").read_text(), outs, main_screen(found)),
                               indent=2, ensure_ascii=False))
    if (RUN / "waybar.log").exists():     # the run before this one stays readable (10-22: a restart wiped the crash's)
        os.replace(RUN / "waybar.log", RUN / "waybar.log.prev")
    log = open(RUN / "waybar.log", "w")
    p = subprocess.Popen(["waybar", "-c", str(path), "-s", str(CONF / "style.css")],
                         stdout=log, stderr=log, start_new_session=True)
    log.close()                        # the bar holds its own copy
    PIDS.write_text(json.dumps({"pid": p.pid, "screens": outs}))
    # where the bar's pop-ups open, for the ones a key opens (Win + C: the clipboard, 2026-10-17)
    try:
        first = json.loads(strip_comments((CONF / "config.jsonc").read_text()))
        first = first[0] if isinstance(first, list) else first
        PLACES.write_text(json.dumps(popup_places(merged(first))))
    except (OSError, ValueError, IndexError):
        PLACES.unlink(missing_ok=True)
    print(f"hypeforge-bar: the bar on {len(outs)} screen(s): {', '.join(outs)}")
    return p


# ---- the bar guard (D-115) --------------------------------------------------------------------------

def sway_here() -> bool:
    """Sway still answers: the guard ends with the session, and never starts a bar into a closing one."""
    try:
        Sway().ask(GET_OUTPUTS)
        return True
    except Exception:
        return False


def notify(title: str, body: str, sticky: bool = False):
    tool = shutil.which("notify-send")
    if tool:
        try:
            subprocess.run([tool, "--app-name=hypeForge", "--icon=dialog-warning",
                            "--urgency=" + ("critical" if sticky else "normal"), title, body],
                           capture_output=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass


def how_it_ended(pid: int, status: int | None) -> str:
    """In plain words. The exit status is known only when the guard started that bar itself; otherwise the
    system's crash record (systemd-coredump) is asked, which takes a moment to be written."""
    if status is not None:
        if os.WIFSIGNALED(status):
            sig = os.WTERMSIG(status)
            return f"it was stopped by signal {sig} ({signal.Signals(sig).name})"
        return f"it quit by itself with code {os.WEXITSTATUS(status)}"
    if shutil.which("coredumpctl"):
        for _ in range(5):
            try:
                out = subprocess.run(["coredumpctl", "--no-pager", "info", str(pid)], capture_output=True,
                                     text=True, timeout=10).stdout
            except (OSError, subprocess.SubprocessError):
                break
            line = next((l.strip() for l in out.splitlines() if l.strip().startswith("Signal:")), "")
            if line:
                return f"it crashed ({line}; details: coredumpctl info {pid})"
            time.sleep(1)
    return "no crash record was found; it may have quit by itself"


def keep_last_words(pid: int, status: int | None) -> Path:
    """The dead bar's log, kept where a reboot can't wipe it, with when and how it ended on top."""
    CRASHES.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    path = CRASHES / f"{stamp}-waybar-{pid}.log"
    try:
        said = (RUN / "waybar.log").read_text(errors="replace")
    except OSError:
        said = "(the bar's log was missing)\n"
    path.write_text(f"hypeforge-bar guard · the bar (process {pid}) was found gone at "
                    f"{time.strftime('%Y-%m-%d %H:%M:%S')}\nHow: {how_it_ended(pid, status)}\n"
                    f"--- what it said (waybar.log) ---\n{said}")
    for old in sorted(CRASHES.glob("*-waybar-*.log"), reverse=True)[KEEP:]:
        old.unlink(missing_ok=True)
    return path


def reap() -> dict[int, int]:
    """Bars this guard started are its children: collect their exit status (and leave no zombies)."""
    ended = {}
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            break
        if pid == 0:
            break
        ended[pid] = status
    return ended


def guard():
    sys.stdout.reconfigure(line_buffering=True)    # its log (the watcher's file) shows each line as it happens
    RUN.mkdir(parents=True, exist_ok=True)
    me = open(RUN / "guard.lock", "w")
    try:
        fcntl.flock(me, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("hypeforge-bar guard: already guarding this session")
        return
    print(f"hypeforge-bar guard: watching the bar every {GUARD_EVERY:g} s "
          f"(gives up after {GUARD_MAX} restarts in {GUARD_WINDOW:g} s)")
    restarts: deque[float] = deque()
    ended: dict[int, int] = {}
    gave_up_on: int | None = None
    while True:
        time.sleep(GUARD_EVERY)
        ended.update(reap())
        if not sway_here():
            print("hypeforge-bar guard: Sway is gone; the guard ends with it")
            return
        with locked():
            pid = saved()
            if pid is None or is_waybar(pid) or pid == gave_up_on:
                continue
            if not sway_here():               # the session closing takes the bar first: not a crash
                continue
            kept = keep_last_words(pid, ended.pop(pid, None))
            now = time.monotonic()
            while restarts and now - restarts[0] > GUARD_WINDOW:
                restarts.popleft()
            when = time.strftime("%H:%M:%S")
            if len(restarts) >= GUARD_MAX:
                gave_up_on = pid
                print(f"hypeforge-bar guard: {when} the bar died again ({kept.name}); "
                      f"{GUARD_MAX} restarts in {GUARD_WINDOW:g} s, so it stays down")
                notify("The bar keeps stopping", f"It stopped {GUARD_MAX + 1} times in a few minutes, so hypeForge "
                       f"stopped bringing it back. What it said last: {kept}", sticky=True)
                continue
            restarts.append(now)
            try:
                _start()
            except Exception as e:            # Sway closing mid-start, or a broken config: say it, keep guarding
                print(f"hypeforge-bar guard: {when} could not start the bar again: {e}")
                continue
            gave_up_on = None
            print(f"hypeforge-bar guard: {when} the bar was gone; started again. Its last words: {kept}")
        notify("The bar came back", f"It stopped at {when} and was started again. What it said last: {kept}")


def main():
    args = sys.argv[1:]
    if args in (["start"], ["restart"]):
        start()
    elif args == ["stop"]:
        stop()
    elif args == ["guard"]:
        guard()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
