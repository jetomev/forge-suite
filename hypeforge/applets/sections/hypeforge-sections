#!/usr/bin/env python3
"""hypeForge applet 4 · App Sections (D-47, D-52).

The launcher with sections. Win + Space opens a first screen:

    Favorites · 1. Daily · 2. Work · … · All apps · Help & Keys  (power: the bar's ⏻ button)

and typing there searches every app (they sit below the fold, out of sight until you type).

Picking a section shows its apps. However an app is picked (a section, the first screen, All
apps, Favorites), it opens on its own workspace when one lists it (workspaces.toml, F-50): the
screens switch there first (applet 1), then the app opens, where applet 2 places it. An app on
no workspace's list opens on the workspace on screen.

    hypeforge-sections            open the launcher

Settings: ~/.config/hypeforge/applets/sections.toml (enabled, favourites, sections).
fuzzel draws the menus (its --dmenu mode); this file only decides what is in them.
"""

import os
import json
import shlex
import signal
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CONFIG = CONFIG_HOME / "hypeforge/applets/sections.toml"
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "common"))
import hfmenu  # noqa: E402
from hfbar import signal_bar  # noqa: E402

WORKSPACES = Path(__file__).resolve().parent.parent / "workspaces/hypeforge-workspaces"
HELP = Path(__file__).resolve().parent.parent / "help/hypeforge-help"
# The apps on this computer, how each is started, and which workspace lists it: common/hfapps.py,
# shared with the Workspaces applet and Window Placement (F-50, #55).
from hfapps import AppIndex, apps, command_for  # noqa: E402,F401  (apps: also used by tests)


# ---- Settings --------------------------------------------------------------------------------

def load():
    with open(CONFIG, "rb") as f:
        return tomllib.load(f)


def sort_into_sections(cfg, everything):
    """[(section, [app ids])] in the order shown, empty ones left out (Javier, 2026-10-08: the
    standard groups every desktop uses, so people know where an app is or belongs).

    An app goes to the section that lists it in `apps` (for apps that declare no category);
    otherwise to the first section in `claim_order` whose categories it declares (an app with
    Settings and System is a setting; one with Game and Network is a game); otherwise to the
    section marked `other = true`."""
    sections = cfg.get("section", [])
    by_name = {s["name"]: s for s in sections}
    order = [by_name[n] for n in cfg.get("claim_order", []) if n in by_name] or sections
    other = next((s for s in sections if s.get("other")), None)
    members = {s["name"]: [a for a in s.get("apps", []) if a in everything] for s in sections}
    claimed = {a for m in members.values() for a in m}
    for app_id in sorted(everything, key=lambda a: everything[a]["name"].lower()):
        if app_id in claimed:
            continue
        cats = everything[app_id]["categories"]
        home = next((s for s in order if cats & set(s.get("categories", []))), other)
        if home is not None:
            members[home["name"]].append(app_id)
    return [(s, members[s["name"]]) for s in sections if members[s["name"]]]


# ---- The menus -------------------------------------------------------------------------------

# Where the launcher opens: under the KognogOS emblem, at the bar's left end (Javier, 2026-10-05)
UNDER_EMBLEM = ("--anchor", "top-left", "--x-margin", "4", "--y-margin", "4")


def pick(cfg, lines, prompt, icons=True, lines_shown=None, menu="launcher", extra=UNDER_EMBLEM):
    """Show `lines` [(text, icon)] in fuzzel; the chosen index, or None (Esc)."""
    fuzzel = ["fuzzel", "--dmenu", "--index", "--no-sort", "--prompt", prompt, *extra]
    if lines_shown:
        fuzzel += ["--lines", str(lines_shown)]
    look = Path(os.path.expanduser(cfg.get("fuzzel_config", "")))
    if look.is_file():
        fuzzel += ["--config", str(look)]
    text = "\n".join(f"{t}\0icon\x1f{i}" if icons and i else t for t, i in lines) + "\n"
    out = hfmenu.run(menu, fuzzel, text)  # a second press closes it (main)
    return None if out is None else int(out.strip())


def launch(app_id, app):
    """Open the app on its own workspace if one lists it (the screens switch first, so it opens
    right there), otherwise on the workspace on screen."""
    workspace = AppIndex().of_app(app_id)
    if workspace and WORKSPACES.is_file():
        subprocess.run([str(WORKSPACES), "go", str(workspace)])
    subprocess.run(["swaymsg", "exec", command_for(app_id, app)], capture_output=True)


# ---- Favorites on the bar (Javier, 2026-10-05) ---------------------------------------------
# One dropdown button, "Favorites ▾"; its list shows each app with its icon (fuzzel finds the
# icons itself). `hypeforge-sections bar` writes the button for the bar.

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypeforge/applets"
BAR_FRAGMENT = CONFIG_DIR / "favourites.waybar.json"   # read by the bar (Waybar "include")
BAR_STYLE = CONFIG_DIR / "favourites.css"              # @import-ed by the bar's style.css (kept for
                                                       # later per-app styling; empty for now)


def write_bar():
    """The favourites group for the bar, and its icons' style. Redraws the bar if anything changed."""
    cfg = load()
    everything = apps()
    me = shlex.quote(os.path.abspath(sys.argv[0]))
    fragment = {"group/favourites": {"orientation": "inherit", "modules": []}}
    style = ["/* Written by hypeforge-sections bar. Do not edit by hand. */"]
    # One menu title, "Favorites", its key letter underlined (Win + F) — like a menu bar (Javier).
    # The list it opens shows each app with its icon (`favorites`, below).
    shown = [a for a in cfg.get("favourites", []) if a in everything]
    if shown:
        fragment["group/favourites"]["modules"].append("custom/favorites")
        fragment["custom/favorites"] = {"format": "<u>F</u>avorites", "tooltip": False,
                                        "on-click": f"{me} favorites"}
    text = json.dumps(fragment, indent=2) + "\n"
    css = "\n".join(style) + "\n"
    changed = not BAR_FRAGMENT.exists() or BAR_FRAGMENT.read_text() != text \
        or not BAR_STYLE.exists() or BAR_STYLE.read_text() != css
    if changed:
        BAR_FRAGMENT.write_text(text)
        BAR_STYLE.write_text(css)
        signal_bar(signal.SIGUSR2)  # Waybar reloads its settings and style on SIGUSR2
    return len(shown)


def favorites_menu():
    """The Favorites dropdown: your apps with their icons, under the bar button; pick one to open it."""
    if hfmenu.close_open("favorites"):  # a second click closes it
        return
    cfg = load()
    everything = apps()
    shown = [a for a in cfg.get("favourites", []) if a in everything]
    if not shown:
        return
    x = 44 + 24 + len("Workspaces") * 8 + 8  # under the button: the emblem + the Workspaces menu
    choice = pick(cfg, [(everything[a]["name"], everything[a]["icon"]) for a in shown], "Favorites  ",
                  lines_shown=len(shown), menu="favorites",
                  extra=("--anchor", "top-left", "--x-margin", str(x), "--y-margin", "4", "--width", "30"))
    if choice is not None:
        launch(shown[choice], everything[shown[choice]])


# ---- The power menu on the bar (Javier, 2026-10-05) -----------------------------------------
# The ⏻ button at the bar's right end: Lock · Log Out · Reboot · Shut Down, top to bottom.
# The last three ask first, with "No" selected, like the launcher's own power lines.

UNDER_RIGHT_END = ("--anchor", "top-right", "--x-margin", "4", "--y-margin", "4")


def power_menu():
    if hfmenu.close_open("power"):  # a second click closes it
        return
    power = load().get("power", {})
    items = [(key, label, icon, ask) for key, label, icon, ask in (
        ("lock", "Lock", "system-lock-screen", None),
        ("logout", "Log Out", "system-log-out", "Log out now?"),
        ("reboot", "Reboot", "system-reboot", "Reboot now?"),
        ("shutdown", "Shut Down", "system-shutdown", "Shut down now?")) if power.get(key)]
    cfg = load()
    choice = pick(cfg, [(label, icon) for _, label, icon, _ in items], "Power  ",
                  lines_shown=len(items), menu="power", extra=UNDER_RIGHT_END + ("--width", "22"))
    if choice is None:
        return
    key, label, icon, ask = items[choice]
    if ask and pick(cfg, [("No", "go-home"), (f"Yes, {label.lower()}", icon)], f"{ask}  ",
                    lines_shown=2, menu="power", extra=UNDER_RIGHT_END + ("--width", "22")) != 1:
        return
    subprocess.run(["swaymsg", "exec", power[key]], capture_output=True)


def main():
    if sys.argv[1:] == ["bar"]:
        print(f"hypeforge-sections: {write_bar()} favourites on the bar")
        return
    if sys.argv[1:] == ["power"]:
        power_menu()
        return
    if sys.argv[1:] == ["favorites"]:
        favorites_menu()
        return
    if len(sys.argv) == 3 and sys.argv[1] == "launch":
        app = apps().get(sys.argv[2])
        if app:
            launch(sys.argv[2], app)
        return
    if hfmenu.close_open("launcher"):
        return
    cfg = load()
    if not cfg.get("enabled", False):
        look = os.path.expanduser(cfg.get("fuzzel_config", ""))
        os.execvp("fuzzel", ["fuzzel"] + (["--config", look] if os.path.isfile(look) else []))

    everything = apps()
    by_name = sorted(everything, key=lambda a: everything[a]["name"].lower())
    favourites = [a for a in cfg.get("favourites", []) if a in everything]
    sections = sort_into_sections(cfg, everything)

    # First screen: the menus. Every line has an icon, so all line up.
    first = []  # (text, icon, action)
    if favourites:
        first.append(("Favorites", "favorites", ("menu", "Favorites", favourites)))
    for s, members in sections:
        # the group's name only: groups are kinds of app, not workspaces (Javier, 10-08); where an
        # app opens is its workspace's list (F-50)
        first.append((s["name"], s.get("icon", "applications-other"), ("menu", s["name"], members)))
    first.append(("All apps", "applications-all", ("menu", "All apps", by_name)))
    first.append(("Help & Keys", "help-browser", ("help",)))
    # Power lives on the bar's ⏻ button now; the launcher is for apps only (Javier, 2026-10-05)

    # Then every app, below the fold: the window is exactly as tall as the menus, so the apps
    # stay out of sight until you type — and typing always searches every app (Javier, 10-04).
    shown = len(first)
    for a in by_name:
        first.append((everything[a]["name"], everything[a]["icon"], ("app", a, None)))

    choice = pick(cfg, [(t, i) for t, i, _ in first], "❯  ", lines_shown=shown)
    while choice is not None:
        action = first[choice][2]
        if action[0] == "app":
            return launch(action[1], everything[action[1]])
        if action[0] == "help":
            subprocess.run(["swaymsg", "exec", str(HELP)], capture_output=True)
            return
        _, title, members = action
        lines = [("Back", "go-home")] + [(everything[a]["name"], everything[a]["icon"]) for a in members]
        sub = pick(cfg, lines, f"{title}  ❯  ")
        if sub is None:
            return
        if sub > 0:
            return launch(members[sub - 1], everything[members[sub - 1]])
        choice = pick(cfg, [(t, i) for t, i, _ in first], "❯  ", lines_shown=shown)  # Back


if __name__ == "__main__":
    main()
