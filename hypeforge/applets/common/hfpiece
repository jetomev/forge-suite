#!/bin/sh
# One answer for every screen's bar piece (2026-10-17, the bar's timing; Javier: "everything should render,
# recover, appear, fast!"). Each screen's bar runs its pieces' commands itself — three screens, three runs of
# the same Python program at once. The first run computes and keeps the answer; the others, within TTL
# seconds, read it (~3 ms). hfbar.signal_bar throws a piece's kept answer away before it signals the bar,
# so a change (a new copy, the moon switched) is never shown stale.
#
#     hfpiece NAME TTL COMMAND [ARGS…]       NAME "sig<N>-…" when the bar redraws the piece on SIGRTMIN+N
dir="${XDG_RUNTIME_DIR:-/tmp}/hypeforge-pieces"
f="$dir/$1"; ttl="$2"; shift 2
mkdir -p "$dir"
exec 9>"$f.lock"
flock 9
if [ -f "$f" ] && [ $(( $(date +%s) - $(stat -c %Y "$f") )) -lt "$ttl" ]; then
    cat "$f"
    exit 0
fi
"$@" > "$f.tmp" && mv -f "$f.tmp" "$f" && cat "$f"
