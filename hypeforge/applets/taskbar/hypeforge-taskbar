#!/usr/bin/env python3
"""hypeForge applet · the taskbar row: pinned + running apps in one (look program step 3).

The bar part the Windows 11 taskbar, the macOS Dock, KDE's panel and COSMIC's dock share: your
Favorites first (pinned, always there), then any other app that has a window open. Each icon
shows whether the app is running (a short line under it) and which one you are in (a long line).
A click on a pinned app that is not running opens it on its own workspace (the launcher's rule);
on a running app it goes to its window, and a second click goes to its next window.

    hypeforge-taskbar               keep the row current (started at login; one copy)
    hypeforge-taskbar click <slot>  what a click on an icon does (the bar calls it)
    hypeforge-taskbar new <slot>    a middle click: open another window of that app

How it reaches the bar: one small JSON per icon slot under $XDG_RUNTIME_DIR/hypeforge-taskbar/
(the bar reads each with `cat`, redrawn on SIGRTMIN+12), a bar fragment
(~/.config/hypeforge/applets/taskbar.waybar.json, Waybar "include") and the icons' stylesheet
(taskbar.css, @import-ed by a style's bar stylesheet). A style places "group/taskbar".
"""

from __future__ import annotations

import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "common"))
from hfsway import GET_TREE, SUBSCRIBE, EVENT_WINDOW, Sway  # noqa: E402
from hfapps import app_names, apps, window_names  # noqa: E402
from hficons import Icons  # noqa: E402
from hfbar import signal_bar  # noqa: E402

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypeforge/applets"
SECTIONS = CONFIG_DIR / "sections.toml"          # Favorites = the pinned apps
BAR_FRAGMENT = CONFIG_DIR / "taskbar.waybar.json"
BAR_STYLE = CONFIG_DIR / "taskbar.css"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE = RUNTIME / "hypeforge-taskbar"
PIDFILE = RUNTIME / "hypeforge-taskbar.pid"
SECTIONS_APPLET = Path(__file__).resolve().parent.parent / "sections/hypeforge-sections"
BAR_SIGNAL = 12           # Waybar redraws the taskbar on SIGRTMIN+12 (8-11 are taken)
EXTRA = 10                # room for this many running apps that are not pinned


def safe(app_id: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", app_id.lower()).strip("-") or "app"


def pinned() -> list[str]:
    try:
        with open(SECTIONS, "rb") as f:
            return [a for a in tomllib.load(f).get("favourites", []) if isinstance(a, str)]
    except (OSError, tomllib.TOMLDecodeError):
        return []


class Matcher:
    """Which installed app a window belongs to: strong names first (its id, StartupWMClass,
    a terminal's --class), then weak ones (its Name, the program it runs)."""

    def __init__(self, entries: dict):
        self.strong, self.weak = {}, {}
        for app_id, app in sorted(entries.items()):
            s, w = app_names(app_id, app)
            for n in s:
                self.strong.setdefault(n, app_id)
            for n in w:
                self.weak.setdefault(n, app_id)

    def of_window(self, node) -> str | None:
        names = window_names(node)
        for table in (self.strong, self.weak):
            for n in sorted(names):
                if n in table:
                    return table[n]
        return None


def windows(tree):
    """Every window in the tree, in the order Sway keeps them, with whether it has focus."""
    out = []

    def walk(node):
        if node.get("pid") and node.get("type") in ("con", "floating_con"):
            out.append(node)
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            walk(child)
    walk(tree)
    return out


def row(tree, entries: dict, matcher: Matcher, pins: list[str]):
    """The icons, left to right: [{"id", "name", "icon", "pinned", "windows": [con ids], "focused",
    "urgent"}]. Pinned ones first, in Favorites' order; then running ones, first opened first."""
    seen: dict[str, dict] = {}
    for p in pins:
        if p in entries:
            seen[p] = {"id": p, "name": entries[p]["name"], "icon": entries[p]["icon"], "pinned": True,
                       "windows": [], "focused": False, "urgent": False}
    extra = []
    for w in sorted(windows(tree), key=lambda n: n["id"]):
        app_id = matcher.of_window(w)
        if app_id is None:  # an app with no desktop entry: its own name and icon name
            app_id = next(iter(sorted(window_names(w))), f"window-{w['id']}")
            entry = {"name": w.get("name") or app_id, "icon": app_id, "noicon": True}
        else:
            entry = entries[app_id]
        item = seen.get(app_id)
        if item is None:
            item = seen[app_id] = {"id": app_id, "name": entry["name"], "icon": entry["icon"], "pinned": False,
                                   "windows": [], "focused": False, "urgent": False,
                                   "noicon": bool(entry.get("noicon"))}
            extra.append(app_id)
        item["windows"].append(w["id"])
        item["focused"] |= bool(w.get("focused"))
        item["urgent"] |= bool(w.get("urgent"))
    return [seen[p] for p in pins if p in seen] + [seen[a] for a in extra][:EXTRA]


def slots(pins: list[str]) -> list[str]:
    return [f"pin-{i}" for i in range(1, len(pins) + 1)] + [f"run-{i}" for i in range(1, EXTRA + 1)]


def write_state(items: list[dict], pins: list[str]) -> bool:
    """One JSON per slot: a pinned slot always shows its app; a running slot is empty (hidden by
    the bar) until an app needs it. Returns True when anything changed."""
    STATE.mkdir(exist_ok=True)
    by_slot = {}
    pinned_items = [i for i in items if i["pinned"]]
    for n, item in enumerate(pinned_items, 1):
        by_slot[f"pin-{n}"] = item
    for n, item in enumerate([i for i in items if not i["pinned"]], 1):
        by_slot[f"run-{n}"] = item
    changed = False
    for slot in slots(pins):
        item = by_slot.get(slot)
        if item is None:
            body = {"text": "", "class": "empty"}
        else:
            state = "focused" if item["focused"] else "running" if item["windows"] else "idle"
            classes = ["app", f"app-{safe(item['id'])}", state, "pinned" if item["pinned"] else "unpinned"]
            if item["urgent"]:
                classes.append("urgent")
            if item.get("noicon"):
                classes.append("noicon")
            count = len(item["windows"])
            body = {"text": " ", "class": classes,
                    "tooltip": item["name"] + (f"  ({count} windows)" if count > 1 else "")}
        text = json.dumps(body) + "\n"
        f = STATE / f"{slot}.json"
        if not f.exists() or f.read_text() != text:
            f.write_text(text)
            changed = True
    (STATE / "row.json").write_text(json.dumps({s: by_slot[s] for s in by_slot}))
    return changed


def write_bar(pins: list[str], entries: dict, icons: Icons):
    """The bar fragment (one module per slot) and the icons' stylesheet: a rule per installed app,
    so a running slot can show any app by its class without the bar reloading."""
    me = shlex.quote(os.path.abspath(sys.argv[0]))
    fragment = {"group/taskbar": {"orientation": "inherit", "modules": [f"custom/tb-{s}" for s in slots(pins)]}}
    for s in slots(pins):
        fragment[f"custom/tb-{s}"] = {
            "exec": f"cat {shlex.quote(str(STATE / f'{s}.json'))}",
            "return-type": "json", "interval": "once", "signal": BAR_SIGNAL,
            "on-click": f"{me} click {s}", "on-click-middle": f"{me} new {s}", "tooltip": True,
        }
    css = ["/* Written by hypeforge-taskbar. Do not edit by hand: the icons of the taskbar row. */",
           ".app { background-repeat: no-repeat; background-position: center; background-size: 24px 24px; }"]
    for app_id, app in sorted(entries.items()):
        path = icons.find(app["icon"])
        if path:
            css.append(f'.app-{safe(app_id)} {{ background-image: url("file://{path}"); }}')
    fallback = icons.find("application-x-executable")
    if fallback:  # a window of no installed app (GTK's CSS has no attribute selectors: a class)
        css.append(f'.app.noicon {{ background-image: url("file://{fallback}"); }}')
    changed = False
    for path, text in ((BAR_FRAGMENT, json.dumps(fragment, indent=2) + "\n"), (BAR_STYLE, "\n".join(css) + "\n")):
        if not path.exists() or path.read_text() != text:
            path.write_text(text)
            changed = True
    if changed:
        signal_bar(signal.SIGUSR2)  # Waybar reloads its settings and style


def click(slot: str, new: bool = False):
    try:
        item = json.loads((STATE / "row.json").read_text()).get(slot)
    except (OSError, ValueError):
        item = None
    if not item:
        return
    if new or not item["windows"]:
        if SECTIONS_APPLET.exists() and item["id"] in apps():
            subprocess.run([str(SECTIONS_APPLET), "launch", item["id"]])
        return
    sway = Sway()
    wins = item["windows"]
    focused = next((n["id"] for n in windows(sway.ask(GET_TREE)) if n.get("focused")), None)
    target = wins[(wins.index(focused) + 1) % len(wins)] if focused in wins else wins[0]
    sway.run(f"[con_id={target}] focus")


def keep_current():
    entries, icons = apps(), Icons()
    matcher, pins = Matcher(entries), pinned()
    stamp = SECTIONS.stat().st_mtime if SECTIONS.exists() else 0
    write_bar(pins, entries, icons)
    control, events = Sway(), Sway()
    if write_state(row(control.ask(GET_TREE), entries, matcher, pins), pins):
        signal_bar(signal.SIGRTMIN + BAR_SIGNAL)
    events.ask(SUBSCRIBE, json.dumps(["window"]))
    while True:
        kind, event = events.receive()
        if kind != EVENT_WINDOW or event.get("change") not in ("new", "close", "focus", "urgent", "move", "title"):
            continue
        now = SECTIONS.stat().st_mtime if SECTIONS.exists() else 0
        if now != stamp:  # Favorites changed: new pins, a new bar fragment
            stamp, pins, entries = now, pinned(), apps()
            matcher = Matcher(entries)
            write_bar(pins, entries, icons)
        if write_state(row(control.ask(GET_TREE), entries, matcher, pins), pins):
            signal_bar(signal.SIGRTMIN + BAR_SIGNAL)


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] in ("click", "new"):
        click(args[1], new=args[0] == "new")
        return
    if args:
        sys.exit(__doc__)
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        print("hypeforge-taskbar: already running")
        return
    except (OSError, ValueError):
        pass
    PIDFILE.write_text(str(os.getpid()))
    try:
        keep_current()
    finally:
        PIDFILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
