#!/usr/bin/env python3
"""hypeForge applet 2 · Window Placement (D-47, D-50).

Every new window goes to the next free spot of a fill order, in whatever workspace is on
screen: everything visible on every screen counts, a shared screen included. Once every spot
is taken, the next windows go round the same order again as tabs on those spots.

    hypeforge-placement            run: place each new window as it opens
    hypeforge-placement reload     re-read the settings file

Spots on one screen: "fill" (the whole screen), "right" (beside the first window), and
"under-right" (the bottom of the right half). Dialogs and floating windows are left alone.
A window the Workspaces applet takes to its own workspace (an app on that workspace's list,
F-50) is placed by that applet, through this same order (common/hfplace.py).

Settings: ~/.config/hypeforge/applets/placement.toml (enabled, screens, order).
"""

import json
import os
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "common"))
from hfsway import SUBSCRIBE, EVENT_WINDOW, Sway  # noqa: E402
from hfplace import CONFIG, load, place  # noqa: E402  (the fill order lives in common/hfplace.py)

PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypeforge-placement.pid"


def watch(screens, order):
    events = Sway()
    events.ask(SUBSCRIBE, json.dumps(["window"]))
    control = Sway()
    while True:
        kind, event = events.receive()
        if kind == EVENT_WINDOW and event.get("change") == "new":
            place(control, screens, order, event["container"]["id"])


# ---- One copy at a time ----------------------------------------------------------------------

def already_running():
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def main():
    args = sys.argv[1:]
    if args == ["reload"]:
        pid = already_running()
        if pid:
            os.kill(pid, signal.SIGHUP)
        return
    if args:
        sys.exit(__doc__)
    enabled, screens, order = load()
    if not enabled or not screens or not order:
        print("hypeforge-placement: switched off in", CONFIG)
        return
    if already_running():
        print("hypeforge-placement: already running")
        return
    PIDFILE.write_text(str(os.getpid()))
    # A reload request (SIGHUP) starts the whole program again, so it reads the file afresh.
    signal.signal(signal.SIGHUP, lambda *_: (PIDFILE.unlink(missing_ok=True),
                                             os.execv(sys.executable, [sys.executable] + sys.argv)))
    try:
        watch(screens, order)
    finally:
        PIDFILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
