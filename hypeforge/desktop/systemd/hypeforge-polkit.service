# hypeForge background helper (D-25: helpers run as user services under uwsm).
[Unit]
Description=hypeForge: password pop-up (hyprpolkitagent)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Only in the hypeForge session: Plasma can stay installed next to it (D-6).
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=/usr/lib/hyprpolkitagent/hyprpolkitagent
Restart=on-failure
RestartSec=2
Slice=background-graphical.slice

[Install]
WantedBy=graphical-session.target
