# hypeForge background helper (D-25: helpers run as user services under uwsm).
[Unit]
Description=hypeForge: USB drives (udiskie)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Only in the hypeForge session: Plasma can stay installed next to it (D-6).
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
# No tray icon (Javier, 2026-09-30): drives still mount by themselves and say so.
ExecStart=/usr/bin/udiskie --no-tray --notify
Restart=on-failure
RestartSec=2
Slice=background-graphical.slice

[Install]
WantedBy=graphical-session.target
