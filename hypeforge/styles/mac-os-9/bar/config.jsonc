// hypeForge style · Mac OS 9 (D-72) — the menu bar. Left: the emblem menu (the Apple menu's place:
// About, your groups as submenus, All Apps, Settings) · the app in use in bold · Workspaces ·
// Favorites · Window · Special (lock, log out, restart, shut down) · Help. Right: the tray (Mac OS 9
// had none; the apps that run in the background need a home), clipboard, USB drives, printers,
// the status pill and the date-and-bell piece every style shares (D-96; the night light is in the pill's Quick Settings since
// D-117, 2026-10-25), the Application menu (the
// app's icon; a click lists the open apps). No Control Strip (D-85): its buttons are on this bar.
// Pieces from modules.jsonc and the applets' fragments; colours from colors.css.
{
  "include": [
    "${XDG_CONFIG_HOME:-$HOME/.config}/sway/waybar/modules.jsonc",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/workspaces.waybar.json",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/favourites.waybar.json",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/menubar.waybar.json"
  ],
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,
  "modules-left": [
    "custom/menu-emblem",
    "custom/menu-app",
    "custom/ws",
    "custom/favorites",
    "custom/menu-window",
    "custom/menu-special",
    "custom/menu-help"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "custom/disk",
    "custom/memory",
    "custom/temperature",
    "custom/gpu",
    "custom/cpu",
    "custom/clipboard",
    "custom/printers",
    "group/quick",
    "group/datetime",
    "custom/menu-appicon"
  ],
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip": false
  }
}
