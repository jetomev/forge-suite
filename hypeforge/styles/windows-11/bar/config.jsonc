// hypeForge style · Windows 11, tiled (D-71) — the taskbar. At the bottom on every screen, the icons
// on the LEFT (Javier, W-1): Start (the KDE-style panel; its search is inside it — the bar's Search pill went: Javier, "if it is just a meme that opens
// the launcher, it is not worth it") · the workspace on screen (a click
// opens the workspaces strip) · the pinned + running apps (the Taskbar applet). Right: the hidden
// icons behind a chevron (tray, clipboard, USB, printers), the Quick Settings
// pill (volume · network · Bluetooth: a click opens the panel — now every style's, D-96), the clock on
// two lines with the bell (a click: the calendar with the alerts). Pieces from modules.jsonc; colours from colors.css.
{
  "include": [
    "${XDG_CONFIG_HOME:-$HOME/.config}/sway/waybar/modules.jsonc",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/workspaces.waybar.json",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/taskbar.waybar.json"
  ],
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "spacing": 0,
  "modules-left": [
    "custom/emblem",
    "custom/ws-title",
    "group/taskbar"
  ],
  "modules-center": [],
  "modules-right": [
    "group/hidden-icons",
    "custom/disk",
    "custom/memory",
    "custom/temperature",
    "custom/gpu",
    "custom/cpu",
    "group/quick",
    "group/datetime"
  ],
  "custom/emblem": {
    "format": " ",
    "tooltip-format": "Start (Win + Space)",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel start --edges bottom,left --margin bottom=56,left=8"
  },
  "custom/ws-title": {
    "exec": "~/Programs/forge-suite/hypeforge/applets/workspaces/hypeforge-workspaces title",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "󰕰  {}",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel workspaces --edges bottom,left --margin bottom=56,left=8"
  },
  "group/hidden-icons": {
    "orientation": "inherit",
    "modules": [
      "custom/chevron",
      "tray",
      "custom/clipboard",
      "custom/printers"
    ],
    "drawer": {
      "transition-duration": 250,
      "children-class": "hidden-icon",
      "click-to-reveal": true,
      "transition-left-to-right": false
    }
  },
  "custom/chevron": {
    "format": "󰅃",
    "tooltip-format": "Show hidden icons"
  },
  "clock": {
    "format": "{:%I:%M %p\n%m/%d/%Y}",
    "justify": "right",
    "tooltip": false
  }
}
