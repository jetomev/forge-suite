// hypeForge style · modern macOS, tiled (D-74) — two bars in the one Waybar (D-86):
//  1. the menu bar, 26 px, on every screen. Left: the emblem menu (MA-4: Mac OS 9's, with Special's
//     Lock · Log Out · Restart · Shut Down at its foot, like the Apple menu) · the app in use in bold ·
//     Workspaces · Favorites · Window · Help. Right: the tray, clipboard, USB drives, printers, the
//     status icons in one soft pill (Bluetooth · network · sound → Control Center, MA-3), the date and
//     time (→ the calendar with your notifications), the bell. No Spotlight button: Win + Space is
//     Spotlight (MA-2).
//  2. the Dock (MA-1), always there, on the main screen only (the middle of the row, D-87), floating
//     8 px above the bottom and centred at its contents' width: Launchpad, the favorites + running
//     apps (the Taskbar applet; a dot under the open ones), a divider, Downloads, Trash.
// Pieces from modules.jsonc and the applets' fragments; colours from colors.css.
[
  {
    "name": "menubar",
    "include": [
      "${XDG_CONFIG_HOME:-$HOME/.config}/sway/waybar/modules.jsonc",
      "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/workspaces.waybar.json",
      "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/favourites.waybar.json",
      "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/menubar.waybar.json"
    ],
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "modules-left": [
      "custom/menu-system",
      "custom/menu-app",
      "custom/ws",
      "custom/favorites",
      "custom/menu-window",
      "custom/menu-help"
    ],
    "modules-center": [],
    "modules-right": [
      "tray",
      "custom/nightlight",
      "custom/clipboard",
      "custom/drives",
      "custom/printers",
      "group/quick",
      "group/datetime"
    ],
    "clock": {
      "format": "{:%a %b %d   %I:%M %p}",
      "tooltip": false
    }
  },
  {
    "name": "dock",
    "hypeforge-screens": "main",
    "include": [
      "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/taskbar.waybar.json"
    ],
    "layer": "top",
    "position": "bottom",
    "height": 64,
    "width": 2,
    "margin-bottom": 8,
    "spacing": 0,
    "modules-center": [
      "custom/launchpad",
      "group/taskbar",
      "custom/dock-sep",
      "custom/downloads",
      "custom/trash"
    ],
    "custom/launchpad": {
      "format": "󰀻",
      "tooltip-format": "Launchpad",
      "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel library"
    },
    "custom/dock-sep": {
      "format": "│",
      "tooltip": false
    },
    "custom/downloads": {
      "format": "󰉍",
      "tooltip-format": "Downloads",
      "on-click": "thunar ~/Downloads"
    },
    "custom/trash": {
      "format": "󰩹",
      "tooltip-format": "Trash",
      "on-click": "thunar trash:///"
    }
  }
]
