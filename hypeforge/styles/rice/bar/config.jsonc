// hypeForge style · Linux rice (D-75) — the bar. One full-width bar, three solid areas, the
// wallpaper showing between them (Javier, 2026-10-10). Left: the emblem and the workspace pills;
// centre: the date, time and bell (what's playing comes back as our own piece: Waybar's mpris module
// crashed the bar on 2026-10-10 when a player started or stopped); right: the tray, the system, power.
// Bluetooth · network · sound: a click opens each one's own small pop-up under the bar, as on COSMIC
// (Javier, 2026-10-10: "I want them for the Rice theme too"); right-click keeps the full app.
// The date, time and bell are one piece in the centre: a click on any of them opens Windows 11's
// pop-up, your alerts as cards and the month (Javier, same evening: "also the date/time, plus
// alerts from windows to rice"; then: "Icon alert should go here, and the alert icon should not
// open the alert popup"). Right-click on the bell still switches Do Not Disturb.
// The right side, right to left (Javier): power, volume, network, Bluetooth, USB drives, printers,
// clipboard, processor, memory, the night light, then the programs' tray icons.
// The pieces are defined in modules.jsonc (shared by every style); colours come from colors.css.
{
  "include": [
    "${XDG_CONFIG_HOME:-$HOME/.config}/sway/waybar/modules.jsonc",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/workspaces.waybar.json"
  ],
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "custom/emblem",
    "group/workspace-pills"
  ],
  "modules-center": [
    "group/datetime"
  ],
  "modules-right": [
    "tray",
    "custom/nightlight",
    "memory",
    "cpu",
    "custom/clipboard",
    "custom/printers",
    "custom/drives",
    "bluetooth",
    "network",
    "wireplumber",
    "custom/power-panel"
  ],
  "group/datetime": {
    "orientation": "inherit",
    "modules": [
      "clock",
      "custom/notifications"
    ]
  },
  "custom/notifications": {
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel calendar --edges top --margin top=56"
  },
  "custom/nightlight": {
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick --only night --edges top,right --margin top=56,right=10"
  },
  "clock": {
    "format": "{:%a %d %b  %I:%M %p}",
    "tooltip": false,
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel calendar --edges top --margin top=56"
  },
  "bluetooth": {
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick --only bluetooth --edges top,right --margin top=56,right=10"
  },
  "network": {
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick --only network --edges top,right --margin top=56,right=10"
  },
  "wireplumber": {
    "tooltip-format": "{node_name}: {volume} %\nScroll: louder / quieter · click: sound · right click: the mixer",
    "on-click": "~/Programs/forge-suite/hypeforge/applets/panels/hypeforge-panel quick --only sound --edges top,right --margin top=56,right=10"
  }
}
