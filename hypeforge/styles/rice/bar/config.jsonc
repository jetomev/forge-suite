// hypeForge style · Linux rice (D-75) — the bar. One full-width bar, three solid areas, the
// wallpaper showing between them (Javier, 2026-10-10). Left: the emblem and the workspace pills;
// centre: the date, time and bell (what's playing comes back as our own piece: Waybar's mpris module
// crashed the bar on 2026-10-10 when a player started or stopped); right: the tray, the system, power.
// The date, time and bell are one piece in the centre; Bluetooth · network · sound one pill on the
// right (a click: Quick Settings); the night light's moon by the tray — the three pieces every style
// shares, defined once in modules.jsonc (D-96; they were born here and on Windows 11).
// The right side, right to left (Javier): power, the status pill, USB drives, printers,
// clipboard, processor, graphics card, temperature, memory, disk (2026-10-17), the night light, then
// the programs' tray icons.
// After the pills, the windows tucked away (D-82): an icon and how many, hidden when none; a click
// brings them back (Javier, 2026-10-11: on the Rice a tucked window had no way back you could see).
// The pieces are defined in modules.jsonc (shared by every style); colours come from colors.css.
{
  "include": [
    "${XDG_CONFIG_HOME:-$HOME/.config}/sway/waybar/modules.jsonc",
    "${XDG_CONFIG_HOME:-$HOME/.config}/hypeforge/applets/workspaces.waybar.json"
  ],
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "custom/emblem",
    "group/workspace-pills",
    "custom/tucked"
  ],
  "modules-center": [
    "group/datetime"
  ],
  "modules-right": [
    "tray",
    "custom/nightlight",
    "disk",
    "memory",
    "custom/temperature",
    "custom/gpu",
    "cpu",
    "custom/clipboard",
    "custom/printers",
    "custom/drives",
    "group/quick",
    "custom/power-panel"
  ]
}
