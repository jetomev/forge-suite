/* Written by hypeforge-theme — do not edit: pick another style or theme instead.
   Style: {{meta:style}} · theme: {{meta:theme}}. The bar (Waybar) and the lock screen
   (gtklock) @import this file; every colour they use is named here. */

/* the bar */
@define-color hf_bar      {{bar_bg}};
@define-color hf_shade    {{bar_shade}};
@define-color hf_text     {{bar_fg}};
@define-color hf_subtext  {{bar_fg_dim}};
@define-color hf_active   {{window_focused}};
@define-color hf_inactive {{bar_hover}};
@define-color hf_alert    {{bar_alert}};
@define-color hf_new      {{bar_new}};
@define-color hf_bell     {{bar_bell}};

/* the workspace pills (bar parts, look step 3): the active one, ones with windows, empty ones */
@define-color hf_pill_active      {{pill_active}};
@define-color hf_pill_active_text {{pill_active_text}};
@define-color hf_pill_busy        {{pill_busy}};
@define-color hf_pill_empty       {{pill_empty}};
@define-color hf_pill_hover       {{pill_hover}};

/* the taskbar row (bar parts): the line under a running app, a longer one under the app in use */
@define-color hf_task_running {{task_running}};
@define-color hf_task_focused {{task_focused}};

/* the pager (bar parts): a small box per workspace, its windows as dots */
@define-color hf_pager_active {{pager_active}};
@define-color hf_pager_window {{pager_window}};
@define-color hf_pager_border {{pager_border}};

/* the Mac menus (bar parts): the menu bar, its line, the drop-down menus, the item under the mouse */
@define-color hf_menubar_bg      {{menubar_background}};
@define-color hf_menubar_text    {{menubar_text}};
@define-color hf_menubar_line    {{menubar_line}};
@define-color hf_menu_bg         {{menu_background}};
@define-color hf_menu_hl         {{menu_highlight}};
@define-color hf_menu_hl_text    {{menu_highlight_text}};
@define-color hf_menu_disabled   {{menu_disabled}};

/* the lock screen */
@define-color hf_lock_bg     {{lock_bg}};
@define-color hf_lock_text   {{lock_text}};
@define-color hf_lock_field  {{lock_bg|alpha(0.85)}};
@define-color hf_lock_border {{lock_border}};
@define-color hf_lock_focus  {{lock_focus}};
@define-color hf_lock_error  {{lock_error}};
