# Written by hypeforge-theme from themes/templates/mako.conf.tmpl — edit the template, not this file.
# Style: {{meta:style}} · theme: {{meta:theme}}
# hypeForge — notifications in the Sway session: mako (D-57, Javier 2026-10-05).
# Copied to ~/.config/mako/config. Top right, under the bar, on the screen in use; 5 seconds;
# urgent ones stay until clicked. The pop-up standard (D-116). Click: close it. Win + N closes them all,
# Win + Shift + N brings back the last one closed (sway/config). A notifications Forge app
# will set this file later (D-59).

# where: top right of the screen in use (output empty = the focused screen), 8 px under the bar and
# 10 px from the screen's edge, as the pop-ups (D-116); mako puts `margin` (6 px, between two
# notifications) on the outside too, so the outer margin is the rest: 2 and 4 (measured)
anchor=top-right
output=
layer=top
outer-margin=2,4
margin=6
width={{popup:wide}}
height=200
max-visible=5
max-history=20
sort=-time

# how long
default-timeout=5000
ignore-timeout=0

# look — the pop-up standard (D-116, Javier, 2026-10-20): the pop-ups' card on every style — Noto Sans,
# a 1 px frame, corners 10 px (square when the corners switch says straight), the medium width (the
# calendar's card, where the same notifications are listed), the pop-ups' colours; the title in bold at
# 1.1 ×, as every pop-up's title row; the app's icon from the theme's icons
font={{popup:font}}
format=<b><span size="110%%">%s</span></b>\n%b
background-color={{panel_bg}}
text-color={{panel_text}}
border-color={{panel_border}}
border-size={{popup:border}}
border-radius={{popup:radius}}
padding=10,14
icons=1
max-icon-size={{popup:icon}}
icon-path={{popup:icon_path}}
progress-color=over {{panel_tile}}

# the bell on the bar redraws when a notification arrives (applet 7)
on-notify=exec ~/Programs/forge-suite/hypeforge/applets/notifications/hypeforge-notifications changed

# what a click does
on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=invoke-default-action

# a notification that offers something (a screenshot: "Draw on it"): a left click does it
[actionable]
on-button-left=invoke-default-action

[urgency=low]
border-color={{panel_tile}}
text-color={{panel_text_dim}}

[urgency=critical]
border-color={{panel_danger}}
default-timeout=0

# Do Not Disturb (right click on the bell): pop-ups hidden, still kept in the list
[mode=do-not-disturb]
invisible=1
